import AllThoseRamseyClasses.Lifts.GlobalMinimalForbiddenObstructionDichotomy
import AllThoseRamseyClasses.Lifts.EHNWeakImageCrossingSourceInputs

/-!
# Track D: actual separator-root crossing in the source of Section 3

The verified global minimal-obstruction theorem produces a positive-width
genuine geometric forbidden piece whose ordered root is in the common
full target seam, with a LEFT exclusive and a RIGHT exclusive source
vertex. Its remaining obstruction is either a COLLISION in the weak
image of that ordered root, or a genuinely MIXED private component.

This note replaces the abstract collision alternative by an ACTUAL
proper FULL native free decomposition of the function-closed hull
GENERATED BY THAT SAME ordered source root, with both proper sides
missing some root generator.

It is a source-geometric certificate only; it neither proves the
witness can be injectivized nor eliminates the collision. In
particular it does not assume that the root-generated hull itself
is a geometric separator piece with the same private component.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u
variable {L : Language.{u}}

/-- An actual weak EHN collapse between distinct coordinates of a
genuine ordered geometric separator root forces the WHOLE native
function-closed hull generated by those root vertices to have a
proper FULL free decomposition. In that decomposition neither
proper side contains all of the root generators.

No maximal lift, forbidden family, image-closure, rank or
root test-cover premise is needed for this local theorem. -/
theorem geometricCollidingRoot_exhibitsCrossingFullHull
    {V UT : Type}
    (A : Structure L V)
    {n : ℕ}
    (d : GeometricFunctionalPieceData A n)
    (Target : Structure L UT)
    (f : V → UT)
    (hf : A.IsEHNHomomorphismEmbedding Target f)
    (hCollision : ¬ Function.Injective (fun i : Fin n => f (d.roots i))) :
    ∃ dec : ProperFreeDecomposition
        (A.induce (A.functionClosure (Set.range d.roots))
          (A.functionClosure_isClosed (Set.range d.roots))),
      (¬ ∀ i : Fin n, ∃ a : dec.Left,
        Structure.closureLift A d.roots i = dec.leftIn a) ∧
      (¬ ∀ i : Fin n, ∃ b : dec.Right,
        Structure.closureLift A d.roots i = dec.rightIn b) := by
  classical
  have hPair :
      ∃ i j : Fin n,
        d.roots i ≠ d.roots j ∧
        f (d.roots i) = f (d.roots j) := by
    by_contra hNoPair
    apply hCollision
    intro i j hij
    by_contra hijNe
    have hSourceNe : d.roots i ≠ d.roots j := by
      intro hEq
      exact hijNe (d.roots_injective hEq)
    exact hNoPair ⟨i, j, hSourceNe, hij⟩
  obtain ⟨i, j, hDistinct, hSameImage⟩ := hPair
  exact ehn_generatorCollision_exhibitsCrossingSourceHull
    A Target f hf d.roots i j hDistinct hSameImage

/-- In the ACTUAL full native free amalgam of two forbidden-free
original global canonical lifts, any globally LEFT-source-support
minimal connected forbidden weak EHN witness admits a genuine
positive-width separator piece. Either

* its selected component is truly MIXED, meeting the right-exclusive
  region; or
* the SOURCE root-generated closed hull of this very piece has an
  ACTUAL proper full native free decomposition, with each side
  missing at least one root generator.

In particular the collision case is no longer just a negated
injectivity predicate. The decomposition is fully functional.

This is NOT a proof that the second case is incompatible with
maximal common lifts; that is the remaining Track D obstruction. -/
theorem minimalGlobalForbiddenWitness_rootCrossingHull_or_mixedPiece
    (F : ∀ {W : Type}, Structure L W → Prop)
    (hFiniteF : ∀ {W : Type} (A : Structure L W), F A → Finite W)
    (hConnected : GlobalForbiddenSourcesConnectedNonempty F)
    {UX UA UB UT : Type}
    (Target : Structure L UT)
    (Left : Structure L UA) (Right : Structure L UB)
    (jLeft : Structure.Embedding Left Target)
    (jRight : Structure.Embedding Right Target)
    (X : Structure L UX)
    (iLeft : Structure.Embedding X Left)
    (iRight : Structure.Embedding X Right)
    (hTargetFree : Structure.IsFreeAmalgam iLeft iRight jLeft jRight)
    (hCommon : CommonGlobalCanonicalLift F X Left Right iLeft iRight)
    (hAvoidLeft : AvoidsGlobalFunctionalEHN F Left)
    (hAvoidRight : AvoidsGlobalFunctionalEHN F Right)
    (w : ForbiddenEHNWitness F Target)
    (hMin : ∀ v : ForbiddenEHNWitness F Target,
      w.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft) ≤
        v.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft)) :
    ∃ (n : ℕ) (d : GeometricFunctionalPieceData w.source n),
      0 < n ∧
      Set.range d.roots ⊆
        weakFreeRootPart (sL := iLeft) (iL := jLeft) w.toTarget ∧
      d.left.1 ∈
        weakFreeLeftPart (sL := iLeft) (iL := jLeft) w.toTarget ∧
      d.right.1 ∈
        weakFreeRightPart
          (sL := iLeft) (iL := jLeft) (iR := jRight) w.toTarget ∧
      geometricFunctionalRootedPattern w.source d ∈
        forbiddenGeometricFunctionalPieces F n ∧
      ((∃ dec : ProperFreeDecomposition
          (w.source.induce
            (w.source.functionClosure (Set.range d.roots))
            (w.source.functionClosure_isClosed (Set.range d.roots))),
          (¬ ∀ i : Fin n, ∃ a : dec.Left,
            Structure.closureLift w.source d.roots i = dec.leftIn a) ∧
          (¬ ∀ i : Fin n, ∃ b : dec.Right,
            Structure.closureLift w.source d.roots i = dec.rightIn b)) ∨
        ∃ z : w.Carrier,
          z ∈ functionalComponentFrom w.source
            (Set.range d.roots) d.left ∧
          z ∈ weakFreeRightPart
            (sL := iLeft) (iL := jLeft) (iR := jRight) w.toTarget) := by
  obtain ⟨n, d, hn, hRoots, hLeft, hRight, hPiece, hCases⟩ :=
    minimalGlobalForbiddenWitness_collidingRoot_or_mixedPiece
      F hFiniteF hConnected
      Target Left Right jLeft jRight X iLeft iRight
      hTargetFree hCommon hAvoidLeft hAvoidRight w hMin
  refine ⟨n, d, hn, hRoots, hLeft, hRight, hPiece, ?_⟩
  rcases hCases with hCollision | hMixed
  · exact Or.inl
      (geometricCollidingRoot_exhibitsCrossingFullHull
        w.source d Target w.toTarget w.homEmbedding hCollision)
  · exact Or.inr hMixed

end AllThoseRamseyClasses.Lifts
