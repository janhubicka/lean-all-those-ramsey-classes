import AllThoseRamseyClasses.Lifts.EHNFullSideMinimalObstruction

/-!
# Track D: exact equivalence between side-local obstructions and image-incidence coverage

Let f : Source → Target be an original native EHN map, where Target is
a GENUINE full native free amalgam of Left and Right. Then:

* the existence of an ACTUAL positive target function value on
  source-image arguments with NO positive original source lift at
  ANY matching input and output coordinates, supported in a full
  target side with a crossed original source generated hull,
  is EQUIVALENT to failure of original positive source-function
  incidence coverage on the actual target image;
* the analogous globally unliftable positive target relation
  incidence, supported in one full target side with a crossed
  original source hull, is EQUIVALENT to failure of positive
  relation incidence coverage on the actual target image.

Thus absence of BOTH precisely characterized side defects is
EQUIVALENT to both true source-image coverage predicates. The
side predicates include genuine native function-closed source
crossing geometry and exact FULL target-side coordinates; neither
a quotient target nor source-root injectivity is substituted.

No forbidden family, printed image-closure, maximal lift, source
minimality, regularity or Ramsey conclusion is involved. This
identifies the local reflection gate, not a proof that maximal
canonical lifts imply the gate.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u
variable {L : Language.{u}}

/-- A globally unliftable, genuine FULL side-positive native function
incidence with crossed source input hull exists EXACTLY when the
actual target image has a positive native function incidence
not generated by any positive original source incidence.

The nontrivial direction chooses ORIGINAL source representatives
of the function-input target coordinates, then applies the full
native free-amalgam law and the EHN irreducible-test condition.
All matching source input tuples have empty function fibres. -/
theorem hasFullSideUnliftableFunctionIncident_iff_not_rangeFunctionCover
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f) :
    HasFullSideUnliftableFunctionIncident
        Source Left Right Target jL jR f ↔
      ¬ SourceFunctionValueTuplesCoveredOnRange Source Target f := by
  classical
  constructor
  · rintro ⟨G, xs, z, hTarget, hNoLift, _hUndefined, _hCross, _hSide⟩
      hCoverage
    have hRange : ∀ i, (f ∘ xs) i ∈ Set.range f :=
      fun i => ⟨xs i, rfl⟩
    obtain ⟨ys, out, hPositive, hArgs, hValue⟩ :=
      hCoverage G (f ∘ xs) z hRange hTarget
    exact hNoLift ⟨ys, out, hPositive, hArgs.symm, hValue.symm⟩
  · intro hNotCovered
    have hBad :
        ∃ (G : L.FuncSymbol)
            (zs : Fin (L.funcArity G) → UT) (z : UT),
          (∀ i, zs i ∈ Set.range f) ∧
          z ∈ Target.func G zs ∧
          ¬ ∃ (ys : Fin (L.funcArity G) → V) (out : V),
            out ∈ Source.func G ys ∧
            zs = f ∘ ys ∧ z = f out := by
      by_contra hNoBad
      apply hNotCovered
      intro G zs z hRange hPositive
      by_contra hMissing
      exact hNoBad ⟨G, zs, z, hRange, hPositive, hMissing⟩
    obtain ⟨G, zs, z, hRange, hPositive, hMissing⟩ := hBad
    let xs : Fin (L.funcArity G) → V :=
      fun i => Classical.choose (hRange i)
    have hArgs : f ∘ xs = zs := by
      funext i
      exact Classical.choose_spec (hRange i)
    have hTargetXs : z ∈ Target.func G (f ∘ xs) := by
      rw [hArgs]
      exact hPositive
    have hNoLift :
        ¬ ∃ (ys : Fin (L.funcArity G) → V) (out : V),
          out ∈ Source.func G ys ∧
          f ∘ ys = f ∘ xs ∧ f out = z := by
      rintro ⟨ys, out, hSource, hCoords, hOutput⟩
      exact hMissing
        ⟨ys, out, hSource,
          hArgs.symm.trans hCoords.symm, hOutput.symm⟩
    have hUndefined :=
      ehn_unliftableFunction_allSourcePreimageFibresEmpty
        Source Target f hf G xs z hTargetXs hNoLift
    obtain ⟨hCross, hSide⟩ :=
      ehn_unliftableFunction_liesInFullSide_withSourceCrossingHull
        Source Root Left Right Target
        sL sR jL jR hFree f hf G xs z hTargetXs hNoLift
    exact ⟨G, xs, z, hTargetXs, hNoLift,
      hUndefined, hCross, hSide⟩

/-- Globally unliftable positive target OLD relations in actual
full sides with crossed native source hulls exist EXACTLY when
the target range has a positive OLD relation tuple missing from
the original source incidence-generated weak image.

The source relation obstruction is on ALL possible input
preimages, not only on one arbitrarily chosen source tuple. -/
theorem hasFullSideUnliftableRelationIncident_iff_not_rangeRelationCover
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f) :
    HasFullSideUnliftableRelationIncident
        Source Left Right Target jL jR f ↔
      ¬ SourceRelationTuplesCoveredOnRange Source Target f := by
  classical
  constructor
  · rintro ⟨R, xs, hTarget, hNoLift, _hCross, _hSide⟩ hCoverage
    have hRange : ∀ i, (f ∘ xs) i ∈ Set.range f :=
      fun i => ⟨xs i, rfl⟩
    obtain ⟨ys, hPositive, hArgs⟩ :=
      hCoverage R (f ∘ xs) hRange hTarget
    exact hNoLift ⟨ys, hPositive, hArgs.symm⟩
  · intro hNotCovered
    have hBad :
        ∃ (R : L.RelSymbol)
            (zs : Fin (L.relArity R) → UT),
          (∀ i, zs i ∈ Set.range f) ∧
          Target.rel R zs ∧
          ¬ ∃ ys : Fin (L.relArity R) → V,
            Source.rel R ys ∧ zs = f ∘ ys := by
      by_contra hNoBad
      apply hNotCovered
      intro R zs hRange hPositive
      by_contra hMissing
      exact hNoBad ⟨R, zs, hRange, hPositive, hMissing⟩
    obtain ⟨R, zs, hRange, hPositive, hMissing⟩ := hBad
    let xs : Fin (L.relArity R) → V :=
      fun i => Classical.choose (hRange i)
    have hArgs : f ∘ xs = zs := by
      funext i
      exact Classical.choose_spec (hRange i)
    have hTargetXs : Target.rel R (f ∘ xs) := by
      rw [hArgs]
      exact hPositive
    have hNoLift :
        ¬ ∃ ys : Fin (L.relArity R) → V,
          Source.rel R ys ∧ f ∘ ys = f ∘ xs := by
      rintro ⟨ys, hSource, hCoords⟩
      exact hMissing
        ⟨ys, hSource, hArgs.symm.trans hCoords.symm⟩
    obtain ⟨hCross, hSide⟩ :=
      ehn_unliftableRelation_liesInFullSide_withSourceCrossingHull
        Source Root Left Right Target
        sL sR jL jR hFree f hf R xs hTargetXs hNoLift
    exact ⟨R, xs, hTargetXs, hNoLift, hCross, hSide⟩

/-- The actual source-image full-incidence coverage criterion is
EQUIVALENT to the absence of BOTH genuine FULL-side unliftable
positive target incidence defects.

This interface isolates exactly what must be proved from common
original maximal-lift compatibility (or bypassed by a distinct
source replacement), without accidentally introducing a global
forbidden-source irreducible test cover or root-image injectivity. -/
theorem noFullSideUnliftableIncidences_iff_rangeIncidenceCoverage
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f) :
    (¬ HasFullSideUnliftableFunctionIncident
        Source Left Right Target jL jR f ∧
     ¬ HasFullSideUnliftableRelationIncident
        Source Left Right Target jL jR f) ↔
    (SourceFunctionValueTuplesCoveredOnRange Source Target f ∧
     SourceRelationTuplesCoveredOnRange Source Target f) := by
  have hFunction :=
    hasFullSideUnliftableFunctionIncident_iff_not_rangeFunctionCover
      Source Root Left Right Target sL sR jL jR hFree f hf
  have hRelation :=
    hasFullSideUnliftableRelationIncident_iff_not_rangeRelationCover
      Source Root Left Right Target sL sR jL jR hFree f hf
  constructor
  · rintro ⟨hNoFunction, hNoRelation⟩
    constructor
    · by_contra hMissing
      exact hNoFunction (hFunction.mpr hMissing)
    · by_contra hMissing
      exact hNoRelation (hRelation.mpr hMissing)
  · rintro ⟨hFunctionCovered, hRelationCovered⟩
    constructor
    · intro hBad
      exact (hFunction.mp hBad) hFunctionCovered
    · intro hBad
      exact (hRelation.mp hBad) hRelationCovered

end AllThoseRamseyClasses.Lifts
