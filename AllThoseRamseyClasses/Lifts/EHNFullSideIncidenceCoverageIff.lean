import AllThoseRamseyClasses.Lifts.EHNFullSideMinimalObstruction

/-!
# Track D: exact equivalence between side-local obstructions and image-incidence coverage

Let f : Source → Target be an original native EHN map, where Target is
a GENUINE full native free amalgam of Left and Right. Then:

* the existence of an ACTUAL positive target function value on
  source-image arguments with NO positive original source lift at
  ANY matching input and output coordinates, supported in a full
  target side with a crossed original source generated hull,
  is EQUIVALENT to failure of original positive source-function
  incidence coverage on the actual target image;
* the analogous globally unliftable positive target relation
  incidence, supported in one full target side with a crossed
  original source hull, is EQUIVALENT to failure of positive
  relation incidence coverage on the actual target image.

Thus absence of BOTH precisely characterized side defects is
EQUIVALENT to both true source-image coverage predicates. The
side predicates include genuine native function-closed source
crossing geometry and exact FULL target-side coordinates; neither
a quotient target nor source-root injectivity is substituted.

No forbidden family, printed image-closure, maximal lift, source
minimality, regularity or Ramsey conclusion is involved. This
identifies the local reflection gate, not a proof that maximal
canonical lifts imply the gate.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u
variable {L : Language.{u}}

/-- A globally unliftable, genuine FULL side-positive native function
incidence with crossed source input hull exists EXACTLY when the
actual target image has a positive native function incidence
not generated by any positive original source incidence.

The nontrivial direction chooses ORIGINAL source representatives
of the function-input target coordinates, then applies the full
native free-amalgam law and the EHN irreducible-test condition.
All matching source input tuples have empty function fibres. -/
theorem hasFullSideUnliftableFunctionIncident_iff_not_rangeFunctionCover
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f) :
    HasFullSideUnliftableFunctionIncident
        Source Left Right Target jL jR f ↔
      ¬ SourceFunctionValueTuplesCoveredOnRange Source Target f := by
  classical
  constructor
  · rintro ⟨G, xs, z, hTarget, hNoLift, _hUndefined, _hCross, _hSide⟩
      hCoverage
    have hRange : ∀ i, (f ∘ xs) i ∈ Set.range f :=
      fun i => ⟨xs i, rfl⟩
    obtain ⟨ys, out, hPositive, hArgs, hValue⟩ :=
      hCoverage G (f ∘ xs) z hRange hTarget
    exact hNoLift ⟨ys, out, hPositive, hArgs.symm, hValue.symm⟩
  · intro hNotCovered
    have hBad :
        ∃ (G : L.FuncSymbol)
            (zs : Fin (L.funcArity G) → UT) (z : UT),
          (∀ i, zs i ∈ Set.range f) ∧
          z ∈ Target.func G zs ∧
          ¬ ∃ (ys : Fin (L.funcArity G) → V) (out : V),
            out ∈ Source.func G ys ∧
            zs = f ∘ ys ∧ z = f out := by
      by_contra hNoBad
      apply hNotCovered
      intro G zs z hRange hPositive
      by_contra hMissing
      exact hNoBad ⟨G, zs, z, hRange, hPositive, hMissing⟩
    obtain ⟨G, zs, z, hRange, hPositive, hMissing⟩ := hBad
    let xs : Fin (L.funcArity G) → V :=
      fun i => Classical.choose (hRange i)
    have hArgs : f ∘ xs = zs := by
      funext i
      exact Classical.choose_spec (hRange i)
    have hTargetXs : z ∈ Target.func G (f ∘ xs) := by
      rw [hArgs]
      exact hPositive
    have hNoLift :
        ¬ ∃ (ys : Fin (L.funcArity G) → V) (out : V),
          out ∈ Source.func G ys ∧
          f ∘ ys = f ∘ xs ∧ f out = z := by
      rintro ⟨ys, out, hSource, hCoords, hOutput⟩
      exact hMissing
        ⟨ys, out, hSource,
          hArgs.symm.trans hCoords.symm, hOutput.symm⟩
    have hUndefined :=
      ehn_unliftableFunction_allSourcePreimageFibresEmpty
        Source Target f hf G xs z hTargetXs hNoLift
    obtain ⟨hCross, hSide⟩ :=
      ehn_unliftableFunction_liesInFullSide_withSourceCrossingHull
        Source Root Left Right Target
        sL sR jL jR hFree f hf G xs z hTargetXs hNoLift
    exact ⟨G, xs, z, hTargetXs, hNoLift,
      hUndefined, hCross, hSide⟩

/-- Globally unliftable positive target OLD relations in actual
full sides with crossed native source hulls exist EXACTLY when
the target range has a positive OLD relation tuple missing from
the original source incidence-generated weak image.

The source relation obstruction is on ALL possible input
preimages, not only on one arbitrarily chosen source tuple. -/
theorem hasFullSideUnliftableRelationIncident_iff_not_rangeRelationCover
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f) :
    HasFullSideUnliftableRelationIncident
        Source Left Right Target jL jR f ↔
      ¬ SourceRelationTuplesCoveredOnRange Source Target f := by
  classical
  constructor
  · rintro ⟨R, xs, hTarget, hNoLift, _hCross, _hSide⟩ hCoverage
    have hRange : ∀ i, (f ∘ xs) i ∈ Set.range f :=
      fun i => ⟨xs i, rfl⟩
    obtain ⟨ys, hPositive, hArgs⟩ :=
      hCoverage R (f ∘ xs) hRange hTarget
    exact hNoLift ⟨ys, hPositive, hArgs.symm⟩
  · intro hNotCovered
    have hBad :
        ∃ (R : L.RelSymbol)
            (zs : Fin (L.relArity R) → UT),
          (∀ i, zs i ∈ Set.range f) ∧
          Target.rel R zs ∧
          ¬ ∃ ys : Fin (L.relArity R) → V,
            Source.rel R ys ∧ zs = f ∘ ys := by
      by_contra hNoBad
      apply hNotCovered
      intro R zs hRange hPositive
      by_contra hMissing
      exact hNoBad ⟨R, zs, hRange, hPositive, hMissing⟩
    obtain ⟨R, zs, hRange, hPositive, hMissing⟩ := hBad
    let xs : Fin (L.relArity R) → V :=
      fun i => Classical.choose (hRange i)
    have hArgs : f ∘ xs = zs := by
      funext i
      exact Classical.choose_spec (hRange i)
    have hTargetXs : Target.rel R (f ∘ xs) := by
      rw [hArgs]
      exact hPositive
    have hNoLift :
        ¬ ∃ ys : Fin (L.relArity R) → V,
          Source.rel R ys ∧ f ∘ ys = f ∘ xs := by
      rintro ⟨ys, hSource, hCoords⟩
      exact hMissing
        ⟨ys, hSource, hArgs.symm.trans hCoords.symm⟩
    obtain ⟨hCross, hSide⟩ :=
      ehn_unliftableRelation_liesInFullSide_withSourceCrossingHull
        Source Root Left Right Target
        sL sR jL jR hFree f hf R xs hTargetXs hNoLift
    exact ⟨R, xs, hTargetXs, hNoLift, hCross, hSide⟩

/-- The actual source-image full-incidence coverage criterion is
EQUIVALENT to the absence of BOTH genuine FULL-side unliftable
positive target incidence defects.

This interface isolates exactly what must be proved from common
original maximal-lift compatibility (or bypassed by a distinct
source replacement), without accidentally introducing a global
forbidden-source irreducible test cover or root-image injectivity. -/
theorem noFullSideUnliftableIncidences_iff_rangeIncidenceCoverage
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f) :
    (¬ HasFullSideUnliftableFunctionIncident
        Source Left Right Target jL jR f ∧
     ¬ HasFullSideUnliftableRelationIncident
        Source Left Right Target jL jR f) ↔
    (SourceFunctionValueTuplesCoveredOnRange Source Target f ∧
     SourceRelationTuplesCoveredOnRange Source Target f) := by
  have hFunction :=
    hasFullSideUnliftableFunctionIncident_iff_not_rangeFunctionCover
      Source Root Left Right Target sL sR jL jR hFree f hf
  have hRelation :=
    hasFullSideUnliftableRelationIncident_iff_not_rangeRelationCover
      Source Root Left Right Target sL sR jL jR hFree f hf
  constructor
  · rintro ⟨hNoFunction, hNoRelation⟩
    constructor
    · by_contra hMissing
      exact hNoFunction (hFunction.mpr hMissing)
    · by_contra hMissing
      exact hNoRelation (hRelation.mpr hMissing)
  · rintro ⟨hFunctionCovered, hRelationCovered⟩
    constructor
    · intro hBad
      exact (hFunction.mp hBad) hFunctionCovered
    · intro hBad
      exact (hRelation.mp hBad) hRelationCovered

/-- Exact original-partial FUNCTION-DOMAIN tuple coverage on
the ACTUAL target image: whenever the target native function
is DEFINED on a tuple of image vertices, some original source
function input tuple at those SAME target coordinates is also
defined (has a nonempty native source output fibre).

This is weaker in appearance than demanding a positive source
lift for every individual target function output. The two are
equivalent under the original native EHN test clause. -/
def SourceFunctionDomainsCoveredOnRange
    {V W : Type} (A : Structure L V) (B : Structure L W)
    (f : V → W) : Prop :=
  ∀ (G : L.FuncSymbol) (zs : Fin (L.funcArity G) → W),
    (∀ i, zs i ∈ Set.range f) →
    (B.func G zs).Nonempty →
    ∃ ys : Fin (L.funcArity G) → V,
      (A.func G ys).Nonempty ∧ zs = f ∘ ys

/-- For a native EHN map, the OLD ORIGINAL-PARTIAL
function-domain component of tuple-surjectivity on the actual
image is EQUIVALENT to exact positive-value incidence coverage
for ALL values of ALL native functions on image arguments.

The nontrivial direction uses ANY ONE original positive source
function output to see that the entire original input-generated
closed hull is irreducible. The native EHN map is FULL on that
test, so every target function value at the chosen coordinates
lifts, not just some value.

No family-level image closure, root injection, maximal lift or
bound on function arity is assumed. -/
theorem ehn_functionDomainCover_iff_fullValueCover
    {V W : Type} (A : Structure L V) (B : Structure L W)
    (f : V → W)
    (hf : A.IsEHNHomomorphismEmbedding B f) :
    SourceFunctionDomainsCoveredOnRange A B f ↔
      SourceFunctionValueTuplesCoveredOnRange A B f := by
  constructor
  · intro hDomains G zs z hRange hTarget
    obtain ⟨ys, ⟨out, hDefined⟩, hArgs⟩ :=
      hDomains G zs hRange ⟨z, hTarget⟩
    have hCovered :
        FunctionInputCoveredByFullIrreducibleTest A G ys :=
      functionInputCovered_of_positiveSourceFunctionValue
        A G ys ⟨out, hDefined⟩
    have hTargetYs : z ∈ B.func G (f ∘ ys) := by
      rw [← hArgs]
      exact hTarget
    obtain ⟨v, hv, hvTarget⟩ :=
      ehn_localFunctionInputCover_liftsTargetOutput
        A B f hf G ys hCovered z hTargetYs
    exact ⟨ys, v, hv, hArgs, hvTarget.symm⟩
  · intro hValues G zs hRange hDefined
    obtain ⟨z, hz⟩ := hDefined
    obtain ⟨ys, out, hSource, hArgs, _⟩ :=
      hValues G zs z hRange hz
    exact ⟨ys, ⟨out, hSource⟩, hArgs⟩

/-- A precise 2019-style form of the side-local obstruction
equivalence: there are NO globally unliftable positive native
function or old relation incidences in either genuine target
free-amalgam side iff the actual target range is covered by
ORIGINAL-PARTIAL function DOMAIN tuples and positive old relation
tuples from the original source.

The domain-only function premise is sufficient because EHN
upgrades it automatically to COMPLETE target function-fibre
coverage. This avoids imposing a fictitiously stronger
function-value version of the printed tuple-surjectivity axiom. -/
theorem noFullSideUnliftableIncidences_iff_originalPartialDomainAndRelationCoverage
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f) :
    (¬ HasFullSideUnliftableFunctionIncident
        Source Left Right Target jL jR f ∧
     ¬ HasFullSideUnliftableRelationIncident
        Source Left Right Target jL jR f) ↔
    (SourceFunctionDomainsCoveredOnRange Source Target f ∧
     SourceRelationTuplesCoveredOnRange Source Target f) := by
  have hFull :=
    noFullSideUnliftableIncidences_iff_rangeIncidenceCoverage
      Source Root Left Right Target sL sR jL jR hFree f hf
  have hDomains :=
    ehn_functionDomainCover_iff_fullValueCover
      Source Target f hf
  constructor
  · intro hNoSide
    obtain ⟨hValueCoverage, hRelationCoverage⟩ :=
      hFull.mp hNoSide
    exact ⟨hDomains.mpr hValueCoverage, hRelationCoverage⟩
  · rintro ⟨hDomainCoverage, hRelationCoverage⟩
    exact hFull.mpr
      ⟨hDomains.mp hDomainCoverage, hRelationCoverage⟩

/-- Exact conditional Track D → Track C handoff for ONE actual
globally left-SOURCE-support-minimal forbidden EHN witness in a
genuine FULL native free amalgam of F-free sides with the
common original global canonical lift.

If that specific minimizer has NO globally unliftable positive
relation or function incidence inside either FULL side (including
the genuinely crossed source input hull certificates), then
original-partial function-domain and positive relation coverage
hold on its ACTUAL target image. EHN upgrades domain coverage to
full native function-value coverage; the actual induced range
becomes function-closed and ORIGINAL-PARTIAL tuple-surjective.
The paper-shaped family image closure then selects an INJECTIVE
forbidden EHN replacement with no greater ORIGINAL source support,
hence still minimal, and the verified source geometry provides a
genuine smallest MIXED geometric forbidden piece.

This theorem does NOT derive the no-side-defect premise from
maximal common lifts. Doing so (or bypassing the defects by a
collision-tolerant source flip) is the remaining Track D obstacle.
Track C's arbitrary positive-rank proper-piece descent is separate.
-/
theorem minimalForbiddenWitness_noSideDefects_yields_injectiveMinimalMixedPiece
    (F : ∀ {W : Type}, Structure L W → Prop)
    (hFiniteF : ∀ {W : Type} (A : Structure L W), F A → Finite W)
    (hConnected : GlobalForbiddenSourcesConnectedNonempty F)
    (hImage : HasTupleSurjectiveForbiddenImageClosure F)
    {UX UA UB UT : Type}
    (Target : Structure L UT)
    (Left : Structure L UA) (Right : Structure L UB)
    (jLeft : Structure.Embedding Left Target)
    (jRight : Structure.Embedding Right Target)
    (X : Structure L UX)
    (iLeft : Structure.Embedding X Left)
    (iRight : Structure.Embedding X Right)
    (hTargetFree : Structure.IsFreeAmalgam iLeft iRight jLeft jRight)
    (hCommon : CommonGlobalCanonicalLift F X Left Right iLeft iRight)
    (hAvoidLeft : AvoidsGlobalFunctionalEHN F Left)
    (hAvoidRight : AvoidsGlobalFunctionalEHN F Right)
    (w : ForbiddenEHNWitness F Target)
    (hMinimal : ∀ t : ForbiddenEHNWitness F Target,
      w.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft) ≤
        t.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft))
    (hNoSide :
      ¬ HasFullSideUnliftableFunctionIncident
          w.source Left Right Target jLeft jRight w.toTarget ∧
      ¬ HasFullSideUnliftableRelationIncident
          w.source Left Right Target jLeft jRight w.toTarget) :
    ∃ (v : ForbiddenEHNWitness F Target),
      Function.Injective v.toTarget ∧
      (∀ t : ForbiddenEHNWitness F Target,
        v.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft) ≤
          t.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft)) ∧
      ∃ P : MixedGeometricPiece v.source
          (weakFreeRootPart (sL := iLeft) (iL := jLeft) v.toTarget)
          (weakFreeLeftPart (sL := iLeft) (iL := jLeft) v.toTarget)
          (weakFreeRightPart
            (sL := iLeft) (iL := jLeft) (iR := jRight) v.toTarget),
        ∀ Q : MixedGeometricPiece v.source
          (weakFreeRootPart (sL := iLeft) (iL := jLeft) v.toTarget)
          (weakFreeLeftPart (sL := iLeft) (iL := jLeft) v.toTarget)
          (weakFreeRightPart
            (sL := iLeft) (iL := jLeft) (iR := jRight) v.toTarget),
          P.nonrootCount ≤ Q.nonrootCount := by
  obtain ⟨hDomainCoverage, hRelationCoverage⟩ :=
    (noFullSideUnliftableIncidences_iff_originalPartialDomainAndRelationCoverage
      w.source X Left Right Target
      iLeft iRight jLeft jRight hTargetFree
      w.toTarget w.homEmbedding).mp hNoSide
  have hValueCoverage : SourceFunctionValueTuplesCoveredOnRange
      w.source Target w.toTarget :=
    (ehn_functionDomainCover_iff_fullValueCover
      w.source Target w.toTarget w.homEmbedding).mp hDomainCoverage
  let hClosed : Target.IsClosed (Set.range w.toTarget) :=
    sourceFunctionValueTuplesCovered_rangeClosed
      w.source Target w.toTarget hValueCoverage
  have hTuple : OriginalPartialTupleSurjective
      w.source (Target.induce (Set.range w.toTarget) hClosed)
      (fun x => (⟨w.toTarget x, ⟨x, rfl⟩⟩ :
        Set.range w.toTarget)) :=
    sourceFullIncidenceReflection_inducedRangeTupleSurjective
      w.source Target w.toTarget hValueCoverage hRelationCoverage
  obtain ⟨v, hInjective, hBound⟩ :=
    forbiddenEHNWitness_injectiveReplacement_of_printedTupleRange
      F hFiniteF hImage Target
      (fullFreeLeftExclusiveTarget iLeft jLeft)
      w hClosed hTuple
  have hMinV : ∀ t : ForbiddenEHNWitness F Target,
      v.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft) ≤
        t.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft) := by
    intro t
    exact hBound.trans (hMinimal t)
  have hRootInjective : Set.InjOn v.toTarget
      (weakFreeRootPart (sL := iLeft) (iL := jLeft) v.toTarget) := by
    intro x _ y _ hxy
    exact hInjective hxy
  obtain ⟨P, hSmallest⟩ :=
    minimalGlobalForbiddenWitness_exists_minimalMixedPiece_of_rootInjOn
      F hFiniteF hConnected
      Target Left Right jLeft jRight X iLeft iRight
      hTargetFree hCommon hAvoidLeft hAvoidRight
      v hMinV hRootInjective
  exact ⟨v, hInjective, hMinV, P, hSmallest⟩

end AllThoseRamseyClasses.Lifts
