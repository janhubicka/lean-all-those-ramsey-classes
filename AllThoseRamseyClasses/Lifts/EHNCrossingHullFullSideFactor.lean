import AllThoseRamseyClasses.Lifts.EHNUnliftableIncidenceFreeSide
import AllThoseRamseyClasses.Lifts.EHNFullSideFactor
import AllThoseRamseyClasses.Lifts.GlobalForbiddenEHNAvoidance

/-!
# Track D: a crossed native source input hull factors as a genuine EHN map to the full target side

The merged side-local incidence results show that a globally unliftable
positive relation or function incidence in the full free amalgam belongs
to ONE FULL target side, while its input-generated original source hull
has a proper FULL native free decomposition crossed by the generators.

There is a stronger exact source-side consequence: because the side's
FULL embedding has a function-closed target range, the preimage of that
range under the actual original weak EHN source map is closed. The
ENTIRE original function-closed hull generated by the input tuple
therefore lies in that preimage, not only the original generators.

The original EHN map restricted to the full induced hull then factors
as a genuine EHN homomorphism-embedding into the one target side.
The hull remains reducible, so the target side being F-free does NOT
imply the hull is forbidden or give a contradiction. The proof does not
claim that the hull is a genuine selected geometric forbidden subpiece.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u
variable {L : Language.{u}}

/-- If all generators of a source tuple map to one FULL embedded target
side under an actual EHN map, then the whole function-closed source
hull generated by those vertices maps into the same side, and the
FULL induced native hull has a genuine EHN factorization into Side.

No finite carrier, source irreducibility, forbidden family, target
free-amalgam geometry, or root-image injectivity is required. -/
theorem ehn_generatedClosedHull_factors_fullSide
    {V U W X : Type}
    (Source : Structure L V) (Side : Structure L U)
    (Target : Structure L W)
    (f : V → W)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (j : Structure.Embedding Side Target)
    (xs : X → V)
    (hInputs : ∀ i, f (xs i) ∈ Set.range j) :
    ∃ q : Source.functionClosure (Set.range xs) → U,
      (Source.induce (Source.functionClosure (Set.range xs))
        (Source.functionClosure_isClosed (Set.range xs))).IsEHNHomomorphismEmbedding Side q ∧
      ∀ z : Source.functionClosure (Set.range xs),
        j (q z) = f z.1 := by
  let S : Set V := Source.functionClosure (Set.range xs)
  have hS : Source.IsClosed S :=
    Source.functionClosure_isClosed (Set.range xs)
  have hPreimage : Source.IsClosed {v : V | f v ∈ Set.range j} :=
    hf.1.preimage_isClosed (Set.range j) j.range_isClosed
  have hSeeds : Set.range xs ⊆ {v : V | f v ∈ Set.range j} := by
    rintro v ⟨i, rfl⟩
    exact hInputs i
  have hHullInSide : ∀ z : S, ∃ y : U, f z.1 = j y := by
    intro z
    obtain ⟨y, hy⟩ :
        f z.1 ∈ Set.range j :=
      z.2 {v : V | f v ∈ Set.range j} hPreimage hSeeds
    exact ⟨y, hy.symm⟩
  have hHullEHN :
      (Source.induce S hS).IsEHNHomomorphismEmbedding
        Target (fun z : S => f z.1) :=
    hf.comp (Source.inclusion S hS).isEHNHomomorphismEmbedding
  exact ehnHomomorphismEmbedding_factor_full_side
    hHullEHN j hHullInSide

/-- The genuine FULL target-side native relation witness has, in
addition to its crossed source input hull, an actual EHN weak map
from the FULL induced source hull into the SAME target side.

In particular the source crossing decomposition is internal to
a reducible original source hull; the original EHN map on this
whole hull need not be injective. -/
theorem ehn_unliftableRelation_crossingHull_EHN_factorsFullSide
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (R : L.RelSymbol)
    (xs : Fin (L.relArity R) → V)
    (hTarget : Target.rel R (f ∘ xs))
    (hNoLift : ¬ ∃ ys : Fin (L.relArity R) → V,
      Source.rel R ys ∧ f ∘ ys = f ∘ xs) :
    SourceInputHasCrossingNativeHull Source xs ∧
    ((∃ (args : Fin (L.relArity R) → UA),
       Left.rel R args ∧ f ∘ xs = jL ∘ args ∧
       ∃ q : Source.functionClosure (Set.range xs) → UA,
         (Source.induce (Source.functionClosure (Set.range xs))
           (Source.functionClosure_isClosed (Set.range xs))).IsEHNHomomorphismEmbedding Left q ∧
         ∀ z : Source.functionClosure (Set.range xs),
           jL (q z) = f z.1) ∨
     (∃ (args : Fin (L.relArity R) → UB),
       Right.rel R args ∧ f ∘ xs = jR ∘ args ∧
       ∃ q : Source.functionClosure (Set.range xs) → UB,
         (Source.induce (Source.functionClosure (Set.range xs))
           (Source.functionClosure_isClosed (Set.range xs))).IsEHNHomomorphismEmbedding Right q ∧
         ∀ z : Source.functionClosure (Set.range xs),
           jR (q z) = f z.1)) := by
  obtain ⟨hCross, hSide⟩ :=
    ehn_unliftableRelation_liesInFullSide_withSourceCrossingHull
      Source Root Left Right Target sL sR jL jR hFree
      f hf R xs hTarget hNoLift
  refine ⟨hCross, ?_⟩
  rcases hSide with ⟨args, hRel, hArgs⟩ | ⟨args, hRel, hArgs⟩
  · have hInputSide : ∀ i, f (xs i) ∈ Set.range jL := by
      intro i
      exact ⟨args i, (congrFun hArgs i).symm⟩
    obtain ⟨q, hq, hFactor⟩ :=
      ehn_generatedClosedHull_factors_fullSide
        Source Left Target f hf jL xs hInputSide
    exact Or.inl ⟨args, hRel, hArgs, q, hq, hFactor⟩
  · have hInputSide : ∀ i, f (xs i) ∈ Set.range jR := by
      intro i
      exact ⟨args i, (congrFun hArgs i).symm⟩
    obtain ⟨q, hq, hFactor⟩ :=
      ehn_generatedClosedHull_factors_fullSide
        Source Right Target f hf jR xs hInputSide
    exact Or.inr ⟨args, hRel, hArgs, q, hq, hFactor⟩

/-- The target function's positive input+output incidence is
entirely in one genuine FULL target side. The ENTIRE original
source function-closed hull generated by those source input
vertices factors into that same side as a genuine EHN map,
despite admitting an internal proper FULL crossing decomposition.

No source function output at ANY matching input coordinates can
lift the target output. The target function value need not belong
to the image of the original source itself. -/
theorem ehn_unliftableFunction_crossingHull_EHN_factorsFullSide
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (G : L.FuncSymbol)
    (xs : Fin (L.funcArity G) → V)
    (z : UT)
    (hTarget : z ∈ Target.func G (f ∘ xs))
    (hNoLift : ¬ ∃ (ys : Fin (L.funcArity G) → V) (out : V),
      out ∈ Source.func G ys ∧ f ∘ ys = f ∘ xs ∧ f out = z) :
    SourceInputHasCrossingNativeHull Source xs ∧
    ((∃ (args : Fin (L.funcArity G) → UA) (out : UA),
       out ∈ Left.func G args ∧ f ∘ xs = jL ∘ args ∧
       z = jL out ∧
       ∃ q : Source.functionClosure (Set.range xs) → UA,
         (Source.induce (Source.functionClosure (Set.range xs))
           (Source.functionClosure_isClosed (Set.range xs))).IsEHNHomomorphismEmbedding Left q ∧
         ∀ v : Source.functionClosure (Set.range xs),
           jL (q v) = f v.1) ∨
     (∃ (args : Fin (L.funcArity G) → UB) (out : UB),
       out ∈ Right.func G args ∧ f ∘ xs = jR ∘ args ∧
       z = jR out ∧
       ∃ q : Source.functionClosure (Set.range xs) → UB,
         (Source.induce (Source.functionClosure (Set.range xs))
           (Source.functionClosure_isClosed (Set.range xs))).IsEHNHomomorphismEmbedding Right q ∧
         ∀ v : Source.functionClosure (Set.range xs),
           jR (q v) = f v.1)) := by
  obtain ⟨hCross, hSide⟩ :=
    ehn_unliftableFunction_liesInFullSide_withSourceCrossingHull
      Source Root Left Right Target sL sR jL jR hFree
      f hf G xs z hTarget hNoLift
  refine ⟨hCross, ?_⟩
  rcases hSide with
    ⟨args, out, hVal, hArgs, hz⟩ | ⟨args, out, hVal, hArgs, hz⟩
  · have hInputSide : ∀ i, f (xs i) ∈ Set.range jL := by
      intro i
      exact ⟨args i, (congrFun hArgs i).symm⟩
    obtain ⟨q, hq, hFactor⟩ :=
      ehn_generatedClosedHull_factors_fullSide
        Source Left Target f hf jL xs hInputSide
    exact Or.inl ⟨args, out, hVal, hArgs, hz, q, hq, hFactor⟩
  · have hInputSide : ∀ i, f (xs i) ∈ Set.range jR := by
      intro i
      exact ⟨args i, (congrFun hArgs i).symm⟩
    obtain ⟨q, hq, hFactor⟩ :=
      ehn_generatedClosedHull_factors_fullSide
        Source Right Target f hf jR xs hInputSide
    exact Or.inr ⟨args, out, hVal, hArgs, hz, q, hq, hFactor⟩


/-- The original 2019 Forb_EHN(F) class pulls back through a genuine
EHN homomorphism-embedding, not merely through a FULL embedding.

If a forbidden source P admitted an EHN weak realization in A, its
composition with the EHN map A → B would be an EHN realization in B.
This is separate from the false assertion that a weak quotient
inclusion is full. -/
theorem avoidsGlobalFunctionalEHN_of_EHN_source
    (F : ∀ {W : Type}, Structure L W → Prop)
    {VA VB : Type}
    (A : Structure L VA) (B : Structure L VB)
    (q : VA → VB)
    (hq : A.IsEHNHomomorphismEmbedding B q)
    (hB : AvoidsGlobalFunctionalEHN F B) :
    AvoidsGlobalFunctionalEHN F A := by
  intro W P hFinite hForbidden p hp
  have hComp : P.IsEHNHomomorphismEmbedding B (q ∘ p) :=
    hq.comp hp
  exact (hB P hFinite hForbidden (q ∘ p)) hComp

/-- If a source generating tuple maps into a full embedded target
side which is genuinely Forb_EHN(F), its ENTIRE FULL induced
function-generated original source hull is also Forb_EHN(F).

The hull is allowed to be reducible. No inference that its
original input-generated vertex set is a selected forbidden
geometric subpiece is made. -/
theorem ehn_generatedClosedHull_avoidsForbidden_of_fullSide
    (F : ∀ {W : Type}, Structure L W → Prop)
    {V U W X : Type}
    (Source : Structure L V) (Side : Structure L U)
    (Target : Structure L W)
    (f : V → W)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (j : Structure.Embedding Side Target)
    (xs : X → V)
    (hInputs : ∀ i, f (xs i) ∈ Set.range j)
    (hSideFree : AvoidsGlobalFunctionalEHN F Side) :
    AvoidsGlobalFunctionalEHN F
      (Source.induce (Source.functionClosure (Set.range xs))
        (Source.functionClosure_isClosed (Set.range xs))) := by
  obtain ⟨q, hEHN, _⟩ :=
    ehn_generatedClosedHull_factors_fullSide
      Source Side Target f hf j xs hInputs
  exact avoidsGlobalFunctionalEHN_of_EHN_source F
    (Source.induce (Source.functionClosure (Set.range xs))
      (Source.functionClosure_isClosed (Set.range xs)))
    Side q hEHN hSideFree

/-- Under genuine F-freeness of BOTH target sides, any globally
unliftable positive OLD relation in the full amalgam has a
genuinely crossed original source input-generated hull that
ITSELF avoids every finite forbidden EHN source.

This is a sharp necessary structural condition, not a
contradiction: the full hull may be reducible and F-free even
though the ambient original source is forbidden. -/
theorem ehn_unliftableRelation_crossedHull_isForbiddenFree
    (F : ∀ {W : Type}, Structure L W → Prop)
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (hAvoidLeft : AvoidsGlobalFunctionalEHN F Left)
    (hAvoidRight : AvoidsGlobalFunctionalEHN F Right)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (R : L.RelSymbol)
    (xs : Fin (L.relArity R) → V)
    (hTarget : Target.rel R (f ∘ xs))
    (hNoLift : ¬ ∃ ys : Fin (L.relArity R) → V,
      Source.rel R ys ∧ f ∘ ys = f ∘ xs) :
    SourceInputHasCrossingNativeHull Source xs ∧
    AvoidsGlobalFunctionalEHN F
      (Source.induce (Source.functionClosure (Set.range xs))
        (Source.functionClosure_isClosed (Set.range xs))) := by
  obtain ⟨hCross, hSide⟩ :=
    ehn_unliftableRelation_crossingHull_EHN_factorsFullSide
      Source Root Left Right Target sL sR jL jR hFree
      f hf R xs hTarget hNoLift
  refine ⟨hCross, ?_⟩
  rcases hSide with
    ⟨_args, _hRel, _hArgs, q, hq, _⟩ |
    ⟨_args, _hRel, _hArgs, q, hq, _⟩
  · exact avoidsGlobalFunctionalEHN_of_EHN_source F
      (Source.induce (Source.functionClosure (Set.range xs))
        (Source.functionClosure_isClosed (Set.range xs)))
      Left q hq hAvoidLeft
  · exact avoidsGlobalFunctionalEHN_of_EHN_source F
      (Source.induce (Source.functionClosure (Set.range xs))
        (Source.functionClosure_isClosed (Set.range xs)))
      Right q hq hAvoidRight

/-- Under actual F-freeness of both target sides, the original
closed hull generated by a globally unliftable native function
input remains F-free under EHN maps, despite admitting a
proper FULL free decomposition crossed by its generators.

This holds at EVERY function arity and permits noninjective
original weak source maps. -/
theorem ehn_unliftableFunction_crossedHull_isForbiddenFree
    (F : ∀ {W : Type}, Structure L W → Prop)
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (hAvoidLeft : AvoidsGlobalFunctionalEHN F Left)
    (hAvoidRight : AvoidsGlobalFunctionalEHN F Right)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (G : L.FuncSymbol)
    (xs : Fin (L.funcArity G) → V)
    (z : UT)
    (hTarget : z ∈ Target.func G (f ∘ xs))
    (hNoLift : ¬ ∃ (ys : Fin (L.funcArity G) → V) (out : V),
      out ∈ Source.func G ys ∧ f ∘ ys = f ∘ xs ∧ f out = z) :
    SourceInputHasCrossingNativeHull Source xs ∧
    AvoidsGlobalFunctionalEHN F
      (Source.induce (Source.functionClosure (Set.range xs))
        (Source.functionClosure_isClosed (Set.range xs))) := by
  obtain ⟨hCross, hSide⟩ :=
    ehn_unliftableFunction_crossingHull_EHN_factorsFullSide
      Source Root Left Right Target sL sR jL jR hFree
      f hf G xs z hTarget hNoLift
  refine ⟨hCross, ?_⟩
  rcases hSide with
    ⟨_args, _out, _hVal, _hArgs, _hz, q, hq, _⟩ |
    ⟨_args, _out, _hVal, _hArgs, _hz, q, hq, _⟩
  · exact avoidsGlobalFunctionalEHN_of_EHN_source F
      (Source.induce (Source.functionClosure (Set.range xs))
        (Source.functionClosure_isClosed (Set.range xs)))
      Left q hq hAvoidLeft
  · exact avoidsGlobalFunctionalEHN_of_EHN_source F
      (Source.induce (Source.functionClosure (Set.range xs))
        (Source.functionClosure_isClosed (Set.range xs)))
      Right q hq hAvoidRight

end AllThoseRamseyClasses.Lifts
