import AllThoseRamseyClasses.Lifts.OneGeneratedEHNImageClosure
import AllThoseRamseyClasses.Lifts.EHNInputTestCoverageClosedRange

/-!
# Unary native functions automatically have irreducible input tests

The general arbitrary-arity criterion for safe EHN image closure
asks that EVERY original native function-input tuple of a
forbidden source be covered by a genuine FULL irreducible
source substructure. It is not automatic in binary/higher arity.

For a NONEMPTY source and functions of arity at most one, each
input tuple contains either zero or one source vertex. The full
native closed hull generated by that one vertex is irreducible
by the kernel-checked one-generator theorem. This covers the
entire input tuple even when its closed hull contains infinitely
many function outputs, nullary outputs or additional vertices.

Thus the general irreducible-input-tuple test-cover condition is
automatic in the unary-function setting, with no restriction
on the arities of relation symbols. This links the verified
one-generated theorem with the general safe image-minimizer
mechanism; it is a genuine special case, not a derivation of
the arbitrary-arity 2019 claim.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}

/-- Every native function-input tuple of a NONEMPTY source
with only nullary/unary function symbols is contained in
a full embedded irreducible closed one-generator source test.

The test is the entire function-closed hull of one vertex.
The source language may have relations of arbitrary arity. -/
theorem functionInputTuplesCoveredByIrreducibleTests_of_unary
    {V : Type v} [Nonempty V]
    (A : Structure L V)
    (hUnary : ∀ F : L.FuncSymbol, L.funcArity F ≤ 1) :
    FunctionInputTuplesCoveredByIrreducibleTests A := by
  classical
  intro F xs
  have hSingle : ∃ x : V,
      ∀ i : Fin (L.funcArity F), xs i = x := by
    by_cases hZero : L.funcArity F = 0
    · refine ⟨Classical.choice (inferInstance : Nonempty V), ?_⟩
      intro i
      have hi : i.val < 0 := by simpa [hZero] using i.isLt
      exact False.elim (Nat.not_lt_zero _ hi)
    · have hOne : L.funcArity F = 1 := by
        have hLe := hUnary F
        omega
      let i0 : Fin (L.funcArity F) := ⟨0, by omega⟩
      refine ⟨xs i0, ?_⟩
      intro i
      have hi : i = i0 := Fin.ext (by omega)
      exact congrArg xs hi
  obtain ⟨x, hAll⟩ := hSingle
  let G : Finset V := {x}
  let H : Set V := A.functionClosure (↑G : Set V)
  have hH : A.IsClosed H :=
    A.functionClosure_isClosed (↑G : Set V)
  let E : Structure L H := A.induce H hH
  let e : Structure.Embedding E A := A.inclusion H hH
  have hIrr : E.Irreducible := by
    change
      (A.induce
        (A.functionClosure (↑({x} : Finset V) : Set V))
        (A.functionClosure_isClosed
          (↑({x} : Finset V) : Set V))).Irreducible
    exact sourceOnePointClosedHull_irreducible A x
  have hxH : x ∈ H := by
    apply A.subset_functionClosure (↑G : Set V)
    simp [G]
  let ys : Fin (L.funcArity F) → H := fun i =>
    ⟨xs i, by
      rw [hAll i]
      exact hxH⟩
  refine ⟨H, E, hIrr, e, ys, ?_⟩
  intro i
  rfl

end AllThoseRamseyClasses.Lifts
