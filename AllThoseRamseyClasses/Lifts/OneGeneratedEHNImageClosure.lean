import PartiteConstruction.Functional.ClosedGeneratorRank
import PartiteConstruction.Functional.WeakInvariant
import AllThoseRamseyClasses.Lifts.FullEmbeddingGeneratedClosure

/-!
# Full EHN irreducible tests generated by one source vertex

The 2019 printed lift proof invokes homomorphism-embedding image
closure to replace a forbidden weak source map by an injective one.
This is NOT valid for arbitrary functional languages: the image of
a weak EHN map need not be closed under values of functions with
two or more independent arguments.

For any native full functional language, however, a full substructure
generated by at most ONE source vertex IS irreducible in the genuine
universal free-amalgamation sense. In an actual free amalgam the image
of that generator lies on one closed side (or the shared root);
function closure keeps ALL generated source vertices on that side.

Therefore the FULL function-closed hull of each individual source
vertex is a genuine irreducible EHN test. Its image is FULLY
embedded in the target of a weak EHN map. Every function value of
the target generated from ONE image point therefore lies in the
range of the weak source map. In a language of functions of arity
AT MOST ONE, the entire source image is consequently function-closed.

This is a genuine special-case repair of the printed image-closure
argument. It does NOT assert the same fact for binary functions:
the image may fail to be closed on two unrelated source points,
because no irreducible source test is required to contain both.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}

/-- Any full native functional structure generated by at most ONE
vertex is irreducible in the universal free-amalgam sense,
even with arbitrary function arities and nullary symbols. -/
theorem oneGeneratedFullStructure_irreducible
    {V : Type v} (A : Structure L V)
    (hGenerated : A.GeneratedByAtMost 1) :
    A.Irreducible := by
  classical
  intro H E F C Root Left Right Whole sL sR iL iR hFree e
  obtain ⟨G, hCard, hGen⟩ := hGenerated
  have localize
      {Side : Type v}
      {Sstr : Structure L Side}
      (iSide : Structure.Embedding Sstr Whole)
      (hSeeds : ∀ x : V, x ∈ G → ∃ y : Side, e x = iSide y) :
      ∀ x : V, ∃ y : Side, e x = iSide y := by
    have hClosed : A.IsClosed (e ⁻¹' Set.range iSide) :=
      e.preimage_isClosed (Set.range iSide) iSide.range_isClosed
    have hSeed : (↑G : Set V) ⊆ e ⁻¹' Set.range iSide := by
      intro x hx
      exact hSeeds x hx
    intro x
    have hxClosure : x ∈ A.functionClosure (↑G : Set V) := by
      rw [hGen]
      exact Set.mem_univ x
    exact hxClosure (e ⁻¹' Set.range iSide) hClosed hSeed
  by_cases hEmpty : G = ∅
  · left
    apply localize iL
    intro x hx
    exact False.elim (by simpa [hEmpty] using hx)
  · have hPositive : 0 < G.card :=
      Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hEmpty)
    have hOne : G.card = 1 := by omega
    obtain ⟨g, hg⟩ := Finset.card_eq_one.mp hOne
    rcases hFree.covers (e g) with ⟨a, ha⟩ | ⟨b, hb⟩
    · left
      apply localize iL
      intro x hx
      have hxg : x = g := by simpa only [hg, Finset.mem_singleton] using hx
      exact ⟨a, hxg ▸ ha⟩
    · right
      apply localize iR
      intro x hx
      have hxg : x = g := by simpa only [hg, Finset.mem_singleton] using hx
      exact ⟨b, hxg ▸ hb⟩

/-- The FULL induced hull generated by any single source point is
a genuine irreducible EHN test (not just connected in the graph).
No local finiteness is required for this irreducibility claim. -/
theorem sourceOnePointClosedHull_irreducible
    {V : Type v} (A : Structure L V) (x : V) :
    (A.induce (A.functionClosure (↑({x} : Finset V) : Set V))
      (A.functionClosure_isClosed (↑({x} : Finset V) : Set V))).Irreducible := by
  have hGen :
      (A.induce (A.functionClosure (↑({x} : Finset V) : Set V))
        (A.functionClosure_isClosed (↑({x} : Finset V) : Set V))).GeneratedByAtMost 1 := by
    simpa only [Finset.card_singleton] using
      (Structure.functionClosure_finset_generatedByAtMost A ({x} : Finset V))
  exact oneGeneratedFullStructure_irreducible _ hGen

/-- A weak EHN map is a FULL embedding on the complete closed
source hull generated by ANY individual source vertex. As a
consequence its target ONE-GENERATOR closure lies in its raw
source image; no extra function values can appear there. -/
theorem ehn_target_singleton_closure_subset_source_image
    {V W : Type v}
    (A : Structure L V) (B : Structure L W)
    (f : V → W)
    (hf : A.IsEHNHomomorphismEmbedding B f)
    (x : V) :
    B.functionClosure ({f x} : Set W) ⊆ Set.range f := by
  classical
  let S : Finset V := {x}
  let H : Set V := A.functionClosure (↑S : Set V)
  have hH : A.IsClosed H := A.functionClosure_isClosed (↑S : Set V)
  let E : Structure L H := A.induce H hH
  let e : Structure.Embedding E A := A.inclusion H hH
  have hIrred : E.Irreducible := by
    have hGen : E.GeneratedByAtMost 1 := by
      simpa only [S, Finset.card_singleton] using
        (Structure.functionClosure_finset_generatedByAtMost A S)
    exact oneGeneratedFullStructure_irreducible E hGen
  obtain ⟨g, hg⟩ := hf.2 E hIrred e
  have hxH : x ∈ H := by
    apply A.subset_functionClosure (↑S : Set V)
    simp [S]
  have hSeed : ({f x} : Set W) ⊆ Set.range g := by
    intro y hy
    have hyEq : y = f x := by simpa only [Set.mem_singleton_iff] using hy
    subst y
    refine ⟨⟨x, hxH⟩, ?_⟩
    exact hg ⟨x, hxH⟩
  intro y hy
  obtain ⟨z, hz⟩ :=
    hy (Set.range g) g.range_isClosed hSeed
  exact ⟨z.1, (hg z).symm.trans hz⟩

/-- A general, explicitly named ONE-GENERATOR coverage condition
suffices for closedness of the image of a weak EHN map.

Every function input tuple drawn from the raw image must be
contained in the target closed hull of ONE raw image vertex.
This does not hold for arbitrary binary operations. -/
theorem ehn_range_isClosed_of_oneGeneratorInputCoverage
    {V W : Type v}
    (A : Structure L V) (B : Structure L W)
    (f : V → W)
    (hf : A.IsEHNHomomorphismEmbedding B f)
    (hInputs :
      ∀ (F : L.FuncSymbol) (xs : Fin (L.funcArity F) → W),
        (∀ i, xs i ∈ Set.range f) →
        ∃ x : V, ∀ i,
          xs i ∈ B.functionClosure ({f x} : Set W)) :
    B.IsClosed (Set.range f) := by
  intro F xs hxs y hy
  obtain ⟨x, hContained⟩ := hInputs F xs hxs
  have hClosed :=
    B.functionClosure_isClosed ({f x} : Set W)
  have hyHull : y ∈ B.functionClosure ({f x} : Set W) :=
    hClosed F xs hContained hy
  exact ehn_target_singleton_closure_subset_source_image
    A B f hf x hyHull

/-- **Unary-function special case of the original source-image gap.**
In a language with no function of arity above one, EVERY nonempty
weak EHN source image is function-closed in its target. Relational
symbols may have any arity. The condition is on full native
set-valued function symbols, not on their graph encoding.

For binary functions the statement can fail: a function value on
two unrelated image vertices need not be witnessed in any source
irreducible test. Thus this theorem is deliberately not generalized
without a separate multi-generator property. -/
theorem ehn_range_isClosed_of_unaryFunctions
    {V W : Type v}
    [Nonempty V]
    (A : Structure L V) (B : Structure L W)
    (f : V → W)
    (hf : A.IsEHNHomomorphismEmbedding B f)
    (hUnary : ∀ F : L.FuncSymbol, L.funcArity F ≤ 1) :
    B.IsClosed (Set.range f) := by
  apply ehn_range_isClosed_of_oneGeneratorInputCoverage A B f hf
  intro F xs hxs
  by_cases hn : L.funcArity F = 0
  · refine ⟨Classical.choice (inferInstance : Nonempty V), ?_⟩
    intro i
    have hi : i.val < 0 := by simpa [hn] using i.isLt
    exact False.elim (Nat.not_lt_zero _ hi)
  · have hOne : L.funcArity F = 1 := by
      have hLe := hUnary F
      omega
    let i : Fin (L.funcArity F) := ⟨0, by omega⟩
    obtain ⟨x, hx⟩ := hxs i
    refine ⟨x, ?_⟩
    intro j
    have hji : j = i := Fin.ext (by omega)
    subst j
    rw [hx]
    exact B.subset_functionClosure ({f x} : Set W) (by simp)

end AllThoseRamseyClasses.Lifts
