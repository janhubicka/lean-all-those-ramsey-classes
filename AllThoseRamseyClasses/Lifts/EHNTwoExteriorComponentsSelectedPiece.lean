import AllThoseRamseyClasses.Lifts.WeakMinimalGeometricChart
import AllThoseRamseyClasses.Lifts.PositiveGeometricRootFromConnectedPath
import AllThoseRamseyClasses.Lifts.GlobalConnectedForbiddenJEP
import AllThoseRamseyClasses.Lifts.ConnectedForbiddenPositivePiece

/-!
# Track D: exactly when a closed input hull yields a selected forbidden geometric piece

The local Track D positive-incidence defects now yield a true original
input-generated FUNCTION-CLOSED source hull H that is strictly smaller
than its finite connected forbidden source. There is a positive Gaifman
boundary edge across H, but this alone does NOT make H a separator.

This module states and proves the sharp additional geometric premise
needed for selecting an actual 2019 forbidden piece:

  there exist TWO actual source vertices outside H which lie in
  DISTINCT Gaifman components after deleting the whole H.

Then H is a genuine CLOSED separator. The existing finite
minimal-closed-separator selector chooses R ⊆ H, and the verified
chart reindexing produces an ACTUAL geometric forbidden piece whose
entire ordered root enumerates R and whose distinguished outside
vertices are the two chosen original exterior vertices. Connectedness
of the original forbidden source forces POSITIVE root width.

No weak image quotient, root-image injectivity, arbitrary chart,
or stronger forbidden-image closure enters the theorem. The
additional two-exterior-component premise is EXPLICIT and is NOT
proved from a proper crossed source hull or a single boundary edge.
The theorem does not claim the resulting piece is flippable or that
the common original global canonical lift contains its relation at
a possibly colliding target root.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u
variable {L : Language.{u}}

/-- A finite native CLOSED separator with two exterior vertices
that are connected BEFORE deletion but disconnected AFTER deletion
contains a genuine inclusion-minimal CLOSED separator. Its exact
native geometric chart has POSITIVE width, retains the original
two exterior distinguished vertices, and has its root entirely
inside the original closed separator.

This is the precisely scoped positive result, not an arbitrary
claim that all closed hulls are geometric pieces. -/
theorem finiteClosedCut_twoExteriorComponents_selectPositivePiece
    {V : Type}
    [Finite V]
    (Source : Structure L V)
    (S : Set V)
    (hClosed : Source.IsClosed S)
    (x y : {v : V // v ∉ S})
    (hSeparated : ¬ ReachOutside Source.graph S x y)
    (hConnected :
      Relation.ReflTransGen
        (GaifmanAdjacent Source.graph) x.1 y.1) :
    ∃ (n : ℕ) (d : GeometricFunctionalPieceData Source n),
      0 < n ∧
      Set.range d.roots ⊆ S ∧
      d.left.1 = x.1 ∧
      d.right.1 = y.1 := by
  obtain ⟨R, hRS, hMinimal⟩ :=
    finite_exists_minimalClosedSeparator_inside
      Source S hClosed x y hSeparated
  obtain ⟨n, d, hRoot, hLeft, hRight⟩ :=
    finiteMinimalClosedSeparator_toGeometricChart Source R
      (outsideCutMap hRS x) (outsideCutMap hRS y) hMinimal
  have hPath : ReachOutside Source.graph (∅ : Set V)
      (⟨d.left.1, by simp⟩ : {z : V // z ∉ (∅ : Set V)})
      (⟨d.right.1, by simp⟩ : {z : V // z ∉ (∅ : Set V)}) := by
    simpa only [hLeft, hRight] using
      (gaifmanPath_to_emptyCutReach Source hConnected)
  exact ⟨n, d,
    geometricPiece_positiveWidth_of_emptyCut_path Source d hPath,
    hRoot ▸ hRS, hLeft, hRight⟩

/-- If the entire FUNCTION-CLOSED source hull H generated by some
original source input coordinates separates TWO actual exterior
vertices of a finite, connected, genuinely forbidden source,
there is an ACTUAL positive-width 2019 forbidden geometric piece
whose full ordered closed root lies inside H.

The two outside vertices and the target original source map are
not replaced or quotiented. The full forbidden-piece class witness
uses the actual original source, not a guessed rooted candidate.

This does NOT assert that a STRICT proper crossed source hull has
two separated exterior components: that remains a separate hard
hypothesis necessary to connect the Track D incidence defect to
the selected piece and eventual Claim 2 flip. -/
theorem forbiddenSource_twoExteriorHullComponents_hasPositiveForbiddenPiece
    (F : ∀ {W : Type}, Structure L W → Prop)
    (hConnected : GlobalForbiddenSourcesConnectedNonempty F)
    {V X : Type}
    (Source : Structure L V)
    (hFinite : Finite V)
    (hForbidden : F Source)
    (xs : X → V)
    (x y : {v : V //
      v ∉ Source.functionClosure (Set.range xs)})
    (hSeparated : ¬ ReachOutside Source.graph
      (Source.functionClosure (Set.range xs)) x y) :
    ∃ (n : ℕ) (d : GeometricFunctionalPieceData Source n),
      0 < n ∧
      Set.range d.roots ⊆ Source.functionClosure (Set.range xs) ∧
      d.left.1 = x.1 ∧
      d.right.1 = y.1 ∧
      geometricFunctionalRootedPattern Source d ∈
        forbiddenGeometricFunctionalPieces F n := by
  letI : Finite V := hFinite
  have hS : Source.IsClosed (Source.functionClosure (Set.range xs)) :=
    Source.functionClosure_isClosed (Set.range xs)
  have hPath :=
    (hConnected Source hFinite hForbidden).2 x.1 y.1
  obtain ⟨n, d, hn, hRoot, hLeft, hRight⟩ :=
    finiteClosedCut_twoExteriorComponents_selectPositivePiece
      Source (Source.functionClosure (Set.range xs))
      hS x y hSeparated hPath
  have hForbiddenPiece :
      geometricFunctionalRootedPattern Source d ∈
        forbiddenGeometricFunctionalPieces F n := by
    change IsForbiddenGeometricFunctionalPiece F
      (geometricFunctionalRootedPattern Source d)
    exact ⟨V, Source, inferInstance, hForbidden, d,
      ⟨RootedPatternIso.refl _⟩⟩
  exact ⟨n, d, hn, hRoot, hLeft, hRight, hForbiddenPiece⟩

end AllThoseRamseyClasses.Lifts
