import AllThoseRamseyClasses.Lifts.EHNPureRelationalGraphBridge
import AllThoseRamseyClasses.Lifts.EHNPrintedTupleImageClosure
import Mathlib.Tactic

/-!
# Track D: a printed-image-closed family generated by C5

To avoid a separate classification of all C5 quotient graphs, define
the forbidden family to contain **exactly** the vertex-surjective,
tuple-surjective original-partial homomorphism-embedding images
of the source C5 (binary symmetric cycle, empty ternary predicate).

The family is image-closed in the PRECISE printed sense: if
F is such an image and g : F → H is a tuple-surjective
original-partial HE (NOT necessarily vertex-surjective), restrict
H to the image of g. The composite C5 → H is still a HE, its
restriction is surjective on vertices, and the two tuple-surjectivity
conditions compose. Hence the image-induced structure is in the
family and FULLY embeds into H.

Every member of the family has empty ternary predicate. No full
member embeds into the triangle-with-an-extra-T target: any proper
three-colouring of C5 uses all three colours, so a full embedding
of a family member into that three-vertex target would be surjective
and would have to reflect its added ternary tuple.

The existing native EHN map C5 → triangle-with-T is not injective.
Thus this family gives a short fully source-matched COUNTEREXAMPLE
to the blanket arbitrary-target image-injectivization inference
once the following Lean theorems pass kernel and axiom audits.
It is not a counterexample to the maximal-common-lift strong AP.
-/

namespace AllThoseRamseyClasses.Lifts.EHNRelationalTupleGap

open StructuralRamsey
open StructuralRamsey.Structure
open AllThoseRamseyClasses.Lifts.RootCollisionFiveCycle

/-- All vertex- and tuple-surjective ORIGINAL-PARTIAL HE
images of the fixed finite five-cycle, with no separate
restriction on the chosen target carrier representation.
This is an isomorphism-stable family of finite structures. -/
def fiveCycleImageFamily {X : Type}
    (P : Structure language X) : Prop :=
  ∃ f : Fin 5 → X,
    Function.Surjective f ∧
    IsOriginalPartialHomomorphismEmbedding cycle5 P f ∧
    OriginalPartialTupleSurjective cycle5 P f

/-- The original C5 itself belongs to its image family. -/
theorem cycle5_mem_imageFamily : fiveCycleImageFamily cycle5 := by
  refine ⟨id, Function.surjective_id, ?_, ?_⟩
  · exact (Structure.Embedding.id cycle5).isEHNHomomorphismEmbedding.toOriginalPartial
  · constructor
    · intro R xs hRel
      exact ⟨xs, hRel, rfl⟩
    · intro F
      exact Empty.elim F

/-- Every member of this family is finite: it is a surjective
image of the five-element source. -/
theorem finite_of_fiveCycleImageFamily
    {X : Type} (P : Structure language X)
    (hP : fiveCycleImageFamily P) : Finite X := by
  obtain ⟨f, hf, _, _⟩ := hP
  exact Finite.of_surjective f hf

/-- Every member has EMPTY ternary relation, because a
tuple-surjective image of a source with no positive ternary
tuple cannot invent a ternary incidence. -/
theorem fiveCycleImageFamily_ternary_empty
    {X : Type} {P : Structure language X}
    (hP : fiveCycleImageFamily P)
    (xs : Fin 3 → X) : ¬ P.rel true xs := by
  obtain ⟨f, _, _, hTuple⟩ := hP
  intro hRel
  obtain ⟨ys, hSrc, _⟩ := hTuple.1 true xs hRel
  exact hSrc

/-- Every proper 3-colouring of the odd 5-cycle actually uses all
three colours. This finite statement avoids classifying the
individual C5 quotients. -/
theorem cycle5_properThreeColouring_surjective :
    ∀ f : Fin 5 → Fin 3,
      (∀ a b, cycle5Edge a b → f a ≠ f b) →
      Function.Surjective f := by
  decide

/-- The forbidden family is closed under tuple-surjective
original-partial homomorphism-embedding images in EXACTLY the
sense of the 2019 printed definition. The input map F→Dst
need not be surjective on vertices. -/
theorem fiveCycleImageFamily_printedImageClosed :
    HasTupleSurjectiveForbiddenImageClosure
      (L := language) fiveCycleImageFamily := by
  intro X Y Src Dst q hSrc hHE hTuple
  obtain ⟨f, hfSurj, hfHE, hfTuple⟩ := hSrc
  let S : Set Y := Set.range q
  have hS : Dst.IsClosed S := by
    intro F
    exact Empty.elim F
  let Q : Structure language S := Dst.induce S hS
  let g : Fin 5 → S :=
    fun a => ⟨q (f a), ⟨f a, rfl⟩⟩
  have hgSurj : Function.Surjective g := by
    intro z
    obtain ⟨x, hx⟩ := z.2
    obtain ⟨a, ha⟩ := hfSurj x
    refine ⟨a, Subtype.ext ?_⟩
    change q (f a) = z.1
    rw [ha, hx]
  have hgEHN : cycle5.IsEHNHomomorphismEmbedding Q g := by
    exact ehn_codRestrict_functionClosed
      cycle5 Dst (q ∘ f)
      (hHE.toEHN.comp hfHE.toEHN)
      S hS (fun a => ⟨f a, rfl⟩)
  have hgTuple : OriginalPartialTupleSurjective cycle5 Q g := by
    constructor
    · intro R zs hRel
      let raw : Fin (language.relArity R) → Y := Subtype.val ∘ zs
      obtain ⟨ys, hYS, hYeq⟩ :=
        hTuple.1 R raw (show Dst.rel R raw from hRel)
      obtain ⟨as, hAS, hAeq⟩ := hfTuple.1 R ys hYS
      refine ⟨as, hAS, ?_⟩
      funext i
      apply Subtype.ext
      change (zs i).1 = q (f (as i))
      calc
        (zs i).1 = q (ys i) := congrFun hYeq i
        _ = q (f (as i)) := congrArg q (congrFun hAeq i)
    · intro F
      exact Empty.elim F
  have hQ : fiveCycleImageFamily Q :=
    ⟨g, hgSurj, hgEHN.toOriginalPartial, hgTuple⟩
  exact ⟨S, Q, hQ, ⟨Dst.inclusion S hS⟩⟩

/-- No FULL forbidden image member can be embedded into the
three-vertex triangle with the extra ternary tuple. The
composition C5→P→Target is a proper three-colouring and thus
surjective, forcing P→Target itself to cover all three
vertices and reflect the added ternary tuple—impossible
because every family member has empty ternary relation. -/
theorem fiveCycleImageFamily_noFullMember_in_triangleExtraTernary :
    ¬ ContainsFullForbiddenSubstructure
        (L := language) fiveCycleImageFamily
        triangleExtraTernary := by
  rintro ⟨X, P, hP, ⟨e⟩⟩
  obtain ⟨f, _, hfHE, _⟩ := hP
  have hProper :
      ∀ a b : Fin 5, cycle5Edge a b → e (f a) ≠ e (f b) := by
    intro a b hab
    let xs : Fin 2 → Fin 5 := ![a, b]
    have hSrc : cycle5.rel false xs := hab
    have hInP : P.rel false (f ∘ xs) :=
      hfHE.1.1 false xs hSrc
    have hInD : triangleExtraTernary.rel false (e ∘ (f ∘ xs)) :=
      (e.map_rel_iff false (f ∘ xs)).mpr hInP
    exact hInD
  have hColourSurj : Function.Surjective (fun a => e (f a)) :=
    cycle5_properThreeColouring_surjective
      (fun a => e (f a)) hProper
  have heSurj : Function.Surjective e := by
    intro y
    obtain ⟨a, ha⟩ := hColourSurj y
    exact ⟨f a, ha⟩
  obtain ⟨x0, hx0⟩ := heSurj 0
  obtain ⟨x1, hx1⟩ := heSurj 1
  obtain ⟨x2, hx2⟩ := heSurj 2
  let xs : Fin 3 → X := ![x0, x1, x2]
  have hTarget : triangleExtraTernary.rel true (e ∘ xs) := by
    change extraTernary (e x0) (e x1) (e x2)
    exact ⟨hx0, hx1, hx2⟩
  have hInP : P.rel true xs :=
    (e.map_rel_iff true xs).mp hTarget
  exact (fiveCycleImageFamily_ternary_empty hP xs) hInP

/-- With the previously established NATIVE EHN witness,
this finite image-closed family refutes arbitrary-target
injectivization under the printed closure axiom. The target
is NOT asserted to arise as a free amalgam of compatible
maximal-lift witnesses. -/
theorem fiveCycleImageFamily_noninjectiveWitness_noInjectiveReplacement :
    HasTupleSurjectiveForbiddenImageClosure
      (L := language) fiveCycleImageFamily ∧
    fiveCycleImageFamily cycle5 ∧
    cycle5.IsEHNHomomorphismEmbedding
      triangleExtraTernary weakColor ∧
    ¬ Function.Injective weakColor ∧
    ¬ ContainsFullForbiddenSubstructure
      (L := language) fiveCycleImageFamily
      triangleExtraTernary := by
  exact ⟨fiveCycleImageFamily_printedImageClosed,
    cycle5_mem_imageFamily, weakColor_nativeEHN,
    weakColor_not_injective,
    fiveCycleImageFamily_noFullMember_in_triangleExtraTernary⟩

end AllThoseRamseyClasses.Lifts.EHNRelationalTupleGap
