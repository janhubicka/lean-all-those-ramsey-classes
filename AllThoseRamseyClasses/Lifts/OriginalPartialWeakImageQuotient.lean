import AllThoseRamseyClasses.Lifts.PositiveTupleSurjectiveImage
import PartiteConstruction.Functional.OriginalPartialSemantics

/-!
# The exact original-2019 partial homomorphism of a weak image quotient

The 2019 paper's homomorphism convention for genuinely partial
functions preserves the ENTIRE target function fibre only when
the source input tuple is defined. It does not reflect definedness
at arbitrary undefined source inputs.

The weak incidence-generated image consists of precisely the
positive relation/function incidences generated by the source.
Its quotient map is always a weak homomorphism. We prove the
stronger ORIGINAL partial homomorphism property whenever the map
into the ambient target is original-partial homomorphic:

If a source input x is defined and another source input y maps
to the same quotient input tuple, then y is either undefined or
its entire image function fibre equals the same ambient target
fibre. Therefore no additional weak-image value can be present
at the quotient image of x beyond the image of x's own fibre.

Combined with the already checked positive incidence-surjectivity,
the quotient is tuple-surjective in the manuscript's ORIGINAL
partial-function sense: it covers every positive relation tuple
and every defined function-domain tuple of the weak image.

IMPORTANT: this does NOT prove that the quotient is a
homomorphism-EMBEDDING on every irreducible source substructure.
Nor does it prove that the weak image FULLY embeds into its
ambient target. Those facts require separate arguments before
the forbidden-family image closure hypothesis can be used.
Defined-but-empty set-valued applications are not represented by
the current nonempty-domain encoding.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {U V : Type v}

/-- Tuple-surjective in the original 2019 partial-function sense:
every positive relation tuple and every function input tuple
with a NONEMPTY output fibre has a defined source preimage.
The definition imposes no blanket reflection of undefinedness. -/
def OriginalPartialTupleSurjective
    (A : Structure L U) (B : Structure L V)
    (f : U → V) : Prop :=
  (∀ R (xs : Fin (L.relArity R) → V),
    B.rel R xs →
      ∃ ys : Fin (L.relArity R) → U,
        A.rel R ys ∧ xs = f ∘ ys) ∧
  (∀ F (xs : Fin (L.funcArity F) → V),
    InOriginalPartialDomain B F xs →
      ∃ ys : Fin (L.funcArity F) → U,
        InOriginalPartialDomain A F ys ∧ xs = f ∘ ys)

/-- Positive incidence-surjectivity directly implies tuple
surjectivity on the original nonempty function domains. -/
theorem PositiveIncidenceSurjective.toOriginalPartialTupleSurjective
    {A : Structure L U} {B : Structure L V}
    {f : U → V}
    (h : PositiveIncidenceSurjective A B f) :
    OriginalPartialTupleSurjective A B f := by
  refine ⟨h.2.1, ?_⟩
  intro F xs hx
  exact h.domains F xs hx

/-- If f is a homomorphism of PARTIAL functions in the
original 2019 sense, the canonical quotient onto its
incidence-generated weak image preserves every complete
function fibre at each source-defined tuple.

This is NOT the total-fibre survey homomorphism notion,
and the quotient is not asserted to be an HE. -/
theorem originalPartialHom_weakImage_quotient
    (A : Structure L U) (B : Structure L V)
    (f : U → V)
    (hf : IsOriginalPartialHomomorphism A B f) :
    IsOriginalPartialHomomorphism A (Structure.weakImage A B f)
      (Structure.weakImage.quotientMap (f := f)) := by
  let q : U → Set.range f := Structure.weakImage.quotientMap (f := f)
  constructor
  · exact (Structure.weakImage.quotientMap_weak
      (A := A) (B := B) (f := f)).1
  · intro F xs hdefined
    ext z
    constructor
    · rintro ⟨a, ha, hqa⟩
      exact ⟨xs, a, ha, (fun _ => rfl), hqa⟩
    · rintro ⟨ys, a, ha, hargs, hout⟩
      have hSame : f ∘ xs = f ∘ ys := by
        funext i
        have hi : q (xs i) = q (ys i) := hargs i
        exact congrArg Subtype.val hi
      have hxFibre := hf.2 F xs hdefined
      have hyFibre := hf.2 F ys ⟨a, ha⟩
      have hValue : f a ∈ imageSet f (A.func F xs) := by
        rw [hxFibre, hSame, ← hyFibre]
        exact ⟨a, ha, rfl⟩
      obtain ⟨b, hb, hfb⟩ := hValue
      refine ⟨b, hb, ?_⟩
      apply Subtype.ext
      have hz : z.1 = f a := congrArg Subtype.val hout
      exact hfb.trans hz.symm

/-- The image quotient of an original partial homomorphism has
all three exact properties needed for the IMAGE-CLOSURE
premise: vertex surjectivity, original partial homomorphism
on source-defined inputs, and tuple-surjectivity on positive
relations and defined function domains.

The stronger homomorphism-embedding / full-image reflection
properties remain explicit open obligations. -/
theorem originalPartialHom_weakImage_quotient_data
    (A : Structure L U) (B : Structure L V)
    (f : U → V)
    (hf : IsOriginalPartialHomomorphism A B f) :
    Function.Surjective (Structure.weakImage.quotientMap (f := f)) ∧
    IsOriginalPartialHomomorphism A (Structure.weakImage A B f)
      (Structure.weakImage.quotientMap (f := f)) ∧
    OriginalPartialTupleSurjective A (Structure.weakImage A B f)
      (Structure.weakImage.quotientMap (f := f)) := by
  refine ⟨Structure.weakImage.quotientMap_surjective (f := f),
    originalPartialHom_weakImage_quotient A B f hf, ?_⟩
  exact (weakImage_quotient_positiveIncidenceSurjective A B f)
    .toOriginalPartialTupleSurjective

end AllThoseRamseyClasses.Lifts
