import AllThoseRamseyClasses.Lifts.EHNTwoExteriorComponentsSelectedPiece
import AllThoseRamseyClasses.Lifts.WeakFreeGaifmanComponents
import AllThoseRamseyClasses.Lifts.WeakSourceFreeAmalgamPartition

/-!
# Track D: selected forbidden piece OR an actual reachable fresh seam vertex

The common root PREIMAGE of a genuine native full free amalgam
separates original source vertices mapped to opposite exclusive
target sides, even under a noninjective original EHN source map.

Let H be the true native function-closed hull generated by an
original source input tuple whose entire image lies in the complete
common seam. Weak-map preimages of function-closed sets are closed,
so H lies within the full root preimage.

For any chosen left- and right-exclusive original source vertices:

* if H already separates them, the verified finite
  minimal-closed-separator theorem yields an actual positive-width
  forbidden geometric piece rooted INSIDE H (under finite connected
  forbidden-source hypotheses);
* if H does NOT separate them, an ACTUAL Gaifman path between
  those vertices avoiding H meets a genuine source vertex in
  the shared root preimage OUTSIDE H. The proof supplies that
  fresh seam vertex with its explicit reachability from the
  left-exclusive selected original source vertex.

This is an exact source-geometric seam-escape alternative. It is
not a proof that adding a fresh seam vertex preserves a forbidden
source or gives a compatible-root selected-Q replacement. No
root-image injection, target weak quotient, or stronger image
closure is silently assumed.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u
variable {L : Language.{u}}

/-- If the images of ALL generators of an original source tuple
belong to the full common root seam, the entire original
function-closed source hull lies in the ACTUAL common-root
preimage. The original map may have arbitrary collisions. -/
theorem ehn_seamInputs_generatedClosedHull_insideRootPreimage
    {V UX UA UB UT X : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (xs : X → V)
    (hInputs : ∀ i, f (xs i) ∈ Set.range (jL.comp sL)) :
    Source.functionClosure (Set.range xs) ⊆
      weakFreeRootPart (sL := sL) (iL := jL) f := by
  have hRootClosed : Source.IsClosed
      (weakFreeRootPart (sL := sL) (iL := jL) f) :=
    weakFreeRootPart_isClosed (sL := sL) (iL := jL)
      f hf.1
  intro v hv
  exact hv
    (weakFreeRootPart (sL := sL) (iL := jL) f)
    hRootClosed (by
      rintro z ⟨i, rfl⟩
      exact hInputs i)

/-- Take any ACTUAL path in the original source graph between
a left-exclusive and right-exclusive source vertex which
avoids a set S contained in the common-root preimage.
The path must meet a GENUINE source vertex of the shared
root preimage OUTSIDE S.

More precisely, the witness is itself reached from the chosen
left-exclusive vertex by a subpath avoiding S. This uses the
verified left-side Gaifman propagation lemma under weak maps,
not full reflection of the forbidden witness map. -/
theorem weakExclusiveGaifmanPath_meets_freshSharedRootVertex
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (S : Set V)
    (hSRoot : S ⊆ weakFreeRootPart (sL := sL) (iL := jL) f)
    (x y : V)
    (hx : x ∈ weakFreeLeftPart (sL := sL) (iL := jL) f)
    (hy : y ∈ weakFreeRightPart
      (sL := sL) (iL := jL) (iR := jR) f)
    (hPath : ReachOutside Source.graph S
      ⟨x, fun h => hx.2 (hSRoot h)⟩
      ⟨y, fun h => hy.2 (hSRoot h)⟩) :
    ∃ (z : V) (hz : z ∉ S),
      z ∈ weakFreeRootPart (sL := sL) (iL := jL) f ∧
      ReachOutside Source.graph S
        ⟨x, fun h => hx.2 (hSRoot h)⟩ ⟨z, hz⟩ := by
  classical
  let xS : {v : V // v ∉ S} :=
    ⟨x, fun h => hx.2 (hSRoot h)⟩
  let yS : {v : V // v ∉ S} :=
    ⟨y, fun h => hy.2 (hSRoot h)⟩
  have hAlong :
      ∀ z : {v : V // v ∉ S},
        ReachOutside Source.graph S xS z →
        (z.1 ∈ weakFreeLeftPart (sL := sL) (iL := jL) f) ∨
          ∃ mid : {v : V // v ∉ S},
            mid.1 ∈ weakFreeRootPart (sL := sL) (iL := jL) f ∧
            ReachOutside Source.graph S xS mid := by
    intro z hReach
    induction hReach with
    | refl => exact Or.inl hx
    | @tail a b hab hedge ih =>
        rcases ih with hLeft | ⟨mid, hMidRoot, hMidReach⟩
        · by_cases hRootB :
              b.1 ∈ weakFreeRootPart (sL := sL) (iL := jL) f
          · exact Or.inr ⟨b, hRootB, hab.tail hedge⟩
          · exact Or.inl
              (weakFreePartition_left_step
                hFree f hf.1 hLeft hRootB hedge)
        · exact Or.inr ⟨mid, hMidRoot, hMidReach⟩
  rcases hAlong yS hPath with hLeftY | ⟨mid, hMidRoot, hMidReach⟩
  · exact False.elim ((Set.disjoint_left.mp
      (weakFreePartition_left_right_disjoint hFree f)) hLeftY hy)
  · exact ⟨mid.1, mid.2, hMidRoot, hMidReach⟩

/-- For actual left- or right-exclusive original source vertices and
an input tuple mapping entirely into the shared full native
root, one of two concrete outcomes occurs:

1. a TRUE positive-width geometric forbidden piece with the
   exact source endpoints, whose entire ordered closed root
   lies inside the input-generated function-closed source hull;
2. an ACTUAL source seam vertex NOT in that hull, reached
   along an original Gaifman path avoiding the hull from
   the chosen left-exclusive original source vertex.

The first branch is conditional on the hull separating the
endpoints (proved here by case split), not on an imagined
root-image injectivity. The second branch witnesses precisely
why the smaller hull does not yet support a separator; it
does NOT assert a compatible-root flip after adjoining it. -/
theorem forbiddenSeamInputHull_selectedPiece_or_reachableFreshSeamVertex
    (F : ∀ {W : Type}, Structure L W → Prop)
    (hConnected : GlobalForbiddenSourcesConnectedNonempty F)
    {V UX UA UB UT X : Type}
    (Source : Structure L V)
    (hFinite : Finite V)
    (hForbidden : F Source)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (xs : X → V)
    (hInputs : ∀ i, f (xs i) ∈ Set.range (jL.comp sL))
    (x y : V)
    (hx : x ∈ weakFreeLeftPart (sL := sL) (iL := jL) f)
    (hy : y ∈ weakFreeRightPart
      (sL := sL) (iL := jL) (iR := jR) f) :
    (∃ (n : ℕ) (d : GeometricFunctionalPieceData Source n),
      0 < n ∧
      Set.range d.roots ⊆ Source.functionClosure (Set.range xs) ∧
      d.left.1 = x ∧ d.right.1 = y ∧
      geometricFunctionalRootedPattern Source d ∈
        forbiddenGeometricFunctionalPieces F n) ∨
    (∃ (z : V) (hz :
        z ∉ Source.functionClosure (Set.range xs)),
      z ∈ weakFreeRootPart (sL := sL) (iL := jL) f ∧
      ReachOutside Source.graph
        (Source.functionClosure (Set.range xs))
        ⟨x, fun h => hx.2
          (ehn_seamInputs_generatedClosedHull_insideRootPreimage
            Source Root Left Right Target sL sR jL jR
            f hf xs hInputs h)⟩
        ⟨z, hz⟩) := by
  classical
  have hSRoot :=
    ehn_seamInputs_generatedClosedHull_insideRootPreimage
      Source Root Left Right Target sL sR jL jR
      f hf xs hInputs
  let S : Set V := Source.functionClosure (Set.range xs)
  let xS : {v : V // v ∉ S} :=
    ⟨x, fun h => hx.2 (hSRoot h)⟩
  let yS : {v : V // v ∉ S} :=
    ⟨y, fun h => hy.2 (hSRoot h)⟩
  by_cases hSeparated : ¬ ReachOutside Source.graph S xS yS
  · obtain ⟨n, d, hn, hRoot, hLeft, hRight, hPiece⟩ :=
      forbiddenSource_twoExteriorHullComponents_hasPositiveForbiddenPiece
        F hConnected Source hFinite hForbidden
        xs xS yS hSeparated
    exact Or.inl ⟨n, d, hn, hRoot, hLeft, hRight, hPiece⟩
  · have hPath : ReachOutside Source.graph S xS yS := by
      by_contra hNoReach
      exact hSeparated hNoReach
    obtain ⟨z, hz, hRoot, hReach⟩ :=
      weakExclusiveGaifmanPath_meets_freshSharedRootVertex
        Source Root Left Right Target sL sR jL jR hFree
        f hf S hSRoot x y hx hy hPath
    exact Or.inr ⟨z, hz, hRoot, hReach⟩

end AllThoseRamseyClasses.Lifts
