import AllThoseRamseyClasses.Lifts.WeakSourceFreeAmalgamPartition
import Mathlib.Data.Set.Card

/-!
# Track D: finite, native function-closed seam saturation step

An original EHN forbidden witness into a genuine FULL native free
amalgam has a FUNCTION-CLOSED common-root preimage R. Let H be the
TRUE native function closure generated by a source input tuple
whose original target image coordinates all lie in R.

The selected-piece-or-fresh-seam-vertex dichotomy can return an
ACTUAL new source vertex z ∈ R \ H. This module shows that replacing
H by its true native function closure of H ∪ {z}:

* preserves closure and containment in R;
* STRICTLY increases the set of actual original source vertices;
* increases cardinality by at least one, without exceeding |R|.

Hence no such enlargement can be repeated more than the finite
source root budget. There is NO assumed root-image injection,
forbidden-source quotient, arbitrary single-valued function
restriction, or compatibility flip.

This is only the rigorous *progress measure* for a future finite
saturation/selected-piece construction; it does NOT supply a
collision-tolerant selected-Q source flip or establish strong AP.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u
variable {L : Language.{u}}

/-- A fresh generator inside a genuine native function-closed set T
strictly enlarges ANY contained seed S after taking its ACTUAL
function closure; no positive-arity or single-valued assumption.

The whole enlarged native hull remains inside the same closed T. -/
theorem nativeFunctionClosure_adjoinFresh_strict_insideClosed
    {V : Type} (A : Structure L V)
    (S T : Set V)
    (hT : A.IsClosed T)
    (hST : S ⊆ T)
    (z : V)
    (hzT : z ∈ T) (hzFresh : z ∉ S) :
    S ⊂ A.functionClosure (S ∪ {z}) ∧
    A.functionClosure (S ∪ {z}) ⊆ T := by
  have hNewInside : A.functionClosure (S ∪ {z}) ⊆ T := by
    intro v hv
    apply hv T hT
    intro t ht
    rcases ht with ht | ht
    · exact hST ht
    · have htz : t = z := by simpa using ht
      simpa [htz] using hzT
  have hIncl : S ⊆ A.functionClosure (S ∪ {z}) := by
    intro v hv
    exact A.subset_functionClosure (S ∪ {z}) (Or.inl hv)
  have hzNew : z ∈ A.functionClosure (S ∪ {z}) :=
    A.subset_functionClosure (S ∪ {z}) (Or.inr (by simp))
  have hNe : S ≠ A.functionClosure (S ∪ {z}) := by
    intro hEq
    apply hzFresh
    rw [hEq]
    exact hzNew
  exact ⟨(Set.ssubset_iff_subset_ne).2 ⟨hIncl, hNe⟩, hNewInside⟩

/-- A finite quantitative budget for repeatedly adjoining ACTUAL
fresh vertices to native function-closed sets: S grows strictly
and remains inside T, hence its vertex count increases while
remaining bounded by the exact original cardinality of T. -/
theorem finiteNativeFunctionClosure_adjoinFresh_cardBound
    {V : Type} [Finite V] (A : Structure L V)
    (S T : Set V)
    (hT : A.IsClosed T)
    (hST : S ⊆ T)
    (z : V)
    (hzT : z ∈ T) (hzFresh : z ∉ S) :
    S.ncard < (A.functionClosure (S ∪ {z})).ncard ∧
    (A.functionClosure (S ∪ {z})).ncard ≤ T.ncard := by
  obtain ⟨hStrict, hInside⟩ :=
    nativeFunctionClosure_adjoinFresh_strict_insideClosed
      A S T hT hST z hzT hzFresh
  exact ⟨Set.ncard_lt_ncard hStrict,
    Set.ncard_le_ncard hInside⟩

/-- An ACTUAL original source input image tuple is seam-contained
under an EHN map if and only if its generated native function-closed
hull is contained in the genuine full common-root preimage.

We only need the forward implication, retaining the original
target root embeddings and allowing source map collisions. -/
theorem ehn_inputHull_subset_commonRootPreimage
    {V UX UA UT X : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (jL : Structure.Embedding Left Target)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (xs : X → V)
    (hInputs : ∀ i, f (xs i) ∈ Set.range (jL.comp sL)) :
    Source.functionClosure (Set.range xs) ⊆
      weakFreeRootPart (sL := sL) (iL := jL) f := by
  have hClosed : Source.IsClosed
      (weakFreeRootPart (sL := sL) (iL := jL) f) :=
    weakFreeRootPart_isClosed (sL := sL) (iL := jL) f hf.1
  intro v hv
  exact hv
    (weakFreeRootPart (sL := sL) (iL := jL) f)
    hClosed (by
      rintro t ⟨i, rfl⟩
      exact hInputs i)

/-- A fresh ORIGINAL source seam vertex which is not in the
function-closed source input hull yields a STRICTLY larger
function-closed source hull STILL in the complete common-root
preimage, and its finite actual original source cardinality
increases strictly without exceeding the number of source
vertices mapped into the genuine seam.

This is a well-founded rank decrease in the complementary
seam budget, not a proof that repeated steps preserve an
original forbidden-piece incompatibility class or selected-Q flip.
-/
theorem ehn_freshSeamVertex_strictClosedHullGrowth
    {V UX UA UT X : Type} [Finite V]
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (jL : Structure.Embedding Left Target)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (xs : X → V)
    (hInputs : ∀ i, f (xs i) ∈ Set.range (jL.comp sL))
    (z : V)
    (hzSeam : z ∈ weakFreeRootPart (sL := sL) (iL := jL) f)
    (hzFresh : z ∉ Source.functionClosure (Set.range xs)) :
    let H := Source.functionClosure (Set.range xs)
    let H' := Source.functionClosure (H ∪ {z})
    H ⊂ H' ∧
    Source.IsClosed H' ∧
    H' ⊆ weakFreeRootPart (sL := sL) (iL := jL) f ∧
    H.ncard < H'.ncard ∧
    H'.ncard ≤
      (weakFreeRootPart (sL := sL) (iL := jL) f).ncard := by
  have hClosed : Source.IsClosed
      (weakFreeRootPart (sL := sL) (iL := jL) f) :=
    weakFreeRootPart_isClosed (sL := sL) (iL := jL) f hf.1
  have hInside : Source.functionClosure (Set.range xs) ⊆
      weakFreeRootPart (sL := sL) (iL := jL) f :=
    ehn_inputHull_subset_commonRootPreimage
      Source Root Left Target sL jL f hf xs hInputs
  have hStep :=
    nativeFunctionClosure_adjoinFresh_strict_insideClosed
      Source
      (Source.functionClosure (Set.range xs))
      (weakFreeRootPart (sL := sL) (iL := jL) f)
      hClosed hInside z hzSeam hzFresh
  have hBudget :=
    finiteNativeFunctionClosure_adjoinFresh_cardBound
      Source
      (Source.functionClosure (Set.range xs))
      (weakFreeRootPart (sL := sL) (iL := jL) f)
      hClosed hInside z hzSeam hzFresh
  exact ⟨hStep.1,
    Source.functionClosure_isClosed _,
    hStep.2, hBudget.1, hBudget.2⟩

end AllThoseRamseyClasses.Lifts
