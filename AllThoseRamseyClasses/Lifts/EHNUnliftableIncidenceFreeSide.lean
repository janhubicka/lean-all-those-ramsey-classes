import AllThoseRamseyClasses.Lifts.EHNExactTargetIncidenceTrichotomy
import AllThoseRamseyClasses.Lifts.EHNWeakImageUncoveredRelationInput
import AllThoseRamseyClasses.Lifts.EHNWeakImageUncoveredFunctionInput

/-!
# Track D: locate globally unliftable target incidences in a genuine free-amalgam side

The successful exact-positive-incidence Track D trichotomy (#1046) gives
actual target relations and complete native function values on SOURCE
IMAGE coordinates that have NO original positive source lift at ANY
choice of preimage input coordinates.

A genuine FULL native target free amalgam has no positive relation
tuple or positive function incidence spanning both exclusive sides.
This module converts each such unliftable target incidence into
an ACTUAL positive incidence in one of the two FULL side structures
with the exact target-coordinate equality. At the SAME time, the
given original source input tuple generates an ACTUAL proper FULL
native free decomposition with inputs collectively crossing both
proper sides, using only the original EHN irreducible-test condition.

The target-side and source-side free decompositions refer to different
structures. This module does not identify the source generated hull
with a genuinely selected forbidden geometric subpiece, and does not
claim that original maximal common lifts forbid the side incidence.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u
variable {L : Language.{u}}

/-- The full function-closed source hull generated by an input tuple
has a genuine native proper full free decomposition, with NEITHER
proper side containing all input generators. -/
def SourceInputHasCrossingNativeHull
    {V X : Type} (A : Structure L V) (xs : X → V) : Prop :=
  ∃ d : ProperFreeDecomposition
      (A.induce (A.functionClosure (Set.range xs))
        (A.functionClosure_isClosed (Set.range xs))),
    (¬ ∀ i : X, ∃ a : d.Left,
      Structure.closureLift A xs i = d.leftIn a) ∧
    (¬ ∀ i : X, ∃ b : d.Right,
      Structure.closureLift A xs i = d.rightIn b)

/-- A target-only positive OLD relation tuple on original source image
coordinates, with NO positive source relation lift at ANY other
matching source preimage tuple, belongs to ONE genuine FULL target
free-amalgam side. Its selected original source input tuple has
a crossed FULL native generated hull.

The forbidden source may have collisions anywhere, including in
the common-root preimage. No canonical-lift maximality or
root-image injectivity is used. -/
theorem ehn_unliftableRelation_liesInFullSide_withSourceCrossingHull
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (R : L.RelSymbol)
    (xs : Fin (L.relArity R) → V)
    (hTarget : Target.rel R (f ∘ xs))
    (hNoLift : ¬ ∃ ys : Fin (L.relArity R) → V,
      Source.rel R ys ∧ f ∘ ys = f ∘ xs) :
    SourceInputHasCrossingNativeHull Source xs ∧
    ((∃ (ys : Fin (L.relArity R) → UA),
       Left.rel R ys ∧ f ∘ xs = jL ∘ ys) ∨
     (∃ (ys : Fin (L.relArity R) → UB),
       Right.rel R ys ∧ f ∘ xs = jR ∘ ys)) := by
  have hNoSource : ¬ Source.rel R xs := by
    intro hRel
    exact hNoLift ⟨xs, hRel, rfl⟩
  have hUncovered :
      ¬ RelationInputCoveredByFullIrreducibleTest Source R xs := by
    intro hCovered
    exact hNoSource
      (ehn_localRelationInputCover_reflectsTargetPositive
        Source Target f hf R xs hCovered hTarget)
  obtain ⟨d, hCross⟩ :=
    uncoveredRelationInput_hasCrossingFreeDecomposition
      Source R xs hUncovered
  exact ⟨⟨d, hCross⟩,
    (hFree.rel_iff R (f ∘ xs)).mp hTarget⟩

/-- A positive target native function output on source-image inputs
that admits NO positive source function incidence at ANY matching
preimage tuple belongs entirely to ONE genuine FULL target side:
both the original input-image tuple and its target value are in
the image of the same full side embedding.

The original input-generated source hull has a proper FULL native
free decomposition with generators crossing both sides. Crucially,
the source crossing is NOT itself an extra structure placed across
the target amalgamation seam; only the target positive incidence
is side-localized. -/
theorem ehn_unliftableFunction_liesInFullSide_withSourceCrossingHull
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (sR : Structure.Embedding Root Right)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (hFree : Structure.IsFreeAmalgam sL sR jL jR)
    (f : V → UT)
    (hf : Source.IsEHNHomomorphismEmbedding Target f)
    (G : L.FuncSymbol)
    (xs : Fin (L.funcArity G) → V)
    (z : UT)
    (hTarget : z ∈ Target.func G (f ∘ xs))
    (hNoLift : ¬ ∃ (ys : Fin (L.funcArity G) → V) (out : V),
      out ∈ Source.func G ys ∧
      f ∘ ys = f ∘ xs ∧ f out = z) :
    SourceInputHasCrossingNativeHull Source xs ∧
    ((∃ (ys : Fin (L.funcArity G) → UA) (out : UA),
       out ∈ Left.func G ys ∧
       f ∘ xs = jL ∘ ys ∧ z = jL out) ∨
     (∃ (ys : Fin (L.funcArity G) → UB) (out : UB),
       out ∈ Right.func G ys ∧
       f ∘ xs = jR ∘ ys ∧ z = jR out)) := by
  have hMissing : z ∉ imageSet f (Source.func G xs) := by
    rintro ⟨out, hout, hValue⟩
    exact hNoLift ⟨xs, out, hout, rfl, hValue⟩
  have hUncovered :
      ¬ FunctionInputCoveredByFullIrreducibleTest Source G xs := by
    intro hCovered
    exact hMissing
      (ehn_localFunctionInputCover_liftsTargetOutput
        Source Target f hf G xs hCovered z hTarget)
  obtain ⟨d⟩ :=
    uncoveredFunctionInput_generatedClosedHull_decomposes
      Source G xs hUncovered
  have hCross :=
    generatedClosedHull_properFreeDecomposition_inputsCross
      Source xs d
  exact ⟨⟨d, hCross⟩,
    (hFree.func_iff G (f ∘ xs) z).mp hTarget⟩

end AllThoseRamseyClasses.Lifts
