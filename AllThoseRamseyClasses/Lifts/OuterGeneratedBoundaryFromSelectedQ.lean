import AllThoseRamseyClasses.Lifts.InsertedComponentOuterCutAttachment
import AllThoseRamseyClasses.Lifts.AllRetainedOuterComponentIff
import AllThoseRamseyClasses.Lifts.FullFreeAmalgamOuterGeneratedBoundaryCriterion

/-!
# Recover the ENTIRE old outer generated boundary from a selected Q

Consider two literal FULL native functional free amalgams sharing
exactly the same unchanged complement:
  Old = OldInner +_Root Complement,
  New = NewInner +_Root Complement.
The old T-cut lies in Complement and is closed. The inner root U
and the older outer cut T can be incomparable.

Assume the selected old private component is one true source
component, meets the old outer T-component C, and all surviving
common-root coordinates belong to C (as established by genuine
old geometric piece arguments). Also assume the OLD complete
generated external boundary is exactly T.

The new selected Q-private component has its internal full
generated boundary U (proved from a real selected geometric
witness by Track A's selected-Q chain). The inserted-component
theorem then constructs a genuine New minus T component C'
containing it, with ALL surviving U root vertices attached and
ALL U∩T root vertices generated by N(C').

The already verified ALL-retained-vertex iff transports every
old C vertex in the unchanged complement into C'. Finally the
verified full functional boundary criterion proves
  Cl_New(N_New(C')) = transported T.

This theorem discharges BOTH 'retained old interior' and
'new root boundary' assumptions of the old conditional
opposite-boundary criterion. Its remaining old-side geometry
hypotheses must be instantiated for an ACTUAL nested outer
geometric piece; no unrestricted Claim 2 is asserted.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}

/-- In an actual full native functional source replacement,
the COMPLETE old generated outer-root boundary survives once
the new selected Q-private component has its genuine internal
full-root boundary and the old selected component has the
explicit older-T attachment properties.

Neither retained-complement component membership nor the
new shared-root boundary contribution is assumed: BOTH are
derived from verified tuple-safe source geometry. -/
theorem fullFreeAmalgam_outerBoundary_from_selectedInnerBoundary
    {H E E' B W W' : Type v}
    {Root : Structure L H}
    {OldInner : Structure L E}
    {NewInner : Structure L E'}
    {Complement : Structure L B}
    {Old : Structure L W}
    {New : Structure L W'}
    {sOldInner : Structure.Embedding Root OldInner}
    {sNewInner : Structure.Embedding Root NewInner}
    {sComp : Structure.Embedding Root Complement}
    {iOldInner : Structure.Embedding OldInner Old}
    {iOldComp : Structure.Embedding Complement Old}
    {iNewInner : Structure.Embedding NewInner New}
    {iNewComp : Structure.Embedding Complement New}
    (hOld : Structure.IsFreeAmalgam
      sOldInner sComp iOldInner iOldComp)
    (hNew : Structure.IsFreeAmalgam
      sNewInner sComp iNewInner iNewComp)
    (T : Set B) (hTclosed : Complement.IsClosed T)
    (dOld : {w : W // w ∉ iOldComp '' Set.range sComp})
    (hdOldInner : dOld.1 ∈ Set.range iOldInner)
    (hOldPrivateInD :
      ∀ e : E, e ∉ Set.range sOldInner →
        iOldInner e ∈ componentFrom Old.graph
          (iOldComp '' Set.range sComp) dOld)
    (xOld : {w : W // w ∉ iOldComp '' T})
    (hxOld :
      xOld.1 ∈ componentFrom Old.graph
        (iOldComp '' Set.range sComp) dOld)
    (hRootOld :
      ∀ r : H, sComp r ∉ T →
        iOldComp (sComp r) ∈
          componentFrom Old.graph (iOldComp '' T) xOld)
    (hOldBoundary :
      Old.functionClosure
        (gaifmanNeighborhood Old.graph
          (componentFrom Old.graph (iOldComp '' T) xOld)) =
        iOldComp '' T)
    (dNew : {e : E' // e ∉ Set.range sNewInner})
    (hNewInnerBoundary :
      NewInner.functionClosure
        (gaifmanNeighborhood NewInner.graph
          (componentFrom NewInner.graph
            (Set.range sNewInner) dNew)) =
        Set.range sNewInner) :
    ∃ xNew : {w : W' // w ∉ iNewComp '' T},
      xNew.1 = iNewInner dNew.1 ∧
      New.functionClosure
        (gaifmanNeighborhood New.graph
          (componentFrom New.graph (iNewComp '' T) xNew)) =
        iNewComp '' T := by
  obtain ⟨xNew, hxNew, _hInserted, hRootNew,
    hRootBoundary⟩ :=
    fullFreeAmalgam_insertedComponent_outerCut_attaches
      hNew T hTclosed dNew hNewInnerBoundary
  have hxNewInLeft : xNew.1 ∈ Set.range iNewInner :=
    ⟨dNew.1, hxNew.symm⟩
  have hRetained :
      ∀ b : B,
        iOldComp b ∈
          componentFrom Old.graph (iOldComp '' T) xOld →
        iNewComp b ∈
          componentFrom New.graph (iNewComp '' T) xNew := by
    intro b hbOld
    by_cases hbT : b ∈ T
    · have hbCut : iOldComp b ∈ iOldComp '' T :=
        ⟨b, hbT, rfl⟩
      exact False.elim
        ((Set.disjoint_left.mp
          (componentFrom_disjoint_cut
            Old.graph (iOldComp '' T) xOld))
          hbOld hbCut)
    · exact (fullFreeAmalgam_allRetainedOuterComponent_iff
        hOld hNew T dOld hdOldInner hOldPrivateInD
        xOld hxOld xNew hxNewInLeft hRootOld hRootNew
        b hbT).mp hbOld
  refine ⟨xNew, hxNew, ?_⟩
  exact fullFreeAmalgam_outerGeneratedBoundary_eq_of_retained_and_root
    hOld iNewComp T hTclosed xOld xNew
    hOldBoundary hRetained hRootBoundary

end AllThoseRamseyClasses.Lifts
