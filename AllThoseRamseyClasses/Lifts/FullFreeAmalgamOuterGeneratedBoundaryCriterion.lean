import AllThoseRamseyClasses.Lifts.FullFreeAmalgamPrivateBoundaryForward
import AllThoseRamseyClasses.Lifts.FullEmbeddingGeneratedClosure

/-!
# Exact generated old outer boundary after a literal full functional flip

Suppose an older outer T-component C in Old has the COMPLETE
function-generated external boundary `iComp[T]`. The old source
is a genuine full native amalgam of an inner piece and the
unchanged Complement. The same Complement embeds FULLY in New,
and T remains function-closed there.

Two independent assumptions are sufficient for reconstructing the
COMPLETE new outer boundary:

1. Every retained Complement vertex lying in old C belongs to
   the specified new T-component C'.
2. Each old outer-root vertex lying in the common INNER gluing
   root and in T already belongs to Cl_New(N_New(C')).

The other old boundary generators, private to the Complement,
are transported as actual New Gaifman neighbours by the
tuple-safe theorem in FullFreeAmalgamPrivateBoundaryForward.

The old root T is function-generated by the old external
neighbourhood N_Old(C). We prove that the preimage under the
new full Complement embedding of Cl_New(N_New(C')) is CLOSED
in Complement and contains every old boundary generator.
The old full complement embedding then transports this closed
set back into Old. Consequently it contains the entire old
generated root T. The reverse inclusion follows because the
new outer component avoids a function-closed transported T.

Unlike the earlier conditional old-root criterion, this result
DERIVES the new opposite generated-boundary equality under two
explicitly smaller component/root-attachment obligations. It
does not yet establish either obligation for arbitrary nested
2019 flips, nor the all-test rooted incompatibility profile.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}

/-- The COMPLETE opposite generated boundary of an old outer
geometric piece survives a native full functional replacement
provided retained component inclusion and the shared-root
boundary contribution are established separately.

No graph-induced reflection is assumed. Old private boundary
neighbours are transported via genuine tuple-safe full side
localization; function generation is moved by full embedding
closedness. No finiteness or source-target EHN injectivity. -/
theorem fullFreeAmalgam_outerGeneratedBoundary_eq_of_retained_and_root
    {H E B W W' : Type v}
    {Root : Structure L H}
    {Inner : Structure L E}
    {Complement : Structure L B}
    {Old : Structure L W}
    {New : Structure L W'}
    {sInner : Structure.Embedding Root Inner}
    {sComp : Structure.Embedding Root Complement}
    {iInner : Structure.Embedding Inner Old}
    {iComp : Structure.Embedding Complement Old}
    (hOld : Structure.IsFreeAmalgam sInner sComp iInner iComp)
    (jComp : Structure.Embedding Complement New)
    (T : Set B) (hTclosed : Complement.IsClosed T)
    (xOld : {w : W // w ∉ iComp '' T})
    (xNew : {w : W' // w ∉ jComp '' T})
    (hOldBoundary :
      Old.functionClosure
        (gaifmanNeighborhood Old.graph
          (componentFrom Old.graph (iComp '' T) xOld)) =
            iComp '' T)
    (hRetained :
      ∀ b : B,
        iComp b ∈ componentFrom Old.graph (iComp '' T) xOld →
        jComp b ∈ componentFrom New.graph (jComp '' T) xNew)
    (hRootBoundary :
      ∀ r : H, sComp r ∈ T →
        jComp (sComp r) ∈ New.functionClosure
          (gaifmanNeighborhood New.graph
            (componentFrom New.graph (jComp '' T) xNew))) :
    New.functionClosure
      (gaifmanNeighborhood New.graph
        (componentFrom New.graph (jComp '' T) xNew)) =
      jComp '' T := by
  let OldC : Set W := componentFrom Old.graph (iComp '' T) xOld
  let NewC : Set W' := componentFrom New.graph (jComp '' T) xNew
  let NewN : Set W' := gaifmanNeighborhood New.graph NewC
  let NewBoundary : Set W' := New.functionClosure NewN
  let K : Set B := jComp ⁻¹' NewBoundary
  have hKclosed : Complement.IsClosed K := by
    exact functionalEmbedding_preimage_closed
      Complement New jComp NewBoundary
        (New.functionClosure_isClosed NewN)
  have hOldKclosed : Old.IsClosed (iComp '' K) :=
    functionalEmbedding_image_closed
      Complement Old iComp K hKclosed
  have hOldSeeds :
      gaifmanNeighborhood Old.graph OldC ⊆ iComp '' K := by
    intro z hz
    have hzInCut : z ∈ iComp '' T :=
      gaifmanNeighborhood_component_subset_cut
        Old.graph (iComp '' T) xOld hz
    obtain ⟨t, htInT, htImage⟩ := hzInCut
    have htOldNeighbour :
        iComp t ∈ gaifmanNeighborhood Old.graph OldC := by
      rw [htImage]
      exact hz
    have htNewBoundary : jComp t ∈ NewBoundary := by
      by_cases htRoot : t ∈ Set.range sComp
      · obtain ⟨r, hr⟩ := htRoot
        have hrInT : sComp r ∈ T := by
          rw [hr]
          exact htInT
        rw [← hr]
        exact hRootBoundary r hrInT
      · have hNewNeighbour :
            jComp t ∈ gaifmanNeighborhood New.graph NewC :=
          fullFreeAmalgam_rightPrivateOldBoundary_neighbour_survives
            hOld jComp T xOld xNew hRetained
            t htInT htRoot htOldNeighbour
        exact New.subset_functionClosure NewN hNewNeighbour
    exact ⟨t, htNewBoundary, htImage⟩
  have hOldRootIncluded : iComp '' T ⊆ iComp '' K := by
    rw [← hOldBoundary]
    intro z hz
    exact hz (iComp '' K) hOldKclosed hOldSeeds
  have hTNewClosed : New.IsClosed (jComp '' T) :=
    functionalEmbedding_image_closed Complement New jComp T hTclosed
  have hUpper : NewBoundary ⊆ jComp '' T :=
    functionalClosure_neighborhood_subset_cut
      New (jComp '' T) hTNewClosed xNew
  have hLower : jComp '' T ⊆ NewBoundary := by
    rintro z ⟨t, htInT, rfl⟩
    have htOld : iComp t ∈ iComp '' T := ⟨t, htInT, rfl⟩
    obtain ⟨b, hbK, hbImage⟩ := hOldRootIncluded htOld
    have hEq : b = t := iComp.injective hbImage
    have htK : t ∈ K := by
      simpa only [hEq] using hbK
    exact htK
  exact Set.Subset.antisymm hUpper hLower

end AllThoseRamseyClasses.Lifts
