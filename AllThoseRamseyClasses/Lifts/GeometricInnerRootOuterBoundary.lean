import AllThoseRamseyClasses.Lifts.GeneratedSubcomponentBoundaryLocalization
import AllThoseRamseyClasses.Lifts.GeometricFunctionalPieces

/-!
# Localize every root of a genuine inner geometric piece at an older cut

Let U be the COMPLETE function-closed root of a genuine inner
geometric piece with selected component D, and T an arbitrary older
CLOSED cut, not necessarily nested with U. Suppose D lies in a
component C of the source after deleting T.

Two previously verified generic functional closure facts combine:

* every inner-root vertex outside T belongs to C; and
* every inner-root vertex inside T already belongs to the
  GENERATED external boundary Cl(N(C)).

The second assertion is not merely graph-adjacency. The selected
inner root U equals Cl(N(D)), and generated-subcomponent boundary
localization, proved independently in #745, shows that the T-part
of this generated root is already generated by N(C).

These are the exact two root cases needed for source geometry after
a nested functional flip. No root image is identified through a weak
EHN map; no assumption T subset U or U subset T is made.
The theorem does NOT claim that the complete old outer root T is
generated by the new component: that converse remains to be proved.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {V : Type v}

/-- The surviving portion U\\T of a geometric inner root belongs
to the T-component containing the inner piece's selected D. -/
theorem geometricInnerRoot_outsideOlderCut_inComponent
    (A : Structure L V) {n : ℕ}
    (d : GeometricFunctionalPieceData A n)
    (T : Set V) (hT : A.IsClosed T)
    (x : {v : V // v ∉ T})
    (hD :
      componentFrom A.graph (Set.range d.roots) d.left ⊆
        componentFrom A.graph T x) :
    Set.range d.roots \ T ⊆ componentFrom A.graph T x := by
  exact generatedInnerRoot_outsideClosedOuterCut_attaches
    A T hT x
    (componentFrom A.graph (Set.range d.roots) d.left)
    (Set.range d.roots) hD
    (geometricPiece_left_boundary_closure A d)

/-- The T-part of the COMPLETE inner root U is already in the
generated external boundary of the older T-component C.
This is the actual geometric-piece specialization of #745. -/
theorem geometricInnerRoot_insideOlderCut_generatedByOuterBoundary
    (A : Structure L V) {n : ℕ}
    (d : GeometricFunctionalPieceData A n)
    (T : Set V) (hT : A.IsClosed T)
    (x : {v : V // v ∉ T})
    (hD :
      componentFrom A.graph (Set.range d.roots) d.left ⊆
        componentFrom A.graph T x) :
    Set.range d.roots ∩ T ⊆
      A.functionClosure
        (gaifmanNeighborhood A.graph
          (componentFrom A.graph T x)) := by
  intro z hz
  have hzGenerated :
      z ∈ A.functionClosure
        (gaifmanNeighborhood A.graph
          (componentFrom A.graph (Set.range d.roots) d.left)) := by
    rw [geometricPiece_left_boundary_closure A d]
    exact hz.1
  exact generatedSubcomponentBoundary_inter_cut_subset_componentBoundary
    A T hT x
    (componentFrom A.graph (Set.range d.roots) d.left)
    hD z hzGenerated hz.2

/-- Every vertex of the inner generated root is either in the
surviving older outer component or in its generated external
boundary, depending on membership in T. This statement alone
does not give equality of the generated outer boundary with T. -/
theorem geometricInnerRoot_partition_acrossOlderClosedCut
    (A : Structure L V) {n : ℕ}
    (d : GeometricFunctionalPieceData A n)
    (T : Set V) (hT : A.IsClosed T)
    (x : {v : V // v ∉ T})
    (hD :
      componentFrom A.graph (Set.range d.roots) d.left ⊆
        componentFrom A.graph T x) :
    (Set.range d.roots \ T ⊆ componentFrom A.graph T x) ∧
      (Set.range d.roots ∩ T ⊆
        A.functionClosure
          (gaifmanNeighborhood A.graph
            (componentFrom A.graph T x))) := by
  exact ⟨
    geometricInnerRoot_outsideOlderCut_inComponent A d T hT x hD,
    geometricInnerRoot_insideOlderCut_generatedByOuterBoundary
      A d T hT x hD⟩

end AllThoseRamseyClasses.Lifts
