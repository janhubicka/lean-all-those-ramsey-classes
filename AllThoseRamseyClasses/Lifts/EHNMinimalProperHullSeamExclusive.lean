import AllThoseRamseyClasses.Lifts.EHNSeamHullExclusiveInput
import AllThoseRamseyClasses.Lifts.EHNFullSideMinimalObstruction

/-!
# Track D: exact support-minimal witness with a PROPER crossed source input hull

All of the following are ACTUAL original native functional objects:
* a finite forbidden source and its genuine EHN map into a full free
  amalgam with matching complete original common global canonical lift;
* a positive OLD relation or native function value in the target
  that has NO positive original source lift at ANY input preimage;
* a proper FULL native free decomposition of the original
  function-closed hull generated by source input coordinates.

The certified EHN side factorization plus F-freeness of target
sides ensures that a defect's input-generated source hull is
itself forbidden-free, hence STRICTLY smaller than the original
forbidden source. The seam/exclusive split then sharpens the
local obstruction in two ways:

(1) if all original source input coordinates map into the common
    FULL root seam, the whole original input hull EHN-factors
    into that root, and the actual positive old-language relation
    or native function-output incidence reflects to the OLD root;
(2) otherwise an ACTUAL source input generator maps into an
    exclusive left or right region of the genuine free amalgam.

Absent both defects, the verified printed-image-closure argument
constructs an injective support-minimal forbidden EHN witness
with its genuinely smallest MIXED geometric piece.

The resulting proper source hull is NOT a selected forbidden
minimal-separator geometric piece. The source outside vertex and
root incidence do NOT yet force a compatible-root forbidden
extension or a source-support-decreasing flip. Claim 2 and
unrestricted original Section 3 strong AP remain open.
-/

namespace AllThoseRamseyClasses.Lifts

open StructuralRamsey
open StructuralRamsey.Structure

universe u
variable {L : Language.{u}}

/-- An unliftable old-language relation in an ACTUAL full free amalgam
whose original input-generated hull is BOTH properly crossed by a
full native source free decomposition AND strictly smaller than the
whole original forbidden source.

Either the target incidence reflects into the full common OLD root
with an EHN factorization of the original generated source hull
into that root, or an original SOURCE input generator is exclusive.
The first branch does NOT assert an added canonical root relation. -/
def HasProperSeamOrExclusiveRelationDefect
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (f : V → UT) : Prop :=
  ∃ (R : L.RelSymbol) (xs : Fin (L.relArity R) → V),
    Target.rel R (f ∘ xs) ∧
    (¬ ∃ ys : Fin (L.relArity R) → V,
      Source.rel R ys ∧ f ∘ ys = f ∘ xs) ∧
    SourceInputHasCrossingNativeHull Source xs ∧
    (∃ v : V, v ∉ Source.functionClosure (Set.range xs)) ∧
    ((∃ (args : Fin (L.relArity R) → UX),
        Root.rel R args ∧
        f ∘ xs = (jL.comp sL) ∘ args ∧
        ∃ q : Source.functionClosure (Set.range xs) → UX,
          (Source.induce (Source.functionClosure (Set.range xs))
            (Source.functionClosure_isClosed (Set.range xs))).IsEHNHomomorphismEmbedding Root q ∧
          ∀ v : Source.functionClosure (Set.range xs),
            (jL.comp sL) (q v) = f v.1) ∨
     (∃ i : Fin (L.relArity R),
        xs i ∈ weakFreeLeftPart (sL := sL) (iL := jL) f ∨
        xs i ∈ weakFreeRightPart
          (sL := sL) (iL := jL) (iR := jR) f))

/-- The fully analogous ACTUAL target function-incidence defect.
There is no positive original native output incidence lifting the
target value at ANY matching input tuple, even with source collisions.
When seam-only, the exact root-native operation itself is positive:
the positive target value cannot escape the function-closed root. -/
def HasProperSeamOrExclusiveFunctionDefect
    {V UX UA UB UT : Type}
    (Source : Structure L V)
    (Root : Structure L UX)
    (Left : Structure L UA) (Right : Structure L UB)
    (Target : Structure L UT)
    (sL : Structure.Embedding Root Left)
    (jL : Structure.Embedding Left Target)
    (jR : Structure.Embedding Right Target)
    (f : V → UT) : Prop :=
  ∃ (G : L.FuncSymbol)
      (xs : Fin (L.funcArity G) → V) (z : UT),
    z ∈ Target.func G (f ∘ xs) ∧
    (¬ ∃ (ys : Fin (L.funcArity G) → V) (out : V),
      out ∈ Source.func G ys ∧
      f ∘ ys = f ∘ xs ∧ f out = z) ∧
    SourceInputHasCrossingNativeHull Source xs ∧
    (∃ v : V, v ∉ Source.functionClosure (Set.range xs)) ∧
    ((∃ (args : Fin (L.funcArity G) → UX) (out : UX),
        out ∈ Root.func G args ∧
        f ∘ xs = (jL.comp sL) ∘ args ∧
        z = (jL.comp sL) out ∧
        ∃ q : Source.functionClosure (Set.range xs) → UX,
          (Source.induce (Source.functionClosure (Set.range xs))
            (Source.functionClosure_isClosed (Set.range xs))).IsEHNHomomorphismEmbedding Root q ∧
          ∀ v : Source.functionClosure (Set.range xs),
            (jL.comp sL) (q v) = f v.1) ∨
     (∃ i : Fin (L.funcArity G),
        xs i ∈ weakFreeLeftPart (sL := sL) (iL := jL) f ∨
        xs i ∈ weakFreeRightPart
          (sL := sL) (iL := jL) (iR := jR) f))

/-- A connected native source's Gaifman graph has an ACTUAL
positive edge across EVERY nonempty proper vertex subset. The
edge is witnessed by a positive old relation or complete native
function-input/output incidence in the relationalized graph.

The proof uses actual finite Gaifman paths, not an arbitrary
quotient or an unproved forbidden-piece flip. Neither function
closure nor source finiteness is needed here. -/
theorem connectedNativeGaifman_has_boundaryEdge
    {V : Type}
    (Source : Structure L V)
    (S : Set V)
    (hConnected :
      ∀ x y : V,
        Relation.ReflTransGen (GaifmanAdjacent Source.graph) x y)
    {x y : V}
    (hx : x ∈ S)
    (hy : y ∉ S) :
    ∃ (a b : V),
      a ∈ S ∧ b ∉ S ∧ GaifmanAdjacent Source.graph a b := by
  classical
  by_contra hNoEdge
  have hStep :
      ∀ a b : V,
        a ∈ S → GaifmanAdjacent Source.graph a b → b ∈ S := by
    intro a b ha hab
    by_contra hb
    exact hNoEdge ⟨a, b, ha, hb, hab⟩
  have hReach : ∀ z : V,
      Relation.ReflTransGen (GaifmanAdjacent Source.graph) x z →
      z ∈ S := by
    intro z hPath
    induction hPath with
    | refl => exact hx
    | @tail a b _hab hedge ih =>
        exact hStep a b ih hedge
  exact hy (hReach y (hConnected x y))

/-- A globally forbidden, finite, Gaifman-connected native source
with an ACTUAL proper crossed function-closed input-generated hull
has a POSITIVE Gaifman edge crossing exactly that hull boundary.

The crossing full source-hull decomposition guarantees an ACTUAL
input generator, so the hull is not empty. Forbiddenness and
connectedness then give a path to an actual outside source
vertex; the first boundary crossing supplies the required
positive old-language/native-function incidence.

This does NOT identify a selected minimal closed separator
geometric forbidden piece; it supplies the literal native
boundary incidence needed to attempt such a construction. -/
theorem connectedForbidden_crossedProperInputHull_hasBoundaryEdge
    (F : ∀ {W : Type}, Structure L W → Prop)
    (hConnected : GlobalForbiddenSourcesConnectedNonempty F)
    {V X : Type}
    (Source : Structure L V)
    (hFinite : Finite V)
    (hForbidden : F Source)
    (xs : X → V)
    (hCross : SourceInputHasCrossingNativeHull Source xs)
    (hOutside :
      ∃ v : V, v ∉ Source.functionClosure (Set.range xs)) :
    ∃ (a b : V),
      a ∈ Source.functionClosure (Set.range xs) ∧
      b ∉ Source.functionClosure (Set.range xs) ∧
      GaifmanAdjacent Source.graph a b := by
  classical
  obtain ⟨dec, hNotAllLeft, _hNotAllRight⟩ := hCross
  have hInputsNonempty : Nonempty X := by
    by_contra hEmpty
    apply hNotAllLeft
    intro i
    exact False.elim (hEmpty ⟨i⟩)
  obtain ⟨i⟩ := hInputsNonempty
  have hSeedInHull :
      xs i ∈ Source.functionClosure (Set.range xs) :=
    Source.subset_functionClosure (Set.range xs) ⟨i, rfl⟩
  obtain ⟨outside, hOutside⟩ := hOutside
  exact connectedNativeGaifman_has_boundaryEdge
    Source (Source.functionClosure (Set.range xs))
    (hConnected Source hFinite hForbidden).2 hSeedInHull hOutside

/-- The source-matched three-way reduction under the actual original
2019 printed tuple-surjective forbidden-image closure.

Given the genuine FULL native free amalgam of F-free structures
carrying one common FULL original global canonical lift, and
assuming there exists any forbidden EHN weak witness, choose one
minimizing the ORIGINAL SOURCE left-exclusive support. Then:

* a globally unliftable positive NATIVE function incidence has
  a proper crossed old-source hull and either a genuine positive
  OLD root function incidence with an EHN hull factorization,
  or an ACTUAL exclusive original source input generator; OR
* a globally unliftable positive OLD relation has the analogous
  proper crossed hull and positive root relation / exclusive input; OR
* there is an injective source-support-minimal forbidden EHN witness
  with its genuinely smallest MIXED forbidden geometric piece.

No input-test covers or root-image injection are added as hypotheses.
The strict SOURCE hull properness is derived from both target sides
being Forb_EHN(F). None of the alternatives is contradicted yet;
the result is an exact new Track D → Track C proof-control interface,
not an unconditional strong amalgamation proof. -/
theorem exists_minimalForbiddenWitness_properSeamOrExclusiveInput_or_mixedPiece
    (F : ∀ {W : Type}, Structure L W → Prop)
    (hFiniteF : ∀ {W : Type} (A : Structure L W),
      F A → Finite W)
    (hConnected : GlobalForbiddenSourcesConnectedNonempty F)
    (hImage : HasTupleSurjectiveForbiddenImageClosure F)
    {UX UA UB UT : Type}
    (Target : Structure L UT)
    (Left : Structure L UA) (Right : Structure L UB)
    (jLeft : Structure.Embedding Left Target)
    (jRight : Structure.Embedding Right Target)
    (X : Structure L UX)
    (iLeft : Structure.Embedding X Left)
    (iRight : Structure.Embedding X Right)
    (hTargetFree : Structure.IsFreeAmalgam iLeft iRight jLeft jRight)
    (hCommon : CommonGlobalCanonicalLift F X Left Right iLeft iRight)
    (hAvoidLeft : AvoidsGlobalFunctionalEHN F Left)
    (hAvoidRight : AvoidsGlobalFunctionalEHN F Right)
    (hExists : Nonempty (ForbiddenEHNWitness F Target)) :
    ∃ (w : ForbiddenEHNWitness F Target),
      (∀ t : ForbiddenEHNWitness F Target,
        w.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft) ≤
          t.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft)) ∧
      (HasProperSeamOrExclusiveFunctionDefect
          w.source X Left Right Target iLeft jLeft jRight w.toTarget ∨
       HasProperSeamOrExclusiveRelationDefect
          w.source X Left Right Target iLeft jLeft jRight w.toTarget ∨
       ∃ (v : ForbiddenEHNWitness F Target),
         Function.Injective v.toTarget ∧
         (∀ t : ForbiddenEHNWitness F Target,
           v.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft) ≤
             t.sourceSupportCount (fullFreeLeftExclusiveTarget iLeft jLeft)) ∧
         ∃ P : MixedGeometricPiece v.source
           (weakFreeRootPart (sL := iLeft) (iL := jLeft) v.toTarget)
           (weakFreeLeftPart (sL := iLeft) (iL := jLeft) v.toTarget)
           (weakFreeRightPart
             (sL := iLeft) (iL := jLeft) (iR := jRight) v.toTarget),
           ∀ Q : MixedGeometricPiece v.source
             (weakFreeRootPart (sL := iLeft) (iL := jLeft) v.toTarget)
             (weakFreeLeftPart (sL := iLeft) (iL := jLeft) v.toTarget)
             (weakFreeRightPart
               (sL := iLeft) (iL := jLeft) (iR := jRight) v.toTarget),
             P.nonrootCount ≤ Q.nonrootCount) := by
  obtain ⟨w, hMin, hCases⟩ :=
    exists_minimalForbiddenWitness_fullyUnliftableSideIncidence_or_mixedPiece
      F hFiniteF hConnected hImage
      Target Left Right jLeft jRight X iLeft iRight
      hTargetFree hCommon hAvoidLeft hAvoidRight hExists
  refine ⟨w, hMin, ?_⟩
  rcases hCases with hFunction | hRelation | hMixed
  · obtain ⟨G, xs, z, hPositive, hNoLift, _hEmpty, _hCross, _hSide⟩ :=
      hFunction
    obtain ⟨hCross, hOutside⟩ :=
      ehn_unliftableFunction_crossedHull_isProperInForbiddenSource
        F w.source w.finiteCarrier w.forbidden
        X Left Right Target iLeft iRight jLeft jRight
        hTargetFree hAvoidLeft hAvoidRight
        w.toTarget w.homEmbedding G xs z hPositive hNoLift
    obtain ⟨_hCross2, hWhere⟩ :=
      ehn_unliftableFunction_commonSeamHullOrExclusiveInput
        w.source X Left Right Target iLeft iRight jLeft jRight
        hTargetFree w.toTarget w.homEmbedding G xs z hPositive hNoLift
    rcases hWhere with ⟨_hOutputRoot, hRoot, q, hq, hCoords⟩ | hExclusive
    · obtain ⟨args, out, hRootPositive, hArgs, hOut⟩ :=
        fullNativeRoot_reflects_functionValue_at_seamInputs
          X Target (jLeft.comp iLeft) w.toTarget
          G xs z hRoot hPositive
      exact Or.inl ⟨G, xs, z, hPositive, hNoLift, hCross,
        hOutside, Or.inl
          ⟨args, out, hRootPositive, hArgs, hOut, q, hq, hCoords⟩⟩
    · exact Or.inl ⟨G, xs, z, hPositive, hNoLift,
        hCross, hOutside, Or.inr hExclusive⟩
  · obtain ⟨R, xs, hPositive, hNoLift, _hCross, _hSide⟩ :=
      hRelation
    obtain ⟨hCross, hOutside⟩ :=
      ehn_unliftableRelation_crossedHull_isProperInForbiddenSource
        F w.source w.finiteCarrier w.forbidden
        X Left Right Target iLeft iRight jLeft jRight
        hTargetFree hAvoidLeft hAvoidRight
        w.toTarget w.homEmbedding R xs hPositive hNoLift
    obtain ⟨_hCross2, hWhere⟩ :=
      ehn_unliftableRelation_commonSeamHullOrExclusiveInput
        w.source X Left Right Target iLeft iRight jLeft jRight
        hTargetFree w.toTarget w.homEmbedding R xs hPositive hNoLift
    rcases hWhere with ⟨hRoot, q, hq, hCoords⟩ | hExclusive
    · obtain ⟨args, hRootPositive, hArgs⟩ :=
        fullNativeRoot_reflects_oldRelation_at_seamInputs
          X Target (jLeft.comp iLeft) w.toTarget R xs
          hRoot hPositive
      exact Or.inr (Or.inl ⟨R, xs, hPositive, hNoLift,
        hCross, hOutside, Or.inl
          ⟨args, hRootPositive, hArgs, q, hq, hCoords⟩⟩)
    · exact Or.inr (Or.inl
        ⟨R, xs, hPositive, hNoLift,
          hCross, hOutside, Or.inr hExclusive⟩)
  · exact Or.inr (Or.inr hMixed)

end AllThoseRamseyClasses.Lifts
