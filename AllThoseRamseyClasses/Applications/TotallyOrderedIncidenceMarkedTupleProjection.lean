import AllThoseRamseyClasses.Applications.TotallyOrderedIncidenceMarkedOriginalPart

/-!
# Exact tuple-order reflection from marked incidence closures

The original positive r-tuple t has a unique new incidence vertex
[r,t]. Its singleton-valued closure F_r(t) DEFINES the tag in the
functional language. Thus an arbitrary full embedding of SORT-MARKED
incidence lifts maps [r,t] to [r,f∘t], where f is the original
vertex map extracted from the Old predicate, even if the lift
embedding was not canonical.

The marked lift also carries the global ordering of new tags
by (relation symbol, positive tuple order). Consequently a full
lift embedding reflects the original tuple order whenever both
tuples are positive. Under the necessary manuscript support axiom
("tuple order comparisons imply positive tuples"), the statement
extends to ALL input tuples. Together with previous original
relations and vertex-order reflection, this recovers the exact
full embedding of the original totally ordered relational data.

The final class-level Ramsey property still requires actual
well-formed linear-order axioms, functional closed heredity,
strong amalgamation and exact local completion. This module
asserts none of those.
-/

namespace AllThoseRamseyClasses.Applications.TotallyOrderedIncidence

open StructuralRamsey
open StructuralRamsey.Structure
open AllThoseRamseyClasses.Applications.TotallyOrderedEncoding

universe u v w

/-- The unique incidence vertex generated by a positive tuple. -/
def positiveTag
    {L : RelLanguage.{u}} {V : Type v}
    (A : TotalOrderData L V) (r : L.Symbol)
    (t : Fin (L.arity r) → V) (ht : A.base.rel r t) :
    IncidenceCarrier A :=
  .inr ⟨r, ⟨t, ht⟩⟩

/-- Every full marked incidence embedding transports each positive
tuple's unique incidence vertex to the corresponding target tag.
This uses the full ONTO equality of set-valued function fibres. -/
theorem markedEmbedding_positiveTag_map
    {L : RelLanguage.{u}} [LinearOrder L.Symbol]
    {U : Type v} {V : Type w}
    (A : TotalOrderData L U) (B : TotalOrderData L V)
    (e : Structure.Embedding (markedIncidencePaperStructure A)
      (markedIncidencePaperStructure B))
    (r : L.Symbol) (t : Fin (L.arity r) → U)
    (ht : A.base.rel r t) :
    e (positiveTag A r t ht) =
      positiveTag B r
        (markedEmbedding_originalPart A B e ∘ t)
        ((markedEmbedding_originalRel_iff A B e r t).mpr ht) := by
  let f := markedEmbedding_originalPart A B e
  have hmem : positiveTag A r t ht ∈
      fullIncidenceFibre A r (fun i => .inl (t i)) := by
    rw [fullIncidenceFibre_old A r t]
    change some (positiveTag A r t ht) = incidenceValue A r t
    simp [positiveTag, incidenceValue, ht]
  have himage : e (positiveTag A r t ht) ∈
      e '' fullIncidenceFibre A r (fun i => .inl (t i)) :=
    ⟨positiveTag A r t ht, hmem, rfl⟩
  have hfibre := e.map_func r
    (fun i => (Sum.inl (t i) : IncidenceCarrier A))
  change e '' fullIncidenceFibre A r (fun i => .inl (t i)) =
    fullIncidenceFibre B r
      (e ∘ (fun i => (Sum.inl (t i) : IncidenceCarrier A))) at hfibre
  rw [hfibre] at himage
  have htuple : e ∘ (fun i => (Sum.inl (t i) : IncidenceCarrier A)) =
      (fun i => (Sum.inl (f (t i)) : IncidenceCarrier B)) := by
    funext i
    exact markedEmbedding_originalPart_spec A B e (t i)
  rw [htuple] at himage
  change e (positiveTag A r t ht) ∈
    fullIncidenceFibre B r
      (fun i => (Sum.inl ((f ∘ t) i) : IncidenceCarrier B)) at himage
  rw [fullIncidenceFibre_old B r (f ∘ t)] at himage
  change some (e (positiveTag A r t ht)) =
    incidenceValue B r (f ∘ t) at himage
  have htB : B.base.rel r (f ∘ t) :=
    (markedEmbedding_originalRel_iff A B e r t).mpr ht
  have hv : incidenceValue B r (f ∘ t) =
      some (positiveTag B r (f ∘ t) htB) := by
    simp [incidenceValue, positiveTag, htB]
  rw [hv] at himage
  exact Option.some.inj himage

/-- The paper's old/new order comparison on two positive r-tags
is precisely the underlying positive-tuple comparison. -/
theorem paperIncidenceLE_positiveTags_iff
    {L : RelLanguage.{u}} [LinearOrder L.Symbol]
    {V : Type v}
    (A : TotalOrderData L V) (r : L.Symbol)
    (t s : Fin (L.arity r) → V)
    (ht : A.base.rel r t) (hs : A.base.rel r s) :
    paperIncidenceLE A (positiveTag A r t ht)
      (positiveTag A r s hs) ↔
    A.tupleLE r t s := by
  classical
  have hc : ∀ h : r = r,
      cast (congrArg
        (fun z : L.Symbol => Fin (L.arity z) → V) h.symm) s = s := by
    intro h
    cases h
    rfl
  simpa [positiveTag, paperIncidenceLE, paperIncidenceTagLE, hc]

/-- For positive tuples, reflection of the entire ordered
incidence language yields exact original per-relation tuple
order reflection. -/
theorem markedEmbedding_positiveTupleLE_iff
    {L : RelLanguage.{u}} [LinearOrder L.Symbol]
    {U : Type v} {V : Type w}
    (A : TotalOrderData L U) (B : TotalOrderData L V)
    (e : Structure.Embedding (markedIncidencePaperStructure A)
      (markedIncidencePaperStructure B))
    (r : L.Symbol) (t s : Fin (L.arity r) → U)
    (ht : A.base.rel r t) (hs : A.base.rel r s) :
    B.tupleLE r (markedEmbedding_originalPart A B e ∘ t)
      (markedEmbedding_originalPart A B e ∘ s) ↔
    A.tupleLE r t s := by
  let f := markedEmbedding_originalPart A B e
  have htB : B.base.rel r (f ∘ t) :=
    (markedEmbedding_originalRel_iff A B e r t).mpr ht
  have hsB : B.base.rel r (f ∘ s) :=
    (markedEmbedding_originalRel_iff A B e r s).mpr hs
  have hor := e.map_rel_iff (.paper .order)
    ![positiveTag A r t ht, positiveTag A r s hs]
  change paperIncidenceLE B (e (positiveTag A r t ht))
      (e (positiveTag A r s hs)) ↔
    paperIncidenceLE A (positiveTag A r t ht)
      (positiveTag A r s hs) at hor
  rw [markedEmbedding_positiveTag_map A B e r t ht,
      markedEmbedding_positiveTag_map A B e r s hs] at hor
  exact ((paperIncidenceLE_positiveTags_iff B r (f ∘ t)
      (f ∘ s) htB hsB).symm.trans hor).trans
    (paperIncidenceLE_positiveTags_iff A r t s ht hs)

/-- A tuple comparison must be supported on positive tuples.
This is an essential semantic axiom of the paper's orders on
relation instances, not a consequence of arbitrary TotalOrderData. -/
def TupleOrdersSupported
    {L : RelLanguage.{u}} {V : Type v}
    (A : TotalOrderData L V) : Prop :=
  ∀ (r : L.Symbol) (t s : Fin (L.arity r) → V),
    A.tupleLE r t s →
      A.base.rel r t ∧ A.base.rel r s

/-- With support on both sides, the tuple-order relation is
reflected for ALL original input tuples, not just positive
pairs that generate incidence vertices. -/
theorem markedEmbedding_tupleLE_iff
    {L : RelLanguage.{u}} [LinearOrder L.Symbol]
    {U : Type v} {V : Type w}
    (A : TotalOrderData L U) (B : TotalOrderData L V)
    (e : Structure.Embedding (markedIncidencePaperStructure A)
      (markedIncidencePaperStructure B))
    (hA : TupleOrdersSupported A) (hB : TupleOrdersSupported B)
    (r : L.Symbol) (t s : Fin (L.arity r) → U) :
    B.tupleLE r (markedEmbedding_originalPart A B e ∘ t)
      (markedEmbedding_originalPart A B e ∘ s) ↔
    A.tupleLE r t s := by
  have href (q : Fin (L.arity r) → U) :=
    markedEmbedding_originalRel_iff A B e r q
  constructor
  · intro h
    obtain ⟨htB, hsB⟩ := hB r _ _ h
    have htA : A.base.rel r t := (href t).mp htB
    have hsA : A.base.rel r s := (href s).mp hsB
    exact (markedEmbedding_positiveTupleLE_iff A B e r t s htA hsA).mp h
  · intro h
    obtain ⟨htA, hsA⟩ := hA r t s h
    exact (markedEmbedding_positiveTupleLE_iff A B e r t s htA hsA).mpr h

/-- Recover the EXACT original totally ordered relational embedding
from any full embedding of the sort-marked auxiliary incidence
structures, provided their tuple comparisons are supported.
This establishes the requisite reverse copy-projection direction. -/
theorem markedEmbedding_originalExact
    {L : RelLanguage.{u}} [LinearOrder L.Symbol]
    {U : Type v} {V : Type w}
    (A : TotalOrderData L U) (B : TotalOrderData L V)
    (e : Structure.Embedding (markedIncidencePaperStructure A)
      (markedIncidencePaperStructure B))
    (hA : TupleOrdersSupported A) (hB : TupleOrdersSupported B) :
    IsExactEmbedding A B (markedEmbedding_originalPart A B e) := by
  refine ⟨markedEmbedding_originalPart_injective A B e, ?_, ?_, ?_⟩
  · intro r t
    exact markedEmbedding_originalRel_iff A B e r t
  · intro x y
    exact markedEmbedding_vertexLE_iff A B e x y
  · intro r t s
    exact markedEmbedding_tupleLE_iff A B e hA hB r t s

end AllThoseRamseyClasses.Applications.TotallyOrderedIncidence
