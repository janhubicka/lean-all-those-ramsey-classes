import AllThoseRamseyClasses.Applications.MetricJumpClosureComposition

/-!
# Algebraic one-step closure in a weak partial-function candidate

For an arbitrary source set A with Option-valued functions F_j,
define the direct orbit of x: x itself and every defined F_j(x)
for a specified set of allowed levels J.

If the *source functions themselves* satisfy the two-step normal
form, then this orbit is ALREADY CLOSED under every F_k (k in J).
The proof assumes neither a source metric nor any globally
injective completion map. Any function-closed subset containing
x consequently contains this whole direct orbit.

The composition identity is not assumed to hold in arbitrary
weak candidates by default. The separate locally tested
composition theorem supplies exactly that identity whenever
its genuine four-point completion hypotheses have been verified.

These facts are the algebraic bridge needed for the printed
local-completion size argument; cardinality of the direct orbit,
and derivation of the local tests from the paper's weak induced
substructure quantifiers, are separate obligations.
-/

namespace AllThoseRamseyClasses.Applications.MetricSaturation

universe u

/-- One seed and all its defined direct F_j-values.
This definition is valid even for a weak candidate with no metric. -/
def metricCandidateDirectOrbit
    {A : Type u} (J : Set ℝ)
    (f : ℝ → A → Option A) (x : A) : Set A :=
  {y | y = x ∨ ∃ j : ℝ, j ∈ J ∧ f j x = some y}

/-- The seed belongs to its own direct orbit. -/
theorem metricCandidateDirectOrbit_self
    {A : Type u} (J : Set ℝ)
    (f : ℝ → A → Option A) (x : A) :
    x ∈ metricCandidateDirectOrbit J f x := by
  exact Or.inl rfl

/-- Each defined direct F_j-value belongs to the orbit. -/
theorem metricCandidateDirectOrbit_of_some
    {A : Type u} (J : Set ℝ)
    (f : ℝ → A → Option A)
    (x y : A) (j : ℝ) (hj : j ∈ J)
    (hxy : f j x = some y) :
    y ∈ metricCandidateDirectOrbit J f x := by
  exact Or.inr ⟨j, hj, hxy⟩

/-- Only the TWO-STEP COMPOSITION NORMAL FORM on the candidate
is needed for the orbit to be function-closed. No assumption
on metric distances, order, finiteness, or target maps occurs. -/
theorem metricCandidateDirectOrbit_closed_of_normalform
    {A : Type u} (J : Set ℝ)
    (f : ℝ → A → Option A)
    (hNormal : ∀ j ∈ J, ∀ k ∈ J,
      ∀ x y z : A, f j x = some y → f k y = some z →
        f k x = some z)
    (x y z : A)
    (hy : y ∈ metricCandidateDirectOrbit J f x)
    (k : ℝ) (hk : k ∈ J)
    (hky : f k y = some z) :
    z ∈ metricCandidateDirectOrbit J f x := by
  rcases hy with hRoot | ⟨j, hj, hxy⟩
  · subst y
    exact metricCandidateDirectOrbit_of_some J f x z k hk hky
  · exact metricCandidateDirectOrbit_of_some J f x z k hk
      (hNormal j hj k hk x y z hxy hky)

/-- Regardless of any normal form, EVERY set closed under
the specified candidate functions and containing x also
contains the entire direct orbit of x. -/
theorem metricCandidateDirectOrbit_subset_closed
    {A : Type u} (J : Set ℝ)
    (f : ℝ → A → Option A)
    (C : Set A) (x : A) (hx : x ∈ C)
    (hClosed : ∀ j ∈ J, ∀ y ∈ C, ∀ z : A,
      f j y = some z → z ∈ C) :
    metricCandidateDirectOrbit J f x ⊆ C := by
  intro y hy
  rcases hy with hRoot | ⟨j, hj, hxy⟩
  · subst y
    exact hx
  · exact hClosed j hj x hx y hxy

/-- A source satisfying the normal form has a LEAST J-closed
set generated by x, and that set consists of direct values only.
This is a full algebraic statement about weak functions; it does
not claim the normal form or the needed local tests are automatic. -/
theorem metricCandidateDirectOrbit_least_closed_of_normalform
    {A : Type u} (J : Set ℝ)
    (f : ℝ → A → Option A)
    (hNormal : ∀ j ∈ J, ∀ k ∈ J,
      ∀ x y z : A, f j x = some y → f k y = some z →
        f k x = some z)
    (x : A) :
    x ∈ metricCandidateDirectOrbit J f x ∧
    (∀ j ∈ J, ∀ y ∈ metricCandidateDirectOrbit J f x,
      ∀ z : A, f j y = some z →
        z ∈ metricCandidateDirectOrbit J f x) ∧
    (∀ C : Set A, x ∈ C →
      (∀ j ∈ J, ∀ y ∈ C, ∀ z : A,
        f j y = some z → z ∈ C) →
      metricCandidateDirectOrbit J f x ⊆ C) := by
  refine ⟨metricCandidateDirectOrbit_self J f x, ?_, ?_⟩
  · intro j hj y hy z h
    exact metricCandidateDirectOrbit_closed_of_normalform
      J f hNormal x y z hy j hj h
  · intro C hx hClosed
    exact metricCandidateDirectOrbit_subset_closed
      J f C x hx hClosed

end AllThoseRamseyClasses.Applications.MetricSaturation
