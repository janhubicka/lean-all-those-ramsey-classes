import AllThoseRamseyClasses.Applications.MetricFiniteJumpEnumeration
import AllThoseRamseyClasses.Applications.MetricLocalClosureCoherence
import Mathlib.Data.Finset.Card
import Mathlib.Tactic

/-!
# Four-point local test support versus the printed metric cutoff

For a finite S with at least one proper jump j, the printed
numerical candidate cutoff is

  n(S) = 2 |S| (|J_S|+1).

The actual LOCAL functional coherence support for a pair
(a,b) has only four old vertices, before any additional
functional closure:

  a, b, rep_j(a), rep_j(b).

We prove precisely that this raw support has cardinal <= 4
and that n(S) >= 4 whenever a proper jump exists.

The crucial distinction is intentionally part of the theorem
documentation: a raw four-point set need NOT be U-closed or
function-closed. This elementary inequality therefore does
not by itself validate the paper's exact local-completion
hypothesis or the cardinality of a closed hull.
-/

namespace AllThoseRamseyClasses.Applications.MetricSaturation

universe u

/-- The literal numerical cutoff advertised in the printed
finite S-metric local-completion argument. -/
noncomputable def metricPrintedLocalCutoff
    (S : Set ℝ) (hfin : S.Finite) : ℕ :=
  2 * (hfin.toFinset.card) *
    ((finiteJumpThresholdList S hfin).length + 1)

/-- At most four original candidate vertices are needed
to test equality of two F_j closure representatives. -/
theorem metricFourPointRawSupport_card_le_four
    {A : Type u}
    (fA : A → Option A) (a b : A) :
    ({a, b, metricClosureRepresentative fA a,
       metricClosureRepresentative fA b} : Finset A).card ≤ 4 := by
  classical
  exact Finset.card_le_four

/-- A genuine proper jump of finite S witnesses at least
two DISTINCT allowed distances: j itself and something
strictly larger. -/
theorem metricFiniteS_card_two_of_proper_jump
    {S : Set ℝ} (hfin : S.Finite)
    {j : ℝ} (hj : Jump S j) :
    2 ≤ hfin.toFinset.card := by
  classical
  obtain ⟨b, hbS, hjb⟩ := hj.2.1
  have hjMem : j ∈ hfin.toFinset :=
    hfin.mem_toFinset.mpr hj.1
  have hbMem : b ∈ hfin.toFinset :=
    hfin.mem_toFinset.mpr hbS
  have hSub : ({j, b} : Finset ℝ) ⊆ hfin.toFinset := by
    intro t ht
    simp only [Finset.mem_insert, Finset.mem_singleton] at ht
    rcases ht with rfl | rfl
    · exact hjMem
    · exact hbMem
  have hCard := Finset.card_le_card hSub
  simpa [ne_of_lt hjb] using hCard

/-- The printed cutoff always accommodates the RAW four-point
test whenever the S-metric language has a proper jump.
This is NOT a statement about the possibly larger U-closed
substructure generated by those four vertices. -/
theorem metricPrintedLocalCutoff_ge_four_of_jump
    (S : Set ℝ) (hfin : S.Finite)
    {j : ℝ} (hj : Jump S j) :
    4 ≤ metricPrintedLocalCutoff S hfin := by
  have hTwo : 2 ≤ hfin.toFinset.card :=
    metricFiniteS_card_two_of_proper_jump hfin hj
  have hOne : 1 ≤
      (finiteJumpThresholdList S hfin).length + 1 := by omega
  have hMul :=
    Nat.mul_le_mul_left
      (2 * hfin.toFinset.card) hOne
  unfold metricPrintedLocalCutoff
  calc
    4 ≤ 2 * hfin.toFinset.card := by omega
    _ ≤ 2 * hfin.toFinset.card *
          ((finiteJumpThresholdList S hfin).length + 1) := by
        simpa using hMul

/-- The unclosed functional FOUR-POINT set fits inside
the numerical source cutoff. No closed-hull cardinal
bound or local completion is asserted here. -/
theorem metricFourPointRawSupport_card_le_printedCutoff
    {A : Type u}
    (S : Set ℝ) (hfin : S.Finite)
    (fA : A → Option A) (a b : A)
    {j : ℝ} (hj : Jump S j) :
    ({a, b, metricClosureRepresentative fA a,
       metricClosureRepresentative fA b} : Finset A).card ≤
      metricPrintedLocalCutoff S hfin := by
  exact (metricFourPointRawSupport_card_le_four fA a b).trans
    (metricPrintedLocalCutoff_ge_four_of_jump S hfin hj)

end AllThoseRamseyClasses.Applications.MetricSaturation
