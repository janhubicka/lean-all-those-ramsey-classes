import AllThoseRamseyClasses.Applications.TotallyOrderedIncidenceTwoWayCoordinates
import PartiteConstruction.Structure.FreeAmalgam

/-!
# Recoverable incidence coordinates and collision-free positive tags

A one-way incidence lift can collapse two distinct positive relation tuples
onto the same new tag in an auxiliary Ramsey witness. The freely ordered
auxiliary incidence-law Ramsey theorem alone does not prevent this: hence
ordering positive tuples by their output tag need not give a LINEAR order.

The two-way lift uses unary reverse-coordinate operations G_(r,i). This
module isolates the key invariant: whenever a positive original r-tuple t
has forward output z, its entire i-th reverse fibre is EXACTLY {t_i}.
We prove this invariant for canonical two-way incidence lifts, reflection
under arbitrary FULL functional embeddings, and preservation by genuine
FULL functional free amalgamation.

Consequently two positive tuples with a common forward output must be
EQUAL. This prevents precisely the tag-collision failure in the proposed
copy-forgetting Ramsey transfer, without imposing the false restriction
that every orphan tag is generated by a positive tuple.

The class-level Ramsey statement is not asserted here. In particular,
global unary sort disjointness and the sort-normalization of the
EXTERNAL Ramsey order remain independent obligations.
-/

namespace AllThoseRamseyClasses.Applications.TotallyOrderedIncidence

open StructuralRamsey
open StructuralRamsey.Structure
open AllThoseRamseyClasses.Applications.TotallyOrderedEncoding

universe u v

/-- Forget the new reverse-coordinate functions but retain the
complete original relations, unary sorts and forward F_r fibres. -/
def twoWayForwardReduct {L : RelLanguage.{u}} {V : Type v}
    (C : Structure (twoWayIncidenceLanguage L) V) :
    Structure (markedIncidencePaperLanguage L) V where
  rel := C.rel
  func r t := C.func (.inl r) t

/-- Every positive forward-output tag uniquely determines the
whole original input tuple via its reverse unary coordinate fibres.
The predicate is deliberately silent on orphan tags. -/
def HasRecoverableCoordinates
    {L : RelLanguage.{u}} {V : Type v}
    (C : Structure (twoWayIncidenceLanguage L) V) : Prop :=
  ∀ (r : L.Symbol) (t : Fin (L.arity r) → V),
    C.rel (.paper (.original r)) t →
    ∀ z, z ∈ C.func (.inl r) t →
      ∀ i : Fin (L.arity r),
        C.func (.inr ⟨r, i⟩) ![z] = {t i}

/-- In the canonical two-way incidence lift, each positive tuple's
tag has exactly its original coordinate as the reverse output. -/
theorem canonical_hasRecoverableCoordinates
    {L : RelLanguage.{u}} [LinearOrder L.Symbol]
    {V : Type v}
    (A : TotalOrderData L V) :
    HasRecoverableCoordinates (canonicalTwoWayIncidence A) := by
  classical
  intro r t hPos z hz i
  change liftedOriginalRel A r t at hPos
  rcases hPos with ⟨old, hOld, ht⟩
  have hEq : t = (fun j => (Sum.inl (old j) : IncidenceCarrier A)) := by
    funext j
    exact hOld j
  subst t
  change z ∈ fullIncidenceFibre A r (fun j => .inl (old j)) at hz
  rw [fullIncidenceFibre_old A r old] at hz
  change some z = incidenceValue A r old at hz
  have hVal : incidenceValue A r old =
      some (positiveTag A r old ht) := by
    simp [incidenceValue, positiveTag, ht]
  have hzEq : z = positiveTag A r old ht :=
    Option.some.inj (hz.trans hVal)
  subst z
  change reverseCoordinateFibre A r i (positiveTag A r old ht) =
    {(.inl (old i) : IncidenceCarrier A)}
  exact reverseCoordinateFibre_positiveTag A r old ht i

/-- A shared forward tag determines every coordinate on the nose.
In particular two distinct positive tuples cannot have the same
singleton incidence-function output. -/
theorem HasRecoverableCoordinates.same_tag_implies_same_tuple
    {L : RelLanguage.{u}} {V : Type v}
    {C : Structure (twoWayIncidenceLanguage L) V}
    (h : HasRecoverableCoordinates C)
    (r : L.Symbol)
    (t s : Fin (L.arity r) → V)
    (ht : C.rel (.paper (.original r)) t)
    (hs : C.rel (.paper (.original r)) s)
    (z : V)
    (hzt : z ∈ C.func (.inl r) t)
    (hzs : z ∈ C.func (.inl r) s) :
    t = s := by
  funext i
  have hti : t i ∈ C.func (.inr ⟨r, i⟩) ![z] := by
    rw [h r t ht z hzt i]
    exact Set.mem_singleton (t i)
  rw [h r s hs z hzs i] at hti
  simpa only [Set.mem_singleton_iff] using hti

/-- Complete reverse-coordinate recovery is reflected by any
FULL functional embedding. No positive-only homomorphism shortcut
is used: equality of the forward and reverse set-valued fibres
gives the required surjectivity onto the source's reverse singleton. -/
theorem HasRecoverableCoordinates.of_embedding
    {L : RelLanguage.{u}} {U V : Type v}
    {A : Structure (twoWayIncidenceLanguage L) U}
    {B : Structure (twoWayIncidenceLanguage L) V}
    (hB : HasRecoverableCoordinates B)
    (e : Structure.Embedding A B) :
    HasRecoverableCoordinates A := by
  classical
  intro r t hPos z hz i
  have hPosB : B.rel (.paper (.original r)) (e ∘ t) :=
    (e.map_rel_iff (.paper (.original r)) t).mpr hPos
  have hZB : e z ∈ B.func (.inl r) (e ∘ t) := by
    have hi : e z ∈ e '' A.func (.inl r) t := ⟨z, hz, rfl⟩
    change e z ∈ imageSet e (A.func (.inl r) t) at hi
    rw [e.map_func (.inl r) t] at hi
    exact hi
  have hReverseB := hB r (e ∘ t) hPosB (e z) hZB i
  have hUnary : (e ∘ ![z]) = ![e z] := by
    funext j
    fin_cases j
    rfl
  have hImage : e '' A.func (.inr ⟨r, i⟩) ![z] = {e (t i)} := by
    have hmap := e.map_func (.inr ⟨r, i⟩) ![z]
    change e '' A.func (.inr ⟨r, i⟩) ![z] =
      B.func (.inr ⟨r, i⟩) (e ∘ ![z]) at hmap
    rw [hUnary, hReverseB] at hmap
    exact hmap
  ext x
  constructor
  · intro hx
    have he : e x ∈ e '' A.func (.inr ⟨r, i⟩) ![z] :=
      ⟨x, hx, rfl⟩
    rw [hImage] at he
    have heq : e x = e (t i) := by
      simpa only [Set.mem_singleton_iff] using he
    exact e.injective heq
  · intro hx
    have hxeq : x = t i := by
      simpa only [Set.mem_singleton_iff] using hx
    subst x
    have he : e (t i) ∈ e '' A.func (.inr ⟨r, i⟩) ![z] := by
      rw [hImage]
      exact Set.mem_singleton _
    obtain ⟨y, hy, hEq⟩ := he
    have hyEq : y = t i := e.injective hEq
    subst y
    exact hy

/-- Recoverability of positive relation tags is preserved by
genuine FULL FUNCTIONAL free amalgamation: the positive tuple
comes from one side, its forward output comes from that side by
equality of full fibres, and its reverse coordinate fibres are
also carried onto the corresponding amalgam fibres. -/
theorem HasRecoverableCoordinates.free_amalgam
    {L : RelLanguage.{u}}
    {H E F W : Type v}
    {D : Structure (twoWayIncidenceLanguage L) H}
    {A : Structure (twoWayIncidenceLanguage L) E}
    {B : Structure (twoWayIncidenceLanguage L) F}
    {C : Structure (twoWayIncidenceLanguage L) W}
    {sA : Structure.Embedding D A}
    {sB : Structure.Embedding D B}
    {iA : Structure.Embedding A C}
    {iB : Structure.Embedding B C}
    (hfree : IsFreeAmalgam sA sB iA iB)
    (hA : HasRecoverableCoordinates A)
    (hB : HasRecoverableCoordinates B) :
    HasRecoverableCoordinates C := by
  classical
  intro r t ht z hz i
  rcases (hfree.rel_iff (.paper (.original r)) t).mp ht with
    ⟨x, hX, hEq⟩ | ⟨x, hX, hEq⟩
  · subst t
    have hzCopy : z ∈ iA '' A.func (.inl r) x := by
      have hmap := iA.map_func (.inl r) x
      change iA '' A.func (.inl r) x =
        C.func (.inl r) (iA ∘ x) at hmap
      rw [hmap]
      exact hz
    obtain ⟨a, ha, rfl⟩ := hzCopy
    have hrev : A.func (.inr ⟨r, i⟩) ![a] = {x i} :=
      hA r x hX a ha i
    have hmap := iA.map_func (.inr ⟨r, i⟩) ![a]
    have htup : (iA ∘ ![a]) = ![iA a] := by
      funext j
      fin_cases j
      rfl
    change iA '' A.func (.inr ⟨r, i⟩) ![a] =
      C.func (.inr ⟨r, i⟩) (iA ∘ ![a]) at hmap
    rw [htup, hrev] at hmap
    simpa only [Set.image_singleton, Function.comp_apply] using hmap.symm
  · subst t
    have hzCopy : z ∈ iB '' B.func (.inl r) x := by
      have hmap := iB.map_func (.inl r) x
      change iB '' B.func (.inl r) x =
        C.func (.inl r) (iB ∘ x) at hmap
      rw [hmap]
      exact hz
    obtain ⟨a, ha, rfl⟩ := hzCopy
    have hrev : B.func (.inr ⟨r, i⟩) ![a] = {x i} :=
      hB r x hX a ha i
    have hmap := iB.map_func (.inr ⟨r, i⟩) ![a]
    have htup : (iB ∘ ![a]) = ![iB a] := by
      funext j
      fin_cases j
      rfl
    change iB '' B.func (.inr ⟨r, i⟩) ![a] =
      C.func (.inr ⟨r, i⟩) (iB ∘ ![a]) at hmap
    rw [htup, hrev] at hmap
    simpa only [Set.image_singleton, Function.comp_apply] using hmap.symm

end AllThoseRamseyClasses.Applications.TotallyOrderedIncidence
