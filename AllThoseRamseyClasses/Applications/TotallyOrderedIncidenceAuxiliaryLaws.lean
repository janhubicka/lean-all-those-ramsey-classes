import AllThoseRamseyClasses.Applications.TotallyOrderedIncidenceMarkedPaperEmbedding

/-!
# Closed-hereditary incidence-function laws with orphan tag vertices

The *literal* canonical incidence lift is not automatically closed under
taking a function-closed induced substructure: a closed set may retain
new incidence vertices without their old generating tuples.

This module isolates exactly the needed completion-invariant local laws
on the FULL sort-marked functional language. A positive original
r-relation tuple consists entirely of Old vertices and has one and
only one F_r-output in New_r. A negative original tuple has EMPTY
function output. Importantly NO axiom requires every New_r vertex to
be generated by a positive old tuple: orphan tags are allowed.

We prove these laws hold in the canonical incidence lift, and,
crucially, are inherited by ANY FUNCTION-CLOSED induced substructure.
This is a genuine closed-heredity component for the larger auxiliary
class of the paper's totally ordered incidence application, not yet
a theorem about strong amalgamation or Ramsey.
-/

namespace AllThoseRamseyClasses.Applications.TotallyOrderedIncidence

open StructuralRamsey
open StructuralRamsey.Structure
open AllThoseRamseyClasses.Applications.TotallyOrderedEncoding

universe u v

/-- Positive relation roots, singleton New_r outputs, and precise
empty outputs for negative tuples. There is intentionally NO
generator/surjectivity axiom for all New_r vertices: closed induced
substructures may contain orphan new vertices. -/
structure IncidenceFunctionLaws
    {L : RelLanguage.{u}} {V : Type v}
    (C : Structure (markedIncidencePaperLanguage L) V) : Prop where
  positive_old :
    ∀ (r : L.Symbol) (t : Fin (L.arity r) → V),
      C.rel (.paper (.original r)) t →
      ∀ i, C.rel .old ![t i]
  positive_singleton :
    ∀ (r : L.Symbol) (t : Fin (L.arity r) → V),
      C.rel (.paper (.original r)) t →
      ∃ y : V, C.func r t = {y} ∧ C.rel (.newSymbol r) ![y]
  negative_empty :
    ∀ (r : L.Symbol) (t : Fin (L.arity r) → V),
      ¬ C.rel (.paper (.original r)) t →
      C.func r t = ∅

/-- The honest canonical marked incidence structure satisfies
the complete local function rules, including empty fibres for
mixed original/tag inputs, with no arity restriction. -/
theorem canonical_incidenceFunctionLaws
    {L : RelLanguage.{u}} [LinearOrder L.Symbol]
    {V : Type v}
    (A : TotalOrderData L V) :
    IncidenceFunctionLaws (markedIncidencePaperStructure A) := by
  classical
  refine ⟨?_, ?_, ?_⟩
  · intro r t hPositive i
    change liftedOriginalRel A r t at hPositive
    rcases hPositive with ⟨old, hOld, _⟩
    change isOriginalVertex A (t i)
    rw [hOld i]
    trivial
  · intro r t hPositive
    change liftedOriginalRel A r t at hPositive
    rcases hPositive with ⟨old, hOld, hRel⟩
    have ht : t = (fun i => Sum.inl (old i)) := by
      funext i
      exact hOld i
    subst t
    refine ⟨.inr ⟨r, ⟨old, hRel⟩⟩, ?_, ?_⟩
    · change fullIncidenceFibre A r (fun i => .inl (old i)) = _
      rw [fullIncidenceFibre_old A r old]
      ext y
      simp [valueFibre, incidenceValue, hRel]
    · change hasIncidenceSymbol A r (.inr ⟨r, ⟨old, hRel⟩⟩)
      rfl
  · intro r t hNegative
    change ¬ liftedOriginalRel A r t at hNegative
    change fullIncidenceFibre A r t = ∅
    ext y
    constructor
    · rintro ⟨old, hOld, hy⟩
      have hSome : (incidenceValue A r old).isSome := by
        change some y = incidenceValue A r old at hy
        rw [← hy]
        rfl
      exact (hNegative ⟨old, hOld,
        (incidenceValue_isSome_iff A r old).mp hSome⟩).elim
    · intro hy
      cases hy

/-- The exact incidence-function laws are hereditary under every
FULL function-closed induced substructure. This does NOT require
the induced carrier to be a literal canonical incidence lift.
In particular, isolated New_r vertices may remain without roots. -/
theorem IncidenceFunctionLaws.induce_closed
    {L : RelLanguage.{u}} {V : Type v}
    {C : Structure (markedIncidencePaperLanguage L) V}
    (h : IncidenceFunctionLaws C)
    (S : Set V) (hS : C.IsClosed S) :
    IncidenceFunctionLaws (C.induce S hS) := by
  classical
  refine ⟨?_, ?_, ?_⟩
  · intro r t hPositive i
    have hOld := h.positive_old r (Subtype.val ∘ t) hPositive i
    change C.rel .old (Subtype.val ∘ ![t i])
    simpa only [Function.comp_apply] using hOld
  · intro r t hPositive
    obtain ⟨y, hFunc, hTag⟩ :=
      h.positive_singleton r (Subtype.val ∘ t) hPositive
    have hyMem : y ∈ C.func r (Subtype.val ∘ t) := by
      rw [hFunc]
      exact Set.mem_singleton y
    have hyS : y ∈ S :=
      hS r (Subtype.val ∘ t) (fun i => (t i).2) hyMem
    refine ⟨⟨y, hyS⟩, ?_, ?_⟩
    · change {z : S | z.1 ∈ C.func r (Subtype.val ∘ t)} =
        {⟨y, hyS⟩}
      rw [hFunc]
      ext z
      simp
    · change C.rel (.newSymbol r) (Subtype.val ∘ ![(⟨y, hyS⟩ : S)])
      simpa only [Function.comp_apply] using hTag
  · intro r t hNegative
    have hAbs : ¬ C.rel (.paper (.original r)) (Subtype.val ∘ t) :=
      hNegative
    have hEmpty := h.negative_empty r (Subtype.val ∘ t) hAbs
    change {z : S | z.1 ∈ C.func r (Subtype.val ∘ t)} = ∅
    rw [hEmpty]
    simp

end AllThoseRamseyClasses.Applications.TotallyOrderedIncidence
