import AllThoseRamseyClasses.Published.FunctionalWithParts2019RelativeHGlue
import PartiteConstruction.Ramsey.ClosureRankOneBase

/-!
# Track C: relative H-completion gluing across a rank-one closed root

A U-closed structure generated by at most one vertex (including
the empty-generated case) is U-irreducible.  Thus under corrected
2019 (4b), a U-closed root of USize <= 1 embedded into a candidate
satisfying corrected coverage belongs to the canonical K(H) image.

Consequently two genuine H-valued ambient-relative side completions
glue over that root, provided the source free amalgam has relatively
U-closed side ranges and embeds fully into the corrected-(4b)
candidate.  The gluing theorem keeps the *same* original Whole
source carrier, positive OLD relations and persistent domain masks.

No universal root-completion oracle is postulated.  Higher-rank
U-reducible roots remain outside this theorem; requiring only that
both side weak sources be independently H-completable is not enough.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.RelStructure
open StructuralRamsey.PartialSetStructure

universe u v w
variable {L : Language.{u}} {Parts : Type v} [Fintype Parts]
variable {RootV LeftV RightV WholeV CandV : Type w}

/-- A CLOSED source root of intrinsic U-generating rank at most one
is automatically a protected canonical H-root in a corrected-(4b)
candidate.  Its two H-completable sides therefore glue through
that same root, on precisely the original Whole vertex set. -/
theorem genuinePartite2019_relativeCompletion_glue_over_rankOne_root
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    (hStrong : GenuinePartiteStrongAmalgamation2019 H)
    (hIso : GenuinePartiteIsomorphismClosed2019 H)
    (hKIrr : ∀ {X : Type w}
      (D : RelStructure
        ((L.withParts Parts).wholeMaskTagLanguage Parts) X),
      canonicalGenuineTagged2019Class H D → D.Irreducible)
    (Candidate : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) CandV)
    (hCovered : CorrectedUIrreduciblesIn
      (canonicalGenuineTagged2019Class H)
      ((L.withParts Parts).wholeMaskClosureRules Parts) Candidate)
    {Root : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) RootV}
    {Left : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) LeftV}
    {Right : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) RightV}
    {Whole : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) WholeV}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    (hSrc : IsFreeAmalgam sL sR iL iR)
    (eWhole : Embedding Whole Candidate)
    (hL : IsUSubstructure
      ((L.withParts Parts).wholeMaskClosureRules Parts)
      Whole (Set.range iL))
    (hR : IsUSubstructure
      ((L.withParts Parts).wholeMaskClosureRules Parts)
      Whole (Set.range iR))
    [Fintype RootV]
    (hRootClosed : IsUClosed
      ((L.withParts Parts).wholeMaskClosureRules Parts) Root)
    (hRank : USize
      ((L.withParts Parts).wholeMaskClosureRules Parts) Root ≤ 1)
    (hLeft : HasGenuinePartiteTagged2019RelativeCompletion H Left)
    (hRight : HasGenuinePartiteTagged2019RelativeCompletion H Right) :
    HasGenuinePartiteTagged2019RelativeCompletion H Whole := by
  have hRootIrred : IsUIrreducible
      ((L.withParts Parts).wholeMaskClosureRules Parts) Root :=
    hRootClosed.uIrreducible_of_USize_le_one hRank
  exact genuinePartite2019_relativeCompletion_glue_over_protected_root
    H hStrong hIso hKIrr Candidate hCovered
    hSrc eWhole hL hR hRootClosed hRootIrred hLeft hRight

/-- Express the irreducibility-of-canonical-targets premise only in
terms of the corrected 2019 theorem's actual ambient R class. -/
theorem genuinePartite2019_relativeCompletion_glue_over_rankOne_root_of_ambient
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    (R : StructureClass
      (L := (L.withParts Parts).wholeMaskTagLanguage Parts))
    (hRIrred : ∀ {X : Type w}
      (D : RelStructure
        ((L.withParts Parts).wholeMaskTagLanguage Parts) X),
      R D → D.Irreducible)
    (hSub : ∀ {X : Type w}
      (D : RelStructure
        ((L.withParts Parts).wholeMaskTagLanguage Parts) X),
      canonicalGenuineTagged2019Class H D → R D)
    (hStrong : GenuinePartiteStrongAmalgamation2019 H)
    (hIso : GenuinePartiteIsomorphismClosed2019 H)
    (Candidate : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) CandV)
    (hCovered : CorrectedUIrreduciblesIn
      (canonicalGenuineTagged2019Class H)
      ((L.withParts Parts).wholeMaskClosureRules Parts) Candidate)
    {Root : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) RootV}
    {Left : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) LeftV}
    {Right : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) RightV}
    {Whole : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) WholeV}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    (hSrc : IsFreeAmalgam sL sR iL iR)
    (eWhole : Embedding Whole Candidate)
    (hL : IsUSubstructure
      ((L.withParts Parts).wholeMaskClosureRules Parts)
      Whole (Set.range iL))
    (hR : IsUSubstructure
      ((L.withParts Parts).wholeMaskClosureRules Parts)
      Whole (Set.range iR))
    [Fintype RootV]
    (hRootClosed : IsUClosed
      ((L.withParts Parts).wholeMaskClosureRules Parts) Root)
    (hRank : USize
      ((L.withParts Parts).wholeMaskClosureRules Parts) Root ≤ 1)
    (hLeft : HasGenuinePartiteTagged2019RelativeCompletion H Left)
    (hRight : HasGenuinePartiteTagged2019RelativeCompletion H Right) :
    HasGenuinePartiteTagged2019RelativeCompletion H Whole :=
  genuinePartite2019_relativeCompletion_glue_over_rankOne_root
    H hStrong hIso (fun D hK => hRIrred D (hSub D hK))
    Candidate hCovered hSrc eWhole hL hR hRootClosed hRank
    hLeft hRight

end AllThoseRamseyClasses.Published
