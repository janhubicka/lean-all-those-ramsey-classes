import AllThoseRamseyClasses.Published.InducedClosed2019TestNormalization
import PartiteConstruction.Ramsey.ClosureIrreducibleHulls

/-!
# Every vertex of a covered CLOSED 2019 Picture has a genuine closed K anchor

The tempting A-COVER condition used in conditional native weak-history
PR #159 is not guaranteed: a vertex in an old Picture may have the
wrong unary type to belong to ANY induced full copy of the selected
A. A proof of the general theorem must not assume all vertices
lie in copies of the single selected A.

There IS an automatic, weaker anchored-coverage principle from the
ACTUAL invariants of the repaired 2019 Picture.

Let D be U-closed and suppose EVERY closed U-irreducible test
embedded into D embeds into one original B∈K, with K hereditary
for U-closed substructures. For EVERY vertex x of D:

  Q_x := D induced on its U-closure of {x}

is intrinsically U-closed (since D is closed), intrinsically
U-irreducible (the singleton is ordinarily irreducible and generates
its hull), and a member of K (coverage embeds Q_x into B, then
K-heredity applies). Its canonical embedding Q_x -> D contains x.

Thus every old-Picture vertex belongs to a genuine closed
U-irreducible K-root, but that root may depend on x and need
not be isomorphic to A. It may have MANY vertices despite being
generated by one vertex. No cardinal bound |Q_x| <= j or global
A-coverage is asserted.

This suggests a more flexible rooted weak-size invariant quantified
over ALL closed U-irreducible K-anchors, rather than a fixed A. Its
iterated construction is a separate open obligation.

No general repaired Theorem 2.18 is claimed.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.RelStructure

universe u v
variable {L : RelLanguage.{u}}

/-- A U-closed Picture with the actual 2019 closed-irreducible
B-coverage and closed-heredity of K has a CLOSED, U-IRREDUCIBLE,
K-member singleton-generated substructure containing EACH vertex.

The root is chosen as the exact ambient U-closure of the singleton,
not a fabricated A-copy or a small weak-image target. -/
theorem native2019_closed_picture_vertex_has_K_singleton_anchor
    {K : StructureClass.{u,v} (L := L)}
    {rules : ClosureDescription L}
    {VD VB : Type v}
    (D : RelStructure L VD)
    (B : RelStructure L VB)
    (hD : IsUClosed rules D)
    (hBK : K B)
    (hHer : ClosedUHereditary K rules)
    (hCover : ∀ {X : Type v} (Test : RelStructure L X),
      IsUClosed rules Test →
      IsUIrreducible rules Test →
      Embedding Test D →
      Nonempty (Embedding Test B))
    (x : VD) :
    ∃ S : Set VD, x ∈ S ∧
      IsUClosed rules (D.induce S) ∧
      IsUIrreducible rules (D.induce S) ∧
      K (D.induce S) := by
  let S : Set VD := UClosureHull rules D ({x} : Set VD)
  have hx : x ∈ S :=
    subset_UClosureHull rules D ({x} : Set VD) (by simp)
  have hClosed : IsUClosed rules (D.induce S) :=
    hD.induce_UClosureHull ({x} : Set VD)
  have hIrred : IsUIrreducible rules (D.induce S) :=
    hD.singleton_hull_isUIrreducible x
  obtain ⟨e⟩ :=
    hCover (D.induce S) hClosed hIrred (inclusion D S)
  have hQK : K (D.induce S) :=
    hHer (D.induce S) B hBK hClosed e
  exact ⟨S, hx, hClosed, hIrred, hQK⟩

end AllThoseRamseyClasses.Published
