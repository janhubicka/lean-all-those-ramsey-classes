import AllThoseRamseyClasses.Published.FunctionalWithParts2019CanonicalKCompletion
import PartiteConstruction.Functional.WholeMaskClosednessDictionary2019
import PartiteConstruction.Functional.WholeMaskCanonicalClosedInduce2019

/-!
# A genuine partite functional class in the canonical 2019 relational language

Instead of postulating that an arbitrary unrelated relational K-class
has canonical function targets, construct K from actual finite part-labelled
genuinely partial Option(Set) structures with transversal output fibres.
The class consists of finite, U-closed canonical tagged whole-mask objects.

Moreover, closed hereditary membership of the source functional class
passes to exact U-closed INDUCED substructures of its tagged presentation:
a subset inducing a U-closed target is genuinely function-closed by the
verified 2019 dictionary, and the full closed functional induced structure
has the exact same OLD and tagged relations on its original vertices.

This neither establishes strong amalgamation nor locally finite
K-completion in this generated class. In particular those cannot be
inferred simply because all target objects have canonical syntax.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.RelStructure
open StructuralRamsey.PartialSetStructure

universe u v w
variable {L : Language.{u}} {Parts : Type v} [Fintype Parts]

/-- A class of genuinely partial structures together with vertex parts. -/
abbrev GenuinePartite2019Class :=
  ∀ {X : Type w}, PartialSetStructure L X → (X → Parts) → Prop

/-- The finite canonical tagged OLD class generated by genuine partite
partial-function structures; no arbitrary K-member is presumed canonical. -/
def canonicalGenuineTagged2019Class
    (H : GenuinePartite2019Class (L := L) (Parts := Parts)) :
    StructureClass (L := (L.withParts Parts).wholeMaskTagLanguage Parts) :=
  fun {X} E =>
    Finite X ∧
    ∃ (A : PartialSetStructure L X) (part : X → Parts),
      H A part ∧ FibreTransversal A part ∧
      E = wholeMaskTagExpansion (withPartsWholeMaskOld A part)

/-- The source is a literal member of its canonical relational image. -/
theorem canonicalGenuineTagged2019Class_mem
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    {X : Type w} [Finite X]
    (A : PartialSetStructure L X) (part : X → Parts)
    (hH : H A part) (hTr : FibreTransversal A part) :
    canonicalGenuineTagged2019Class H
      (wholeMaskTagExpansion (withPartsWholeMaskOld A part)) :=
  ⟨inferInstance, A, part, hH, hTr, rfl⟩

/-- The canonical functional-target interpretation in the local
K-completion theorem is automatic for this explicitly generated class. -/
theorem canonicalGenuineTagged2019Class_targetsCanonical
    (H : GenuinePartite2019Class (L := L) (Parts := Parts)) :
    All2019KTargetsCanonicalPartial (canonicalGenuineTagged2019Class H) := by
  intro X hX E hE
  obtain ⟨_, A, part, _, hTr, hEq⟩ := hE
  exact ⟨A, part, hTr, hEq⟩

/-- Every member has a finite carrier. -/
theorem canonicalGenuineTagged2019Class_finite
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    {X : Type w}
    (E : RelStructure ((L.withParts Parts).wholeMaskTagLanguage Parts) X)
    (hE : canonicalGenuineTagged2019Class H E) :
    Finite X := hE.1

/-- Every tagged representation has its prescribed U-closures. -/
theorem canonicalGenuineTagged2019Class_closed
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    {X : Type w}
    (E : RelStructure ((L.withParts Parts).wholeMaskTagLanguage Parts) X)
    (hE : canonicalGenuineTagged2019Class H E) :
    IsUClosed ((L.withParts Parts).wholeMaskClosureRules Parts) E := by
  obtain ⟨_, A, part, _, hTr, hEq⟩ := hE
  rw [hEq]
  have hTrPlus : FibreTransversal (A.withParts part) part :=
    (A.withParts_fibreTransversal_iff part).mpr hTr
  exact (A.withParts part).wholeMaskTagExpansion_isUClosed part hTrPlus

/-- Closure under actual full function-closed restrictions, NOT arbitrary
nonclosed weak substructures. -/
def GenuinePartiteClosedHereditary2019
    (H : GenuinePartite2019Class (L := L) (Parts := Parts)) : Prop :=
  ∀ {X : Type w} [Finite X]
    (A : PartialSetStructure L X) (part : X → Parts),
    H A part →
    ∀ (S : Set X) (hS : A.IsClosed S),
      H (A.induceClosed S hS) (part ∘ Subtype.val)

/-- Original functional closed-heredity transfers to the exact
induced-closed hereditary axiom of the 2019 tagged relational class. -/
theorem canonicalGenuineTagged2019Class_inducedClosedHereditary
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    (hHer : GenuinePartiteClosedHereditary2019 H)
    (hPos : L.PositiveFuncArity) :
    InducedClosed2019Hereditary (canonicalGenuineTagged2019Class H)
      ((L.withParts Parts).wholeMaskClosureRules Parts) := by
  intro X E hE S hUS
  obtain ⟨hFinite, A, part, hHA, hTr, hEq⟩ := hE
  letI : Finite X := hFinite
  rw [hEq] at hUS
  have hTrPlus : FibreTransversal (A.withParts part) part :=
    (A.withParts_fibreTransversal_iff part).mpr hTr
  have hSPlus : (A.withParts part).IsClosed S :=
    ((A.withParts part).isClosed_iff_wholeMaskTaggedInduce_isUClosed
      part (hPos.withParts) hTrPlus S).mpr hUS
  have hS : A.IsClosed S :=
    (A.withParts_isClosed_iff part S).mp hSPlus
  let A_S : PartialSetStructure L S := A.induceClosed S hS
  let partS : S → Parts := part ∘ Subtype.val
  have hHS : H A_S partS := hHer A part hHA S hS
  have hTrS : FibreTransversal A_S partS :=
    hTr.induceClosed A part S hS
  let incl : PartialSetStructure.Embedding
      (A_S.withParts partS) (A.withParts part) :=
    (A.closedInclusion S hS).withParts partS part (fun _ => rfl)
  let inclOld : RelStructure.Embedding
      (withPartsWholeMaskOld A_S partS)
      (withPartsWholeMaskOld A part) :=
    incl.wholeMaskPatternGraph partS part (fun _ => rfl)
  have hOldEq :
      withPartsWholeMaskOld A_S partS =
        (withPartsWholeMaskOld A part).induce S := by
    apply RelStructure.rel_injective
    funext R xs
    exact propext (inclOld.map_rel_iff R xs).symm
  have hTaggedEq :
      (wholeMaskTagExpansion (withPartsWholeMaskOld A part)).induce S =
        wholeMaskTagExpansion (withPartsWholeMaskOld A_S partS) := by
    calc
      (wholeMaskTagExpansion (withPartsWholeMaskOld A part)).induce S =
          wholeMaskTagExpansion ((withPartsWholeMaskOld A part).induce S) :=
            (wholeMaskTagExpansion_induce_eq
              (withPartsWholeMaskOld A part) S).symm
      _ = wholeMaskTagExpansion (withPartsWholeMaskOld A_S partS) := by
            rw [← hOldEq]
  refine ⟨inferInstance, A_S, partS, hHS, hTrS, ?_⟩
  rw [hEq]
  exact hTaggedEq

end AllThoseRamseyClasses.Published
