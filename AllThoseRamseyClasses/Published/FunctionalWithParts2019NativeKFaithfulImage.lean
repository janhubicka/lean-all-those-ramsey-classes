import AllThoseRamseyClasses.Published.FunctionalWithParts2019ActualEHNStageKDictionary

/-!
# Track B: faithful native functional class K has a canonical 2019 H image

The earlier exact stage/K_H dictionary required the native finite
EHN Stage's faithful Option(Set) representation to belong to a
chosen genuine functional class H. A native EHN Stage itself only
provides `T.mem : K T.system.toStructure` for a native class K.

Define the precise genuine H class generated by native K-systems,
on their SAME vertex sets and with their REAL vertex parts.
Every H object comes with a native transversal system witness in K;
the genuine partial function values are exactly the original
nonempty-defined native fibres.

This faithfully connects the actual native K input to a canonical
full OLD/root-tagged 2019 K_H relational object without assuming
membership in some unrelated H. It is an exact SOURCE-class image,
not proof that native K is closed-hereditary, has strong amalgamation,
or satisfies the 2019 relative local completion axiom.

The optional closed-test equivalence below explicitly assumes
closed heredity of this faithful H image; it is NOT inferred from
arbitrary native Stage membership.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.Structure
open StructuralRamsey.RelStructure
open StructuralRamsey.PartialSetStructure

universe u v
variable {L : Language.{u}} {Parts : Type v} [Fintype Parts]
variable {K : Structure.StructureClass (L := L)}
variable {D : Structure L Parts}

/-- Exactly the genuine partial part-labelled structures represented
by native, transversal functional partite systems in class K.

Each witness has the SAME carrier and actual part map; empty native
fibres become `none`, and no defined-empty `some ∅` inputs are
invented. Nothing is assumed about closure properties of K. -/
def nativeKFaithfulGenuinePartiteH2019
    (K : Structure.StructureClass (L := L)) :
    GenuinePartite2019Class (L := L) (Parts := Parts) :=
  fun {X} A part =>
    ∃ (B : FunctionalPartite.System L Parts X),
      K B.toStructure ∧
      A = B.toStructure.toNonemptyPartial ∧
      part = B.part

/-- The ACTUAL native finite EHN Stage belongs automatically to
the faithful genuine H image of its own native class K, using
the original Stage.system and Stage.mem proof.

This is not an assumption about an unrelated class H. -/
theorem genuineEHNStage_nativeKFaithfulH_mem
    (T : FunctionalPartite.EHN.Stage K D) :
    nativeKFaithfulGenuinePartiteH2019 K
      T.system.toStructure.toNonemptyPartial T.system.part :=
  ⟨T.system, T.mem, rfl, rfl⟩

/-- The faithful canonical 2019 tagged representation of EVERY
actual native finite EHN Stage is therefore a member of the
canonical relational class generated by native K through H.

The tagged structure is built on the LITERAL original carrier and
includes original parts, all complete OLD function masks and full
fresh U-root patterns. No rank hull or synthetic Picture is used. -/
theorem genuineEHNStage_nativeKCanonicalTagged_mem
    (T : FunctionalPartite.EHN.Stage K D) :
    canonicalGenuineTagged2019Class
      (nativeKFaithfulGenuinePartiteH2019 K)
      (genuineEHNStageCanonical2019Tag T) :=
  (genuineEHNStageCanonical2019Tag_mem_iff
    (nativeKFaithfulGenuinePartiteH2019 K) T).mpr
      (genuineEHNStage_nativeKFaithfulH_mem T)

/-- If the faithful native K-image really is closed-hereditary as a
genuine functional H class, the 2019 canonical tagged K_H members
among the induced AMBIENT weak tests of an ACTUAL EHN Stage are
EXACTLY the true native function-closed tests.

The H-heredity premise remains explicit: arbitrary K membership of
the Stage does not imply heredity or local completion. Neither the
native test nor its tagged counterpart is replaced by a hull. -/
theorem genuineEHNStage_nativeKImage_inducedK_mem_iff_closed
    (T : FunctionalPartite.EHN.Stage K D)
    (hHer : GenuinePartiteClosedHereditary2019
      (nativeKFaithfulGenuinePartiteH2019 K))
    (hPos : L.PositiveFuncArity)
    (S : Set T.Carrier) :
    canonicalGenuineTagged2019Class
        (nativeKFaithfulGenuinePartiteH2019 K)
        ((genuineEHNStageCanonical2019Tag T).induce S) ↔
      T.system.toStructure.IsClosed S :=
  genuineEHNStage_inducedCanonicalK_mem_iff_closed
    (nativeKFaithfulGenuinePartiteH2019 K)
    hHer T (genuineEHNStage_nativeKFaithfulH_mem T) hPos S

end AllThoseRamseyClasses.Published
