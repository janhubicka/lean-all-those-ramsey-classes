import AllThoseRamseyClasses.Published.InducedClosed2019TestNormalization
import PartiteConstruction.Ramsey.ClosureProjectedGenerators

/-!
# Rank preservation under corrected 2019 protected maps

The 2019 Lemma 2.30 iteration must preserve all previously established
rank-j completion certificates during each finite partite Picture pass.
This is a different task from increasing the controlled rank j->j+1.

We prove the general preservation theorem directly, in the EXACT
corrected 2019 induced-test convention:

If B is finite and U-closed, every closed rank-<=j induced substructure
of B has an amended (K,U)-completion, and A admits an induced-closed
protected positive map f:A->B, then any finite A with USize(A)<=j
has an amended (K,U)-completion. No intrinsic closedness of A
is required, making this useful for the original weak sources.

The source is generated by a minimum finite G, and its projected
support f[G] has cardinality at most |G|<=j. Complete the CLOSED
ambient hull in B, then pull the completed map back to the ORIGINAL
source A; never replace A by that hull.

This is a checked lemma of stability, NOT a j-to-j+1 rank increment
or an assertion of the general repaired Ramsey theorem.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.RelStructure

universe u v
variable {L : RelLanguage.{u}}
variable {U V : Type v}

/-- A corrected protected map into a closed, already rank-j-completable
control transfers its K-completion to an exact finite weak source
of rank <=j. No U-closedness of the source is assumed. -/
theorem inducedClosed2019_completion_of_bounded_rank_projection
    {K : StructureClass.{u,v} (L := L)}
    {rules : ClosureDescription L}
    {A : RelStructure L U} {B : RelStructure L V}
    {f : U → V}
    [Finite U] [Finite V]
    (hB : IsUClosed rules B)
    (hf : IsInducedClosedUHomomorphismEmbedding rules A B f)
    (j : ℕ)
    (hRank :
      ∀ (T : Set V) [Fintype T],
        IsUClosed rules (B.induce T) →
        USize rules (B.induce T) ≤ j →
        HasInducedClosedUKCompletion K rules (B.induce T))
    (hASize : USize rules A ≤ j) :
    HasInducedClosedUKCompletion K rules A := by
  classical
  letI : Fintype U := Fintype.ofFinite U
  obtain ⟨G, hCard, hGen⟩ := USize_spec rules A
  have hBudget : (G.image f).card ≤ j := by
    calc
      (G.image f).card ≤ G.card := Finset.card_image_le
      _ = USize rules A := hCard
      _ ≤ j := hASize
  have hAbstractRank :
      ∀ (T : Set V) [Fintype T],
        IsUClosed rules (B.induce T) →
        USize rules (B.induce T) ≤ j →
        HasClosedUKCompletion K rules (B.induce T) := by
    intro T hFiniteT hClosedT hSizeT
    letI : Fintype T := hFiniteT
    exact (inducedClosedKCompletion_iff_abstract_2019).mp
      (hRank T hClosedT hSizeT)
  have hAbstract :
      HasClosedUKCompletion K rules A :=
    HasClosedUKCompletion.of_projected_generators
      hB (IsInducedClosedUHomomorphismEmbedding.toAbstract_2019 hf)
      G hGen j hAbstractRank hBudget
  exact (inducedClosedKCompletion_iff_abstract_2019).mpr hAbstract

end AllThoseRamseyClasses.Published
