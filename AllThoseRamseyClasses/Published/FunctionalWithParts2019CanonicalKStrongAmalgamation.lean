import AllThoseRamseyClasses.Published.FunctionalWithParts2019CanonicalKClass
import PartiteConstruction.Functional.WholeMaskPartPreservingEmbeddingEquiv2019
import PartiteConstruction.Functional.WholeMaskClosureSemiClosed2019
import PartiteConstruction.Ramsey.CompatibleClassCompletion

/-!
# Strong amalgamation transfers to canonical tagged genuine partial functions

For an actual part-labelled class H of transversal genuinely partial
Option(Set) structures, formulate its finite strong amalgamation
with FULL part-preserving source embeddings and an exact intersection.

Decode the FULL tagged relational root embeddings using the already
verified canonical complete-mask embedding correspondence. Apply
genuine functional strong amalgamation, then re-encode the two
resulting genuine partial full embeddings, with canonical U-tags,
keeping exactly the same underlying vertices, agreements and
intersection. The resulting relational target belongs to the
canonical tagged K generated by H.

This does not infer strong amalgamation of the part-labelled H from
an unrelated unlabelled functional class. That derivation is still an
independent original-class obligation.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.RelStructure
open StructuralRamsey.PartialSetStructure

universe u v w
variable {L : Language.{u}} {Parts : Type v} [Fintype Parts]

/-- The original partial function class has finite strong amalgamation
ON ITS TRANSVERSAL PART-LABELLED OBJECTS, over genuine full embeddings.
No free-amalgamation or extra cross-fibre assumption is made. -/
def GenuinePartiteStrongAmalgamation2019
    (H : GenuinePartite2019Class (L := L) (Parts := Parts)) : Prop :=
  ∀ {X Y Z : Type w} [Finite X] [Finite Y] [Finite Z]
    (Root : PartialSetStructure L X) (partRoot : X → Parts)
    (Left : PartialSetStructure L Y) (partLeft : Y → Parts)
    (Right : PartialSetStructure L Z) (partRight : Z → Parts),
    H Root partRoot → H Left partLeft → H Right partRight →
    FibreTransversal Root partRoot →
    FibreTransversal Left partLeft →
    FibreTransversal Right partRight →
    ∀ (sL : PartPreservingEmbedding Root partRoot Left partLeft)
      (sR : PartPreservingEmbedding Root partRoot Right partRight),
      ∃ (W : Type w) (_ : Finite W)
        (Target : PartialSetStructure L W) (partTarget : W → Parts),
        H Target partTarget ∧ FibreTransversal Target partTarget ∧
        ∃ (jL : PartPreservingEmbedding Left partLeft Target partTarget)
          (jR : PartPreservingEmbedding Right partRight Target partTarget),
          (∀ d, jL.1.toFun (sL.1.toFun d) =
            jR.1.toFun (sR.1.toFun d)) ∧
          (∀ a b, jL.1.toFun a = jR.1.toFun b →
            ∃ d, a = sL.1.toFun d ∧ b = sR.1.toFun d)

/-- Under genuine functional PARTITE strong amalgamation, the
canonical tagged K has the finite RELATIONAL strong amalgamation
property used in the verified 2019 two-pass generated-profile proof.
The source and target carrier maps are NOT replaced by closure hulls. -/
theorem canonicalGenuineTagged2019Class_strongAmalgamation
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    (hStrong : GenuinePartiteStrongAmalgamation2019 H) :
    HasFiniteStrongAmalgamation (canonicalGenuineTagged2019Class H) := by
  classical
  intro X Y Z hX hY hZ Root Left Right
    hRoot hLeft hRight sL sR
  obtain ⟨_, AR, pR, hAR, hTR, hEqR⟩ := hRoot
  obtain ⟨_, AL, pL, hAL, hTL, hEqL⟩ := hLeft
  obtain ⟨_, AB, pB, hAB, hTB, hEqB⟩ := hRight
  subst Root
  subst Left
  subst Right
  let eL : PartPreservingEmbedding AR pR AL pL :=
    PartPreservingEmbedding.decode hTR hTL sL.wholeMaskTagReduct
  let eR : PartPreservingEmbedding AR pR AB pB :=
    PartPreservingEmbedding.decode hTR hTB sR.wholeMaskTagReduct
  have heL (x : X) : eL.1.toFun x = sL x := by rfl
  have heR (x : X) : eR.1.toFun x = sR x := by rfl
  obtain ⟨W, hW, T, partT, hHT, hTT,
      jL, jR, hAgree, hExact⟩ :=
    hStrong AR pR AL pL AB pB
      hAR hAL hAB hTR hTL hTB eL eR
  letI : Finite W := hW
  let jLTag : RelStructure.Embedding
      (wholeMaskTagExpansion (withPartsWholeMaskOld AL pL))
      (wholeMaskTagExpansion (withPartsWholeMaskOld T partT)) :=
    (PartPreservingEmbedding.encode jL).wholeMaskTag
  let jRTag : RelStructure.Embedding
      (wholeMaskTagExpansion (withPartsWholeMaskOld AB pB))
      (wholeMaskTagExpansion (withPartsWholeMaskOld T partT)) :=
    (PartPreservingEmbedding.encode jR).wholeMaskTag
  have hKTarget : canonicalGenuineTagged2019Class H
      (wholeMaskTagExpansion (withPartsWholeMaskOld T partT)) :=
    canonicalGenuineTagged2019Class_mem H T partT hHT hTT
  refine ⟨W, hW,
    wholeMaskTagExpansion (withPartsWholeMaskOld T partT),
    hKTarget, jLTag, jRTag, ?_, ?_⟩
  · intro d
    change jL.1.toFun (sL d) = jR.1.toFun (sR d)
    rw [← heL d, ← heR d]
    exact hAgree d
  · intro a b hab
    change jL.1.toFun a = jR.1.toFun b at hab
    obtain ⟨d, ha, hb⟩ := hExact a b hab
    refine ⟨d, ?_, ?_⟩
    · exact ha.trans (heL d)
    · exact hb.trans (heR d)

end AllThoseRamseyClasses.Published
