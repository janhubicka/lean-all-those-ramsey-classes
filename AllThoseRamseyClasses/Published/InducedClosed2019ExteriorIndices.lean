import PartiteConstruction.Ramsey.ClosureAttachmentSubhistory

/-!
# Actual 2019 Picture geometry: finitely many exterior copies per generator set

The higher-rank proof of Lemma 2.30 needs to trace a rank-(j+1)
test through the REAL finite Hales--Jewett attachment history, rather
than inserting an abstract decomposition with unproved properties.

The pinned native-attachment library already proves that any exterior
copy index reached by the U-closure of a generating set G is reached
by some generator in G. Here we add the NUMERICAL consequence and
package it with exact factorization through a selected subhistory:

  A finite test generated by G can visit at most |G| different
  private exterior copy indices, and it embeds fully into the
  subattachment on precisely those indices.

This does NOT assert that those selected lines share a variable
coordinate. It does not imply absolute rank-j budgets for projected
sides or completion of an arbitrary multi-line rank-(j+1) test.
It is a proved finite-history reduction on the ORIGINAL test
carrier, without adding closure vertices to the tested source.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.RelStructure
open StructuralRamsey.RelStructure.Attachment

universe u v
variable {L : RelLanguage.{u}}
variable {V W I X : Type v}
variable {Old : RelStructure L V} {Core : RelStructure L W}
variable {S : Set V}
variable {maps : I → Embedding (Old.induce S) Core}
variable {Test : RelStructure L X}

/-- Exactly the private copy indices met by the actual generators G.
A vertex in the core contributes no index; a private vertex
contributes its unique tagged copy index. -/
noncomputable def exteriorIndicesOfGenerators
    (e : Embedding Test (attach Old S Core maps))
    (G : Finset X) : Finset I := by
  classical
  exact G.biUnion (fun g =>
    match e g with
    | .inl _ => ∅
    | .inr (i, _) => {i})

/-- A generator contributes at most one exterior index, so
the number of distinct generator-active exterior copies cannot
exceed the number of generators. No rank or closure assumptions. -/
theorem exteriorIndices_card_le_generators
    (e : Embedding Test (attach Old S Core maps))
    (G : Finset X) :
    (exteriorIndicesOfGenerators e G).card ≤ G.card := by
  classical
  let F : X → Finset I := fun g =>
    match e g with
    | .inl _ => ∅
    | .inr (i, _) => {i}
  have hEach (g : X) : (F g).card ≤ 1 := by
    dsimp [F]
    cases e g <;> simp
  change (G.biUnion F).card ≤ G.card
  induction G using Finset.induction_on with
  | empty => simp
  | @insert g H hg ih =>
      rw [Finset.biUnion_insert, Finset.card_insert_of_notMem hg]
      have hUnion :
          (F g ∪ H.biUnion F).card ≤
            (F g).card + (H.biUnion F).card :=
        Finset.card_union_le _ _
      have hOne := hEach g
      omega

/-- Every generator-active private copy belongs to the canonical
finite list, even if the tested structure and the attachment are
not U-closed. -/
theorem exteriorIndex_mem_of_generator
    (e : Embedding Test (attach Old S Core maps))
    (G : Finset X)
    {g : X} (hg : g ∈ G) {i : I}
    (hOutside : OutsideAt (W := W) (I := I) S i (e g)) :
    i ∈ exteriorIndicesOfGenerators e G := by
  classical
  obtain ⟨y, hy⟩ := hOutside
  apply Finset.mem_biUnion.mpr
  refine ⟨g, hg, ?_⟩
  change i ∈ (match e g with
      | .inl _ => (∅ : Finset I)
      | .inr (k, _) => {k})
  rw [hy]
  simp

/-- A genuine U-generating set G visits at most |G| private copies
in the whole actual embedded test. The selected subattachment is
on exactly its generator-active indices, and the factor map of
the ORIGINAL test is a FULL induced embedding.

This is the finite-index form of the native generator-subhistory
theorem, not an invented partite configuration. -/
theorem native2019_factor_through_bounded_exterior_subhistory
    {rules : ClosureDescription L}
    (hS : IsUSubstructure rules Old S)
    (e : Embedding Test (attach Old S Core maps))
    (G : Finset X)
    (hGen : IsUGenerating rules Test (↑G : Set X)) :
    ∃ J : Finset I, J.card ≤ G.card ∧
      ∃ d : Embedding Test
          (attach Old S Core (fun i : (↑J : Set I) => maps i.1)),
        ∀ x, subfamilyEmbedding Old S Core maps
          (↑J : Set I) (d x) = e x := by
  classical
  let J : Finset I := exteriorIndicesOfGenerators e G
  have hJ : J.card ≤ G.card :=
    exteriorIndices_card_le_generators e G
  have hSelected :
      ∀ g ∈ (↑G : Set X), ∀ i,
        OutsideAt (W := W) (I := I) S i (e g) →
          i ∈ (↑J : Set I) := by
    intro g hg i hOutside
    exact exteriorIndex_mem_of_generator e G hg hOutside
  obtain ⟨d, hd⟩ :=
    factor_through_generator_subfamily Old S Core maps
      hS Test e (↑G : Set X) hGen (↑J : Set I) hSelected
  exact ⟨J, hJ, d, hd⟩


/-- A finite source test of intrinsic U-size r meets at most r different
private exterior copy indices in an actual native attachment.

The finite subattachment has a full embedded copy of the ENTIRE
original test, not merely of its generating set. This is the
rank-bounded form needed when tracing j+1 generators through an
actual Picture history. It does not provide completions by itself. -/
theorem native2019_rank_bounded_exterior_subhistory
    {rules : ClosureDescription L}
    [Fintype X]
    (hS : IsUSubstructure rules Old S)
    (e : Embedding Test (attach Old S Core maps)) :
    ∃ J : Finset I, J.card ≤ USize rules Test ∧
      ∃ d : Embedding Test
          (attach Old S Core (fun i : (↑J : Set I) => maps i.1)),
        ∀ x, subfamilyEmbedding Old S Core maps
          (↑J : Set I) (d x) = e x := by
  classical
  obtain ⟨G, hCard, hGen⟩ := USize_spec rules Test
  obtain ⟨J, hJ, d, hd⟩ :=
    native2019_factor_through_bounded_exterior_subhistory hS e G hGen
  refine ⟨J, ?_, d, hd⟩
  calc
    J.card ≤ G.card := hJ
    _ = USize rules Test := hCard

end AllThoseRamseyClasses.Published
