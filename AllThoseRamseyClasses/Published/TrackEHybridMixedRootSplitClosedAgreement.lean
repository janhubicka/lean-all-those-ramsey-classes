import AllThoseRamseyClasses.Published.TrackEHybridVisibleWholeSplitAgreement
import PartiteConstruction.Iterated.LocalTreeLike

/-!
# Track E2: mixed-root original/split output agreement under a closed seam

Arbitrary FULL relational free amalgamation need not preserve the
canonical hybrid law that a positive complete original output tuple
and a positive per-part split incidence name the SAME output vertex.
A complete tuple can lie on the left and a conflicting split tuple
on the right over their shared input vertices.

Here the exact sufficient geometric hypothesis is isolated:
both common-root embeddings must be closed under SPLIT outputs
whose entire distinct input prefix is already in the root image.
Under that condition, any positive split tuple over a left-side
input root has its output in the left side as well. FULL relational
reflection then allows the left canonical visible agreement theorem
to decide the result. The symmetric argument handles the right.

The backwards direction (the prescribed original output vertex
forces the corresponding split incidence) needs NO closure: it is
already generated by the side supporting the complete original tuple.

The result treats arbitrary primitive input equality patterns,
including repeated original arguments and nullary symbols, and is
a conditional free-amalgamation theorem for the original visible
hybrid output-value agreement. It is NOT an assertion that every
free-amalgamation root is split-output closed. Establishing that
closure for the exact joint U-tagged target class is a separate
substantive task, as are mixed-profile strong AP and the finite-
family sparse ordered Ramsey theorem. No new vertex or hull is
introduced.
-/

namespace StructuralRamsey.RelStructure

open StructuralRamsey
open StructuralRamsey.Language

universe u v w
variable {L : Language.{u}} {Parts : Type v} [Fintype Parts]

/-- The common root of a FULL hybrid embedding contains every
singleton split output over an input tuple entirely in that root.
This is the precise side-relative closure assumption, not a
claim about arbitrary nonclosed weak tests. -/
def HybridSplitOutputClosedAt
    {H S : Type w}
    {Root : RelStructure (L.splitMaskHybrid Parts) H}
    {Side : RelStructure (L.splitMaskHybrid Parts) S}
    (e : Embedding Root Side) : Prop :=
  ∀ (p : FunctionInputPattern (L.outputPartIndexed Parts))
    (t : Fin (p.rootSize + 1) → S),
    Side.rel (hybridSplitOutputSymbol p) t →
    (∀ i : Fin p.rootSize, ∃ z : H, t i.castSucc = e z) →
    ∃ z : H, t (Fin.last p.rootSize) = e z

/-- In a TRUE free amalgam, if the right common-root embedding is
closed under split outputs, any positive singleton split tuple
whose entire input prefix lies in the left image must have its
output in the left image too. This does not require the left
input tuple to be injective. -/
private theorem splitOutputOverLeft_staysLeft
    {H E F C : Type w}
    {Root : RelStructure (L.splitMaskHybrid Parts) H}
    {Left : RelStructure (L.splitMaskHybrid Parts) E}
    {Right : RelStructure (L.splitMaskHybrid Parts) F}
    {Whole : RelStructure (L.splitMaskHybrid Parts) C}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    (hFree : IsFreeAmalgam sL sR iL iR)
    (hRightClosed : HybridSplitOutputClosedAt sR)
    (p : FunctionInputPattern (L.outputPartIndexed Parts))
    (t : Fin (p.rootSize + 1) → C)
    (hPos : Whole.rel (hybridSplitOutputSymbol p) t)
    (hPrefix : ∀ i : Fin p.rootSize,
      ∃ a : E, t i.castSucc = iL a) :
    ∃ a : E, t (Fin.last p.rootSize) = iL a := by
  classical
  rcases (hFree.rel_iff (hybridSplitOutputSymbol p) t).mp hPos with
    ⟨x, hx, htx⟩ | ⟨y, hy, hty⟩
  · exact ⟨x (Fin.last p.rootSize),
      congrFun htx (Fin.last p.rootSize)⟩
  · have hShared (i : Fin p.rootSize) :
        ∃ z : H, y i.castSucc = sR z := by
      obtain ⟨a, ha⟩ := hPrefix i
      have heq : iL a = iR (y i.castSucc) := by
        calc
          iL a = t i.castSucc := ha.symm
          _ = iR (y i.castSucc) :=
            congrFun hty i.castSucc
      obtain ⟨z, _, hzR⟩ :=
        (hFree.overlap a (y i.castSucc)).mp heq
      exact ⟨z, hzR⟩
    obtain ⟨z, hz⟩ := hRightClosed p y hy hShared
    refine ⟨sL z, ?_⟩
    calc
      t (Fin.last p.rootSize) =
          iR (y (Fin.last p.rootSize)) :=
        congrFun hty (Fin.last p.rootSize)
      _ = iR (sR z) := congrArg iR hz
      _ = iL (sL z) :=
        ((hFree.overlap (sL z) (sR z)).mpr
          ⟨z, rfl, rfl⟩).symm

/-- Swap the two sides of an actual FULL relational free amalgam.
This is purely the symmetric reading of the same diagram. -/
private theorem freeAmalgam_swapped
    {K : RelLanguage.{u}}
    {H E F C : Type w}
    {Root : RelStructure K H}
    {Left : RelStructure K E}
    {Right : RelStructure K F}
    {Whole : RelStructure K C}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    (hFree : IsFreeAmalgam sL sR iL iR) :
    IsFreeAmalgam sR sL iR iL where
  covers := by
    intro z
    rcases hFree.covers z with ⟨a, ha⟩ | ⟨b, hb⟩
    · exact Or.inr ⟨a, ha⟩
    · exact Or.inl ⟨b, hb⟩
  overlap := by
    intro b a
    constructor
    · intro h
      obtain ⟨z, hzL, hzR⟩ :=
        (hFree.overlap a b).mp h.symm
      exact ⟨z, hzR, hzL⟩
    · rintro ⟨z, hzR, hzL⟩
      exact ((hFree.overlap a b).mpr
        ⟨z, hzL, hzR⟩).symm
  rel_iff := by
    intro R z
    constructor
    · intro h
      rcases (hFree.rel_iff R z).mp h with hl | hr
      · exact Or.inr hl
      · exact Or.inl hr
    · intro h
      apply (hFree.rel_iff R z).mpr
      rcases h with hr | hl
      · exact Or.inr hr
      · exact Or.inl hl

/-- A general FULL-side reflection principle. Suppose an original
whole output tuple comes from a side which already has visible
original/split agreement. If any positive split tuple over its
input prefix is known to have its last vertex in that SAME
side, the visible agreement transfers to the larger target.
The reverse direction requires no range-closure assumption. -/
private theorem visibleAgreement_fromFullSide
    {X W : Type w}
    {Side : RelStructure (L.splitMaskHybrid Parts) X}
    {Whole : RelStructure (L.splitMaskHybrid Parts) W}
    (e : Embedding Side Whole)
    (hSide : HybridVisibleWholeSplitAgreement Side)
    (hSplitRange :
      ∀ (q : FunctionInputPattern (L.outputPartIndexed Parts))
        (t : Fin (q.rootSize + 1) → W),
        Whole.rel (hybridSplitOutputSymbol q) t →
        (∀ i : Fin q.rootSize, ∃ x : X, t i.castSucc = e x) →
        ∃ x : X, t (Fin.last q.rootSize) = e x)
    (p : FunctionInputPattern L)
    (m : CompleteOutputParts Parts)
    (tSide : Fin (p.rootSize + m.size) → X)
    (j : Fin m.size)
    (u : Fin (p.rootSize + 1) → W)
    (hOld : Side.rel (hybridOriginalMaskOutputSymbol p m) tSide)
    (hRoot : ∀ i : Fin p.rootSize,
      u i.castSucc = e (tSide (Fin.castAdd m.size i))) :
    (Whole.rel (hybridSplitOutputSymbol
      (splitMaskInputAtPart p (m.label j))) u ↔
      u (Fin.last p.rootSize) =
        e (tSide (Fin.natAdd p.rootSize j))) := by
  classical
  have hOnSide
      (hLast : ∃ x : X,
        u (Fin.last p.rootSize) = e x) :
      (Whole.rel (hybridSplitOutputSymbol
          (splitMaskInputAtPart p (m.label j))) u ↔
        u (Fin.last p.rootSize) =
          e (tSide (Fin.natAdd p.rootSize j))) := by
    have hAll (k : Fin (p.rootSize + 1)) :
        ∃ x : X, u k = e x :=
      Fin.lastCases hLast
        (fun i => ⟨tSide (Fin.castAdd m.size i), hRoot i⟩) k
    let uSide : Fin (p.rootSize + 1) → X :=
      fun k => Classical.choose (hAll k)
    have hu : u = e ∘ uSide := by
      funext k
      exact Classical.choose_spec (hAll k)
    have huRoot : ∀ i : Fin p.rootSize,
        uSide i.castSucc =
          tSide (Fin.castAdd m.size i) := by
      intro i
      apply e.injective
      calc
        e (uSide i.castSucc) = u i.castSucc :=
          (congrFun hu i.castSucc).symm
        _ = e (tSide (Fin.castAdd m.size i)) := hRoot i
    have hSideIff :=
      hSide p m tSide j uSide hOld huRoot
    constructor
    · intro hPos
      have hSidePos :
          Side.rel (hybridSplitOutputSymbol
            (splitMaskInputAtPart p (m.label j))) uSide := by
        apply (e.map_rel_iff
          (hybridSplitOutputSymbol
            (splitMaskInputAtPart p (m.label j))) uSide).mp
        simpa only [hu] using hPos
      have hEq := hSideIff.mp hSidePos
      calc
        u (Fin.last p.rootSize) =
            e (uSide (Fin.last p.rootSize)) :=
          congrFun hu (Fin.last p.rootSize)
        _ = e (tSide (Fin.natAdd p.rootSize j)) :=
          congrArg e hEq
    · intro hEq
      have hEqSide :
          uSide (Fin.last p.rootSize) =
            tSide (Fin.natAdd p.rootSize j) := by
        apply e.injective
        calc
          e (uSide (Fin.last p.rootSize)) =
              u (Fin.last p.rootSize) :=
            (congrFun hu (Fin.last p.rootSize)).symm
          _ = e (tSide (Fin.natAdd p.rootSize j)) := hEq
      have hSidePos := hSideIff.mpr hEqSide
      have hWholePos :=
        (e.map_rel_iff
          (hybridSplitOutputSymbol
            (splitMaskInputAtPart p (m.label j))) uSide).mpr
          hSidePos
      simpa only [hu] using hWholePos
  constructor
  · intro hPos
    have hPrefix : ∀ i : Fin p.rootSize,
        ∃ x : X, u i.castSucc = e x :=
      fun i => ⟨tSide (Fin.castAdd m.size i), hRoot i⟩
    obtain ⟨x, hx⟩ :=
      hSplitRange (splitMaskInputAtPart p (m.label j))
        u hPos hPrefix
    exact (hOnSide ⟨x, hx⟩).mp hPos
  · intro hEq
    exact (hOnSide
      ⟨tSide (Fin.natAdd p.rootSize j), hEq⟩).mpr hEq

/-- The SAME-VERTEX original/split visible output-coherence law is
stable under TRUE FULL relational free amalgamation if the two
common-root embeddings are split-output closed.

The mixed case cannot create a cross-side conflict: once the
positive split tuple's input root is inside the other side,
closure in its own side forces its output into the overlap.
The resulting full tuple reflects into the side supporting
the complete original output, where SAME-VERTEX coherence is
already known.

This is precisely the missing conditional free-amalgamation
transfer. It does NOT infer split-output closure from the bare
relational free-amalgam axioms. -/
theorem HybridVisibleWholeSplitAgreement.freeAmalgam_of_splitClosedRoot
    {H E F C : Type w}
    {Root : RelStructure (L.splitMaskHybrid Parts) H}
    {Left : RelStructure (L.splitMaskHybrid Parts) E}
    {Right : RelStructure (L.splitMaskHybrid Parts) F}
    {Whole : RelStructure (L.splitMaskHybrid Parts) C}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    (hFree : IsFreeAmalgam sL sR iL iR)
    (hLeft : HybridVisibleWholeSplitAgreement Left)
    (hRight : HybridVisibleWholeSplitAgreement Right)
    (hClosedLeft : HybridSplitOutputClosedAt sL)
    (hClosedRight : HybridSplitOutputClosedAt sR) :
    HybridVisibleWholeSplitAgreement Whole := by
  intro p m t j u hOld hRoot
  rcases (hFree.rel_iff
      (hybridOriginalMaskOutputSymbol p m) t).mp hOld with
    ⟨a, ha, hat⟩ | ⟨b, hb, hbt⟩
  · have hRootLeft : ∀ i : Fin p.rootSize,
        u i.castSucc = iL (a (Fin.castAdd m.size i)) := by
      intro i
      calc
        u i.castSucc = t (Fin.castAdd m.size i) := hRoot i
        _ = iL (a (Fin.castAdd m.size i)) :=
          congrFun hat (Fin.castAdd m.size i)
    have hEqOutput :
        t (Fin.natAdd p.rootSize j) =
          iL (a (Fin.natAdd p.rootSize j)) :=
      congrFun hat (Fin.natAdd p.rootSize j)
    rw [hEqOutput]
    exact visibleAgreement_fromFullSide iL hLeft
      (fun q v hv hr =>
        splitOutputOverLeft_staysLeft hFree hClosedRight
          q v hv hr)
      p m a j u ha hRootLeft
  · have hRootRight : ∀ i : Fin p.rootSize,
        u i.castSucc = iR (b (Fin.castAdd m.size i)) := by
      intro i
      calc
        u i.castSucc = t (Fin.castAdd m.size i) := hRoot i
        _ = iR (b (Fin.castAdd m.size i)) :=
          congrFun hbt (Fin.castAdd m.size i)
    have hEqOutput :
        t (Fin.natAdd p.rootSize j) =
          iR (b (Fin.natAdd p.rootSize j)) :=
      congrFun hbt (Fin.natAdd p.rootSize j)
    rw [hEqOutput]
    exact visibleAgreement_fromFullSide iR hRight
      (fun q v hv hr =>
        splitOutputOverLeft_staysLeft
          (freeAmalgam_swapped hFree) hClosedLeft q v hv hr)
      p m b j u hb hRootRight

end StructuralRamsey.RelStructure
