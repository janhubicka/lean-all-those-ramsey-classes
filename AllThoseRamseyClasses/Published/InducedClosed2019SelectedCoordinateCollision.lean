import AllThoseRamseyClasses.Published.InducedClosed2019RankCollision
import PartiteConstruction.Ramsey.ClosurePictureCoordinate

/-!
# The native selected-line Hales--Jewett rank-(j+1) collision branch

For a SELECTED subfamily of the actual native Hales--Jewett lines, suppose
every selected line uses one chosen variable coordinate k. This need not
hold for the entire Ramsey family: the full family generally has no global
common parameter coordinate.

Coordinate evaluation on the core and the identity on each attached
old copy define a concrete retraction of the actual native attachment
to Old. The pinned closure library proves it is a corrected protected
map under closed support, closed whole and protected power hypotheses.

Here we strengthen the prior rank-PRESERVATION theorem. If the source is
generated by at most j+1 vertices, but evaluation at k identifies TWO
distinct generators, the projected generating support has cardinality
at most j. Its old rank-j closed-hull K-completion therefore pulls back
to the ORIGINAL weak source. This is a genuine j+1 completion branch.

The result assumes the ACTUAL selected lines have a common parameter
and the ACTUAL coordinate retraction collides on some generators.
Neither assumption is automatic in the full transverse multi-line
Picture history; no general rank-increment theorem is asserted.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.RelStructure
open StructuralRamsey.Partite
open StructuralRamsey.Partite.Induced
open StructuralRamsey.HalesJewett

universe u v
variable {L : RelLanguage.{u}}
variable {P Q V I X : Type v} {N : ℕ}

/-- Explicit coordinate retraction: evaluate a core vertex at k
and preserve every private old-copy vertex. This map is defined on
the REAL native attachment vertex type (core ⊕ tagged exteriors).
It need not be protected until every attached line is variable at k. -/
def nativeSelectedCoordinateProjection
    (Old : System L P V) (alpha : Q ↪ P)
    (I : Type v) (k : Fin N) :
    RelStructure.Attachment.Vertex (Old.support alpha)
      (W := Vertex (Old.restrict alpha) N) (I := I) → V :=
  RelStructure.Attachment.fold
    (fun z : Vertex (Old.restrict alpha) N => (z.coord k).1)
    (fun (_ : I) (x : V) => x)

/-- A true j+1 native-history completion when two actual generators
collapse under evaluation at a variable coordinate shared by
this SELECTED Hales--Jewett line subfamily. The old picture only
needs K-completions through closed U-size j, not j+1. -/
theorem inducedClosed2019_selected_coordinate_collision_completion
    {K : StructureClass.{u,v} (L := L)}
    {rules : ClosureDescription L}
    (Old : System L P V) (alpha : Q ↪ P) (A : RelStructure L Q)
    (hRestricted : (Old.restrict alpha).IsPartiteOver A)
    (lines : I → Line (Letter A (Old.restrict alpha)) N)
    [Finite V] [DecidableEq V]
    (hOld : IsUClosed rules Old.toRelStructure)
    (hSupport : IsUSubstructure rules Old.toRelStructure (Old.support alpha))
    (hPower : IsClosedUHomomorphismEmbedding rules
      (power (Old.restrict alpha) N).toRelStructure A
      (power (Old.restrict alpha) N).part)
    (hWhole : IsUClosed rules
      (RelStructure.Attachment.attach Old.toRelStructure (Old.support alpha)
        (power (Old.restrict alpha) N).toRelStructure
        (closureLineMaps Old alpha A hRestricted lines)))
    (j : ℕ)
    (hRank : ∀ (T : Set V) [Fintype T],
      IsUClosed rules (Old.toRelStructure.induce T) →
      USize rules (Old.toRelStructure.induce T) ≤ j →
        HasInducedClosedUKCompletion K rules (Old.toRelStructure.induce T))
    (Test : RelStructure L X) [Finite X]
    (e : RelStructure.Embedding Test
      (RelStructure.Attachment.attach Old.toRelStructure (Old.support alpha)
        (power (Old.restrict alpha) N).toRelStructure
        (closureLineMaps Old alpha A hRestricted lines)))
    (G : Finset X) (hGen : IsUGenerating rules Test (↑G : Set X))
    (hSize : G.card ≤ j + 1) (k : Fin N)
    (hParameter : ∀ i : I, (lines i).symbol k = .parameter)
    {x y : X} (hx : x ∈ G) (hy : y ∈ G) (hxy : x ≠ y)
    (hCollision :
      nativeSelectedCoordinateProjection Old alpha I k (e x) =
      nativeSelectedCoordinateProjection Old alpha I k (e y)) :
    HasInducedClosedUKCompletion K rules Test := by
  classical
  let R := Old.restrict alpha
  let Core := (power R N).toRelStructure
  let maps := closureLineMaps Old alpha A hRestricted lines
  let r : Vertex R N → V := fun z => (z.coord k).1
  have hr : IsClosedUHomomorphismEmbedding rules Core Old.toRelStructure r :=
    ((RelStructure.inclusion Old.toRelStructure (Old.support alpha)).isClosedUHomomorphismEmbedding rules).comp
      (coordinate_closedMap R k hRestricted.1 hPower)
  have hInverse : ∀ i : I, ∀ a : Old.support alpha,
      r (maps i a) = a.1 := by
    intro i a
    change ((NonInduced.lineMap (lines i) a).coord k).1 = a.1
    rw [coordinate_lineMap_parameter (lines i) k (hParameter i) a]
  let p :
      RelStructure.Attachment.Vertex (Old.support alpha)
        (W := Vertex R N) (I := I) → V :=
    nativeSelectedCoordinateProjection Old alpha I k
  have hCopy : ∀ i : I,
      IsClosedUHomomorphismEmbedding rules
        Old.toRelStructure Old.toRelStructure (fun x : V => x) :=
    fun _ => (RelStructure.Embedding.id Old.toRelStructure).isClosedUHomomorphismEmbedding rules
  have hp :
      IsClosedUHomomorphismEmbedding rules
        (RelStructure.Attachment.attach Old.toRelStructure
          (Old.support alpha) Core maps)
        Old.toRelStructure p := by
    exact RelStructure.Attachment.fold_isClosedUHomomorphismEmbedding
      Old.toRelStructure (Old.support alpha) Core maps
      hOld hSupport hWhole Old.toRelStructure
      r (fun (_ : I) (z : V) => z) hr hCopy hInverse
  have hf :
      IsInducedClosedUHomomorphismEmbedding rules
        Test Old.toRelStructure (p ∘ e) :=
    IsClosedUHomomorphismEmbedding.toInducedClosed
      (hp.precomp_embedding e)
  exact inducedClosed2019_completion_of_generator_collision
    hOld hf G hGen j hSize hRank hx hy hxy hCollision

end AllThoseRamseyClasses.Published
