import AllThoseRamseyClasses.Published.FunctionalWithParts2019RelativeKCompletion
import AllThoseRamseyClasses.Published.InducedClosed2019TestNormalization
import PartiteConstruction.Ramsey.ClosureUSize2019

/-!
# Track C: restriction of genuine H-valued ambient-relative local completions

The corrected 2019 local completion predicate uses an induced exact
OLD tagged source, a positive relation homomorphism, and FULL
protection of each embedded closed U-irreducible test. This kind of
completion restricts DOWNWARD along any full induced inclusion.

If T is a larger vertex carrier and S ⊆ T, a genuine H-relative
completion of C.induce T gives one of C.induce S, with the SAME
canonical H-target and the SAME map restricted to vertices of S.
Crucially, S itself need NOT be U-closed or have preserved all its
original genuinely partial function domain masks.

In particular, a completion of the U-closure HULL of an exact weak
test S gives a completion of S. The hull may have MORE THAN |S|
vertices, although it is generated by at most |S| seeds.

This proves one polarity of the local-test completion bridge. It
does NOT assert the converse: completability of a small weak S does
not automatically extend to its larger U-closed hull. Therefore
replacing the original all-weak-small-test premise by all-small-seed
hull-completability inside an outer local-class axiom is NOT
sufficient for a Ramsey conclusion without a separate sparse-witness
argument establishing hull completability.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.RelStructure
open StructuralRamsey.PartialSetStructure

universe u v w
variable {L : Language.{u}} {Parts : Type v} [Fintype Parts]
variable {V : Type w}

/-- Any genuine H-valued ambient OLD relative completion restricts
from an exact induced T to an exact induced S⊆T, preserving the
original same target and map. No closedness of S or T is needed. -/
theorem genuineTagged2019_relativeCompletion_induce_of_subset
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    (C : RelStructure ((L.withParts Parts).wholeMaskTagLanguage Parts) V)
    (S T : Set V) (hST : S ⊆ T)
    (hComplete :
      HasGenuinePartiteTagged2019RelativeCompletion H (C.induce T)) :
    HasGenuinePartiteTagged2019RelativeCompletion H (C.induce S) := by
  classical
  let rules := (L.withParts Parts).wholeMaskClosureRules Parts
  obtain ⟨X, hFinite, Target, targetPart, hH, hTrans,
      hIrred, f, hf⟩ := hComplete
  let e : RelStructure.Embedding (C.induce S) (C.induce T) := {
    toFun := fun x => ⟨x.1, hST x.2⟩
    injective := by
      intro x y hxy
      apply Subtype.ext
      exact congrArg Subtype.val hxy
    map_rel_iff := by
      intro R xs
      rfl
  }
  have he : IsClosedUHomomorphismEmbedding
      rules (C.induce S) (C.induce T) e.toFun :=
    e.isClosedUHomomorphismEmbedding rules
  have hfClosed : IsClosedUHomomorphismEmbedding
      rules (C.induce T)
      (wholeMaskTagExpansion
        (withPartsWholeMaskOld Target targetPart)) f :=
    IsInducedClosedUHomomorphismEmbedding.toAbstract_2019 hf
  have hRestricted : IsInducedClosedUHomomorphismEmbedding
      rules (C.induce S)
      (wholeMaskTagExpansion
        (withPartsWholeMaskOld Target targetPart))
      (f ∘ e.toFun) :=
    IsClosedUHomomorphismEmbedding.toInducedClosed
      (hfClosed.comp he)
  exact ⟨X, hFinite, Target, targetPart, hH, hTrans, hIrred,
    f ∘ e.toFun, hRestricted⟩

/-- Exact instance: an H-relative completion of the U-hull of
any set S supplies a completion of the ORIGINAL exact OLD weak
carrier S, with no global source canonization hypothesis. -/
theorem genuineTagged2019_relativeCompletion_induce_of_hull
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    (C : RelStructure ((L.withParts Parts).wholeMaskTagLanguage Parts) V)
    (S : Set V)
    (hHull :
      HasGenuinePartiteTagged2019RelativeCompletion H
        (C.induce
          (UClosureHull
            ((L.withParts Parts).wholeMaskClosureRules Parts) C S))) :
    HasGenuinePartiteTagged2019RelativeCompletion H (C.induce S) :=
  genuineTagged2019_relativeCompletion_induce_of_subset
    H C S
    (UClosureHull
      ((L.withParts Parts).wholeMaskClosureRules Parts) C S)
    (subset_UClosureHull
      ((L.withParts Parts).wholeMaskClosureRules Parts) C S)
    hHull

/-- A correctly polarised candidate-level implication:
the ORIGINAL ambient-relative local-completion axiom, which assumes
all small weak S completable, implies a similar statement assuming
ALL generated U-hulls of small S completable. It is a WEAKER local
axiom, not a replacement that the existing sparse witness is known
to satisfy.

We explicitly retain the 2019 control map, corrected (4b),
irreducibility of C0, and SAME cutoff n. -/
def GenuinePartiteTagged2019GeneratedHullLocalCompletionAt
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    (B : RelStructure ((L.withParts Parts).wholeMaskTagLanguage Parts) V)
    (C0 : RelStructure ((L.withParts Parts).wholeMaskTagLanguage Parts) V)
    (n : ℕ) : Prop :=
  ∀ {X : Type w} [Finite X]
    (C : RelStructure ((L.withParts Parts).wholeMaskTagLanguage Parts) X),
    IsUClosed ((L.withParts Parts).wholeMaskClosureRules Parts) C →
    (C0.Irreducible ∧ ∃ p : X → V,
      IsInducedClosedUHomomorphismEmbedding
        ((L.withParts Parts).wholeMaskClosureRules Parts) C C0 p) →
    CorrectedUIrreduciblesIn
      (canonicalGenuineTagged2019Class H)
      ((L.withParts Parts).wholeMaskClosureRules Parts) C →
    (∀ S : Finset X, S.card ≤ n →
      HasGenuinePartiteTagged2019RelativeCompletion H
        (C.induce
          (UClosureHull
            ((L.withParts Parts).wholeMaskClosureRules Parts)
            C (↑S : Set X)))) →
    HasCopywiseCompletion (canonicalGenuineTagged2019Class H) B C

/-- Same-n logical direction, avoiding reversal of the antecedent
implication: original all-weak local completion implies the weaker
hull-premise local completion property. -/
theorem genuineTagged2019_generatedHullLocal_of_ambientLocal
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    (B : RelStructure ((L.withParts Parts).wholeMaskTagLanguage Parts) V)
    (C0 : RelStructure ((L.withParts Parts).wholeMaskTagLanguage Parts) V)
    (n : ℕ)
    (hLocal : GenuinePartiteTagged2019LocalCompletionAt H B C0 n) :
    GenuinePartiteTagged2019GeneratedHullLocalCompletionAt H B C0 n := by
  intro X hFinite C hClosed hControl hCovered hSmallHull
  apply hLocal C hClosed hControl hCovered
  intro S hSize
  exact genuineTagged2019_relativeCompletion_induce_of_hull
    H C (↑S : Set X) (hSmallHull S hSize)

end AllThoseRamseyClasses.Published
