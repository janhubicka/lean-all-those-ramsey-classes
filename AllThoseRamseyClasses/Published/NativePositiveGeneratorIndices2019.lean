import AllThoseRamseyClasses.Published.NativeFiniteActiveHistory2019
import PartiteConstruction.Ramsey.ClosureAttachmentFold
import PartiteConstruction.Ramsey.ClosureProjectedGenerators

/-!
# Noninjective corrected 2019 native maps: ACTIVE lines come from GENERATORS

One troublesome gap in the stronger closed generating-rank and the
alternative exact weak-size proof is tracking every private-active
Hales--Jewett copy index of an ORIGINAL weak tested source through
its genuine finite generating support. The upstream subhistory lemma
was phrased for full source EMBEDDINGS into the native attachment,
but corrected protected Picture maps may be globally noninjective.

This file proves the needed stronger statement with ONLY an ordinary
POSITIVE source homomorphism into the TRUE native attachment.

If the attaching support S is relatively U-closed in Old, then the
complement of each private outside copy i in the native attachment
is a relative U-substructure. Its exact preimage under a POSITIVE
homomorphism of the tested source is therefore again relative
U-closed. If the source is U-generated by G and some test vertex
projects to the private exterior of i, at least ONE vertex of G
must already project to that same private exterior: otherwise G
would generate only within the complementary relative closed rest.

Consequences for a FINITE exact weak source:
* every source-private-active HJ index is witnessed by a vertex
  in the fixed ORIGINAL generating set G;
* each generator can witness at most ONE private-active index,
  because genuine native exterior indices are unique;
* hence the true finite active-index set has cardinal <= |G|,
  with no injectivity or reflection assumption on the source map.

This gives the ABSOLUTE rank bound on the NUMBER of active lines:
if G is minimum, |active indices| <= USize(Source).
It does NOT imply those lines have a common parameter coordinate,
and does not complete an arbitrary weak test nor construct a
common A-root for transverse histories. The repaired general
Theorem 2.18 remains OPEN.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.RelStructure
open StructuralRamsey.RelStructure.Attachment

universe u v
variable {L : RelLanguage.{u}}

/-- Under a positive (possibly NONINJECTIVE) source projection, each
genuinely private-active native index is ALREADY reached by a source
generator, provided the old attaching support is relatively U-closed.

No source/target intrinsic U-closedness or global injection is used. -/
theorem native2019_positive_exterior_index_from_generator
    {rules : ClosureDescription L}
    {U V W I : Type v}
    (Source : RelStructure L U)
    (Old : RelStructure L V)
    (Support : Set V)
    (Core : RelStructure L W)
    (maps : I → Embedding (Old.induce Support) Core)
    (hSupport : IsUSubstructure rules Old Support)
    (p : U → Vertex Support (W := W) (I := I))
    (hp : Source.IsHomomorphism
      (attach Old Support Core maps) p)
    (G : Set U) (hGen : IsUGenerating rules Source G)
    (i : I) (x : U)
    (hx : OutsideAt (W := W) (I := I) Support i (p x)) :
    ∃ g ∈ G,
      OutsideAt (W := W) (I := I) Support i (p g) := by
  classical
  by_contra hNo
  let Rest : Set U := {y | ¬ OutsideAt
    (W := W) (I := I) Support i (p y)}
  have hRest : IsUSubstructure rules Source Rest :=
    (rest_isUSubstructure Old Support Core maps hSupport i)
      .preimage_homomorphism hp
  have hG : G ⊆ Rest := by
    intro g hg hout
    exact hNo ⟨g, hg, hout⟩
  have hxHull : x ∈ UClosureHull rules Source G := by
    rw [hGen]
    trivial
  exact (UClosureHull_minimal rules Source hRest hG hxHull) hx

/-- Two true private exterior indices of the SAME native vertex
must be equal, independently of all closure rules. -/
theorem native2019_private_exterior_index_unique
    {V W I : Type v}
    (Support : Set V)
    {i j : I}
    {z : Vertex Support (W := W) (I := I)}
    (hi : OutsideAt (W := W) (I := I) Support i z)
    (hj : OutsideAt (W := W) (I := I) Support j z) :
    i = j := by
  obtain ⟨x, hx⟩ := hi
  obtain ⟨y, hy⟩ := hj
  have hpair : (i, x) = (j, y) :=
    Sum.inr.inj (hx.symm.trans hy)
  exact congrArg Prod.fst hpair

/-- Every exact finite source-private-active index has an ORIGINAL
generating vertex witness, even for noninjective positive projections. -/
theorem native2019_positive_finite_active_index_from_generator
    {rules : ClosureDescription L}
    {U V W I : Type v}
    [Fintype U]
    (Source : RelStructure L U)
    (Old : RelStructure L V)
    (Support : Set V)
    (Core : RelStructure L W)
    (maps : I → Embedding (Old.induce Support) Core)
    (hSupport : IsUSubstructure rules Old Support)
    (p : U → Vertex Support (W := W) (I := I))
    (hp : Source.IsHomomorphism
      (attach Old Support Core maps) p)
    (G : Finset U)
    (hGen : IsUGenerating rules Source (↑G : Set U))
    (i : I)
    (hi : i ∈ native2019_exact_active_index_finset Support p) :
    ∃ g ∈ G,
      OutsideAt (W := W) (I := I) Support i (p g) := by
  obtain ⟨x, hx⟩ :=
    (native2019_mem_exact_active_index_iff Support p i).mp hi
  exact native2019_positive_exterior_index_from_generator
    Source Old Support Core maps hSupport p hp
    (↑G : Set U) hGen i x hx

/-- FINITE quantitative geometry: the number of private-active native
copy indices visited by a weak source is bounded by the number of its
actual U-generators, even under a noninjective POSITIVE projection.

A generator has only one private outside index, hence choosing a
generator for each active index gives an INJECTION from active indices
into G. This is stronger than the older embedding-only history lemma. -/
theorem native2019_positive_active_index_card_le_generators
    {rules : ClosureDescription L}
    {U V W I : Type v}
    [Fintype U]
    (Source : RelStructure L U)
    (Old : RelStructure L V)
    (Support : Set V)
    (Core : RelStructure L W)
    (maps : I → Embedding (Old.induce Support) Core)
    (hSupport : IsUSubstructure rules Old Support)
    (p : U → Vertex Support (W := W) (I := I))
    (hp : Source.IsHomomorphism
      (attach Old Support Core maps) p)
    (G : Finset U)
    (hGen : IsUGenerating rules Source (↑G : Set U)) :
    (native2019_exact_active_index_finset Support p).card ≤ G.card := by
  classical
  let T : Finset I := native2019_exact_active_index_finset Support p
  have hWitness (i : T) : ∃ g : U, g ∈ G ∧
      OutsideAt (W := W) (I := I) Support i.1 (p g) :=
    native2019_positive_finite_active_index_from_generator
      Source Old Support Core maps hSupport p hp G hGen i.1 i.2
  let pick : T → G := fun i =>
    ⟨Classical.choose (hWitness i),
      (Classical.choose_spec (hWitness i)).1⟩
  have hPick (i : T) : OutsideAt
      (W := W) (I := I) Support i.1 (p (pick i).1) :=
    (Classical.choose_spec (hWitness i)).2
  have hInjective : Function.Injective pick := by
    intro i j hij
    have hpEq : (pick i).1 = (pick j).1 :=
      congrArg Subtype.val hij
    have hOther : OutsideAt (W := W) (I := I)
        Support j.1 (p (pick i).1) := by
      rw [hpEq]
      exact hPick j
    have hijIndex : i.1 = j.1 :=
      native2019_private_exterior_index_unique
        Support (hPick i) hOther
    exact Subtype.ext hijIndex
  have hCard : Fintype.card T ≤ Fintype.card G :=
    Fintype.card_le_of_injective pick hInjective
  simpa [T] using hCard

end AllThoseRamseyClasses.Published
