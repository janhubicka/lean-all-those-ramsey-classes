import AllThoseRamseyClasses.Published.FunctionalWithParts2019AmbientHullRootGlue
import PartiteConstruction.Ramsey.ClosureGeneratedHullRank

/-!
# Track C: weak rank increment across ordinary-irreducible roots

A closed-rank-j completion hypothesis supplies genuine H-valued
ambient-relative completions of the U-closure hulls generated by
ANY two full weak source side images having at most j vertices.
The hulls may be much larger as vertex sets; the rank bound is
on their generators, not on their cardinalities.

When the original weak free root is ORDINARY irreducible, its
ambient U-hull is a canonical closed K(H) boundary by corrected
(4b). The previously checked projected-source gluing theorem
then combines the two closed side-hull completions and returns
a genuine H-relative completion of the ORIGINAL exact Whole.

No U-closedness of the weak side structures, original weak Root,
or weak Whole is assumed. The only essential extra source hypotheses
are: an actual full free diagram embedded into the corrected-(4b)
candidate, relatively U-closed side ranges, ordinary irreducibility
of Root, and the two proper side cardinality bounds.

This is NOT the unconditional rank-j -> j+1 theorem. Proper weak
cuts with U-reducible/non-irreducible roots are not covered. A proof
of the global original printed local-finiteness axiom is not claimed.
-/

namespace AllThoseRamseyClasses.Published

open StructuralRamsey
open StructuralRamsey.RelStructure
open StructuralRamsey.PartialSetStructure

universe u v w
variable {L : Language.{u}} {Parts : Type v} [Fintype Parts]
variable {RootV LeftV RightV WholeV CandV : Type w}

/-- A genuine closed-U-rank-j relative H-completion invariant
completes a free weak source with an ordinary irreducible common
root, provided its two sides have at most j original vertices.

Both auxiliary side hulls are completed using the original
closed-RANK invariant. The conclusion remains the exact weak Whole
and retains all ambient OLD domain-mask incidences. -/
theorem genuinePartite2019_rankStep_of_irreducibleRoot
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    (hStrong : GenuinePartiteStrongAmalgamation2019 H)
    (hKIrr : ∀ {X : Type w}
      (D : RelStructure
        ((L.withParts Parts).wholeMaskTagLanguage Parts) X),
      canonicalGenuineTagged2019Class H D → D.Irreducible)
    (C : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) CandV)
    [Finite CandV]
    (hCClosed : IsUClosed
      ((L.withParts Parts).wholeMaskClosureRules Parts) C)
    (hCovered : CorrectedUIrreduciblesIn
      (canonicalGenuineTagged2019Class H)
      ((L.withParts Parts).wholeMaskClosureRules Parts) C)
    (j : ℕ)
    (hRank : ∀ (T : Set CandV) [Fintype T],
      IsUClosed
        ((L.withParts Parts).wholeMaskClosureRules Parts)
        (C.induce T) →
      USize
        ((L.withParts Parts).wholeMaskClosureRules Parts)
        (C.induce T) ≤ j →
      HasGenuinePartiteTagged2019RelativeCompletion H (C.induce T))
    {Root : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) RootV}
    {Left : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) LeftV}
    {Right : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) RightV}
    {Whole : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) WholeV}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    (hFree : IsFreeAmalgam sL sR iL iR)
    (eWhole : Embedding Whole C)
    (hL : IsUSubstructure
      ((L.withParts Parts).wholeMaskClosureRules Parts)
      Whole (Set.range iL))
    (hR : IsUSubstructure
      ((L.withParts Parts).wholeMaskClosureRules Parts)
      Whole (Set.range iR))
    [Finite LeftV] [Finite RightV]
    (hLeftSmall : Nat.card LeftV ≤ j)
    (hRightSmall : Nat.card RightV ≤ j)
    (hRootIrred : Root.Irreducible) :
    HasGenuinePartiteTagged2019RelativeCompletion H Whole := by
  classical
  letI : Fintype CandV := Fintype.ofFinite CandV
  letI : Fintype LeftV := Fintype.ofFinite LeftV
  letI : Fintype RightV := Fintype.ofFinite RightV
  let rules := (L.withParts Parts).wholeMaskClosureRules Parts
  let eLeft : Embedding Left C := eWhole.comp iL
  let eRight : Embedding Right C := eWhole.comp iR
  let SLeft : Finset CandV := Finset.univ.image eLeft.toFun
  let SRight : Finset CandV := Finset.univ.image eRight.toFun
  have hSLeft : (↑SLeft : Set CandV) = Set.range eLeft.toFun := by
    ext x
    simp [SLeft]
  have hSRight : (↑SRight : Set CandV) = Set.range eRight.toFun := by
    ext x
    simp [SRight]
  have hLeftCard : SLeft.card ≤ j := by
    calc
      SLeft.card ≤ (Finset.univ : Finset LeftV).card :=
        Finset.card_image_le
      _ = Fintype.card LeftV := Finset.card_univ
      _ = Nat.card LeftV := by rw [Nat.card_eq_fintype_card]
      _ ≤ j := hLeftSmall
  have hRightCard : SRight.card ≤ j := by
    calc
      SRight.card ≤ (Finset.univ : Finset RightV).card :=
        Finset.card_image_le
      _ = Fintype.card RightV := Finset.card_univ
      _ = Nat.card RightV := by rw [Nat.card_eq_fintype_card]
      _ ≤ j := hRightSmall
  have hLeftRank :
      USize rules
        (C.induce
          (UClosureHull rules C (Set.range eLeft.toFun))) ≤ j := by
    rw [← hSLeft]
    exact (USize_induce_UClosureHull_le rules C SLeft).trans hLeftCard
  have hRightRank :
      USize rules
        (C.induce
          (UClosureHull rules C (Set.range eRight.toFun))) ≤ j := by
    rw [← hSRight]
    exact (USize_induce_UClosureHull_le rules C SRight).trans hRightCard
  have hLeftHullClosed :
      IsUClosed rules
        (C.induce (UClosureHull rules C (Set.range eLeft.toFun))) :=
    hCClosed.induce_UClosureHull (Set.range eLeft.toFun)
  have hRightHullClosed :
      IsUClosed rules
        (C.induce (UClosureHull rules C (Set.range eRight.toFun))) :=
    hCClosed.induce_UClosureHull (Set.range eRight.toFun)
  have hLeftHullComplete :
      HasGenuinePartiteTagged2019RelativeCompletion H
        (C.induce (UClosureHull rules C (Set.range eLeft.toFun))) :=
    hRank _ hLeftHullClosed hLeftRank
  have hRightHullComplete :
      HasGenuinePartiteTagged2019RelativeCompletion H
        (C.induce (UClosureHull rules C (Set.range eRight.toFun))) :=
    hRank _ hRightHullClosed hRightRank
  exact genuinePartite2019_relativeCompletion_glue_irreducibleRoot_hull
    H hStrong hKIrr C hCClosed hCovered
    hFree eWhole hL hR hRootIrred
    hLeftHullComplete hRightHullComplete

/-- Under the original corrected 2019 ambient assumptions,
the canonical-target ordinary irreducibility premise above is
automatically supplied by K(H) subset R and R irreducible. -/
theorem genuinePartite2019_rankStep_of_irreducibleRoot_of_ambient
    (H : GenuinePartite2019Class (L := L) (Parts := Parts))
    (R : StructureClass
      (L := (L.withParts Parts).wholeMaskTagLanguage Parts))
    (hRIrred : ∀ {X : Type w}
      (D : RelStructure
        ((L.withParts Parts).wholeMaskTagLanguage Parts) X),
      R D → D.Irreducible)
    (hSub : ∀ {X : Type w}
      (D : RelStructure
        ((L.withParts Parts).wholeMaskTagLanguage Parts) X),
      canonicalGenuineTagged2019Class H D → R D)
    (hStrong : GenuinePartiteStrongAmalgamation2019 H)
    (C : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) CandV)
    [Finite CandV]
    (hCClosed : IsUClosed
      ((L.withParts Parts).wholeMaskClosureRules Parts) C)
    (hCovered : CorrectedUIrreduciblesIn
      (canonicalGenuineTagged2019Class H)
      ((L.withParts Parts).wholeMaskClosureRules Parts) C)
    (j : ℕ)
    (hRank : ∀ (T : Set CandV) [Fintype T],
      IsUClosed
        ((L.withParts Parts).wholeMaskClosureRules Parts)
        (C.induce T) →
      USize
        ((L.withParts Parts).wholeMaskClosureRules Parts)
        (C.induce T) ≤ j →
      HasGenuinePartiteTagged2019RelativeCompletion H (C.induce T))
    {Root : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) RootV}
    {Left : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) LeftV}
    {Right : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) RightV}
    {Whole : RelStructure
      ((L.withParts Parts).wholeMaskTagLanguage Parts) WholeV}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    (hFree : IsFreeAmalgam sL sR iL iR)
    (eWhole : Embedding Whole C)
    (hL : IsUSubstructure
      ((L.withParts Parts).wholeMaskClosureRules Parts)
      Whole (Set.range iL))
    (hR : IsUSubstructure
      ((L.withParts Parts).wholeMaskClosureRules Parts)
      Whole (Set.range iR))
    [Finite LeftV] [Finite RightV]
    (hLeftSmall : Nat.card LeftV ≤ j)
    (hRightSmall : Nat.card RightV ≤ j)
    (hRootIrred : Root.Irreducible) :
    HasGenuinePartiteTagged2019RelativeCompletion H Whole :=
  genuinePartite2019_rankStep_of_irreducibleRoot
    H hStrong (fun D hK => hRIrred D (hSub D hK))
    C hCClosed hCovered j hRank
    hFree eWhole hL hR hLeftSmall hRightSmall hRootIrred

end AllThoseRamseyClasses.Published
